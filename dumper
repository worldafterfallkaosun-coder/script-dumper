    blocked = setmetatable({}, { __mode = "k" }), rstat = {}, rstatN = 0,
}

L.fm = {}
local SEND = { FireServer = true, InvokeServer = true, fireServer = true, invokeServer = true }
local LIVE_CLASS = {
    Model = true, Tool = true, Folder = true, Configuration = true, ScreenGui = true, ModuleScript = true,
    LocalScript = true, Script = true, Humanoid = true, ProximityPrompt = true, ClickDetector = true,
}
for c, k in next, KIND do if k == "remote" or k == "value" then LIVE_CLASS[c] = true end end

-- hook namecall v4: dipasang sekali per sesi executor, lalu membaca ENV.DumperPP_Hook4 / DumperPP_Ret4
-- (nama beda dari v3, jadi re-run dari versi lama tidak membuat event dobel)
local function ensureHook()
    if ENV.DumperPP_HookInstalled4 then return true end
    if not (CAP.hookmetamethod and CAP.getnamecallmethod) then return false end
    local wrap = CAP.newcclosure or function(f) return f end
    local getm, setm = CAP.getnamecallmethod, CAP.setnamecallmethod
    local old
    local ok = pcall(function()
        old = CAP.hookmetamethod(game, "__namecall", wrap(function(self, ...)
            local d = ENV.DumperPP_Hook4
            if d then
                local m = getm()
                if SEND[m] then
                    local block, capture = d(self, m, ...)
                    if setm then setm(m) end
                    if block then return end
                    if capture then
                        local r = table.pack(old(self, ...))
                        local ret = ENV.DumperPP_Ret4
                        if ret then ret(self, m, r) end
                        return table.unpack(r, 1, r.n)
                    end
                end
            end
            return old(self, ...)
        end))
    end)
    if ok and old then
        ENV.DumperPP_HookInstalled4 = true
        return true
    end
    return false
end

local function qpush(item)
    if L.qt - L.qh >= CFG.LiveQueueMax then
        L.dropped += 1
        return
    end
    L.qt += 1
    L.q[L.qt] = item
end

-- dipanggil dari dalam hook: kerja minimal, serialisasi dilakukan di loop.
-- return: block?, capture return?
function L.hook(self, m, ...)
    if typeof(self) ~= "Instance" then return false end
    if not CFG.LiveIncludeExecutor and CAP.checkcaller and CAP.checkcaller() then return false end
    local blocked = L.blocked[self] == true
    local caller
    if CFG.LiveCallers and CAP.getcallingscript then
        local ok, c = pcall(CAP.getcallingscript)
        if ok and typeof(c) == "Instance" then caller = c end
    end
    qpush({ "OUT", m, self, table.pack(...), os.clock(), caller = caller, blocked = blocked })
    local isInvoke = (m == "InvokeServer" or m == "invokeServer")
    return blocked, (not blocked) and isInvoke and CFG.Live.returns == true
end

function L.ret(self, m, r)
    qpush({ "RET", m, self, r, os.clock() })
end

function L.hookIn(r)
    if L.hooked[r] then return end
    local cls = r.ClassName
    if cls ~= "RemoteEvent" and cls ~= "UnreliableRemoteEvent" then return end
    L.hooked[r] = true
    local okc, c = pcall(function()
        return r.OnClientEvent:Connect(function(...)
            qpush({ "IN ", "OnClientEvent", r, table.pack(...), os.clock() })
        end)
    end)
    if okc and c then L.conns[#L.conns + 1] = c end
end

function L.watchValue(v)
    if L.watched[v] or L.watchN >= CFG.LiveMaxWatch or not SC.inst(v) then return end
    local ok, cur = pcall(function() return v.Value end)
    if not ok then return end
    L.watched[v], L.last[v] = true, cur
    L.watchN += 1
    local c = v.Changed:Connect(function(new)
        local old = L.last[v]
        L.last[v] = new
        qpush({ "VAL", "Value", v, { old, new, n = 2 }, os.clock() })
    end)
    L.conns[#L.conns + 1] = c
end

function L.watchAttr(inst)
    if L.watched[inst] or L.watchN >= CFG.LiveMaxWatch or not SC.inst(inst) then return end
    local ok, snap = pcall(inst.GetAttributes, inst)
    if not ok or type(snap) ~= "table" then return end
    L.watched[inst], L.last[inst] = true, snap
    L.watchN += 1
    local c = inst.AttributeChanged:Connect(function(name)
        local new = inst:GetAttribute(name)
        local s = L.last[inst]
        local old = s[name]
        s[name] = new
        qpush({ "ATR", name, inst, { old, new, n = 2 }, os.clock() })
    end)
    L.conns[#L.conns + 1] = c
end

function L.onAdded(d)
    local cls = d.ClassName
    if not LIVE_CLASS[cls] then return end
    local o = CFG.Live
    local kind = KIND[cls]
    if o.remotes and kind == "remote" then L.hookIn(d) end
    if o.values and kind == "value" then L.watchValue(d) end
    if o.instances then qpush({ "ADD", cls, d, { cls, n = 1 }, os.clock() }) end
end
function L.onRemoving(d)
    local cls = d.ClassName
    if LIVE_CLASS[cls] then qpush({ "DEL", cls, d, { cls, n = 1 }, os.clock() }) end
end

local function oneLine(s, n)
    s = s:gsub("%s*\n%s*", " ")
    return #s > n and (s:sub(1, n) .. "...") or s
end

function L.emit(kind, line, detail, j, t, ex)
    local wall = L.epoch + t
    local stamp = ("%s.%03d"):format(os.date("%H:%M:%S", math.floor(wall)), math.floor((wall % 1) * 1000))
    local text = ("%s [%s] %s"):format(stamp, kind, line)
    if L.wLog then
        L.wLog.add(text)
        if detail and detail ~= "" then L.wLog.add("    " .. detail:gsub("\n", "\n    ")) end
    end
    if L.wJson and HttpService and j then
        j.t, j.kind = math.floor(wall * 1000) / 1000, kind
        local ok, enc = pcall(HttpService.JSONEncode, HttpService, j)
        if ok then L.wJson.add(enc) end
    end
    L.stats[kind] = (L.stats[kind] or 0) + 1
    if #L.feed < 600 then
        local e = { kind = kind, line = text, detail = detail or text }
        if ex then e.raw, e.inst, e.method = ex.raw, ex.inst, ex.method end
        L.feed[#L.feed + 1] = e
    end
end

local function memoPath(inst)
    local p = L.pathMemo[inst]
    if not p then
        p = U.path(inst)
        L.pathMemo[inst] = p
    end
    return p
end

-- filter path (include / -exclude), hasil dimemo per path
local function passFilter(p)
    local F = CFG.LiveFilter
    if type(F) ~= "table" then return true end
    local inc, exc = F.include, F.exclude
    if (not inc or #inc == 0) and (not exc or #exc == 0) then return true end
    local r = L.fm[p]
    if r ~= nil then return r end
    local lp = p:lower()
    r = true
    if exc then
        for _, x in ipairs(exc) do
            if lp:find(x, 1, true) then
                r = false
                break
            end
        end
    end
    if r and inc and #inc > 0 then
        r = false
        for _, x in ipairs(inc) do
            if lp:find(x, 1, true) then
                r = true
                break
            end
        end
    end
    L.fm[p] = r
    return r
end

-- profil argumen per remote: tipe, rentang angka, nilai string (enum-like bila variasinya sedikit)
local function profArg(pf, i, v)
    local e = pf[i]
    if not e then
        e = { types = {}, strs = {}, ns = 0 }
        pf[i] = e
    end
    local t = typeof(v)
    if t == "Instance" then
        local okc, c = pcall(function() return v.ClassName end)
        t = okc and ("Instance:" .. c) or "Instance"
    end
    e.types[t] = (e.types[t] or 0) + 1
    if t == "number" then
        if v == v then
            if e.min == nil or v < e.min then e.min = v end
            if e.max == nil or v > e.max then e.max = v end
        end
    elseif t == "string" then
        if e.strs[v] then
            e.strs[v] += 1
        elseif e.ns < 10 and #v <= 60 then
            e.strs[v] = 1
            e.ns += 1
        else
            e.many = true
        end
    end
end

function L.process(it)
    local kind, name, inst, args, t = it[1], it[2], it[3], it[4], it[5]
    if not SC.inst(inst) then return end
    local p = memoPath(inst)
    if not passFilter(p) then return end

    -- caller + statistik per remote (dihitung sebelum mute supaya angka tetap akurat)
    local cp, rs
    if it.caller then cp = memoPath(it.caller) end
    if CFG.LiveRemoteStats and (kind == "OUT" or kind == "IN ") then
        rs = L.rstat[p]
        if not rs and L.rstatN < CFG.LiveStatsMaxRemotes then
            rs = { out = 0, inn = 0, blocked = 0, sigs = {}, nsig = 0, callers = {}, ncall = 0 }
            L.rstat[p] = rs
            L.rstatN += 1
        end
        if rs then
            if kind == "OUT" then rs.out += 1 else rs.inn += 1 end
            if it.blocked then rs.blocked += 1 end
            local sec = math.floor(t)
            if rs.sec ~= sec then rs.sec, rs.cur = sec, 0 end
            rs.cur += 1
            if rs.cur > (rs.peak or 0) then rs.peak = rs.cur end
            if CFG.LiveProfile and (kind == "OUT" or kind == "IN ") then
                local nn = rs.out + rs.inn
                if nn <= 500 or nn % 20 == 0 then
                    rs.pf = rs.pf or {}
                    for i = 1, math.min(args.n, 8) do profArg(rs.pf, i, args[i]) end
                end
            end
            local n = rs.out + rs.inn
            if n <= 200 or n % 50 == 0 then
                local sg = (kind == "OUT" and "OUT" or "IN") .. U.shape(args)
                if rs.sigs[sg] then
                    rs.sigs[sg] += 1
                elseif rs.nsig < 12 then
                    rs.sigs[sg] = 1
                    rs.nsig += 1
                end
            end
            if cp then
                if rs.callers[cp] then
                    rs.callers[cp] += 1
                elseif rs.ncall < 8 then
                    rs.callers[cp] = 1
                    rs.ncall += 1
                end
            end
        end
    end

    local key = kind .. p .. (kind == "ATR" and name or "")
    if L.muted[key] then return end
    local c = (L.win[key] or 0) + 1
    L.win[key] = c
    if c > CFG.LiveSpamPerSec then
        L.muted[key] = true
        L.emit("NOTE", ("auto-mute (>%d/detik): %s"):format(CFG.LiveSpamPerSec, p), nil, nil, t)
        return
    end

    local parts = {}
    local depth = (kind == "OUT" or kind == "IN " or kind == "RET") and CFG.LiveArgDepth or 2
    for i = 1, args.n do parts[i] = U.ser(args[i], depth, {}, "") end

    if kind == "OUT" or kind == "IN " then
        if rs and not rs.sample then rs.sample = oneLine(table.concat(parts, ", "), 160) end
        local tag = it.blocked and "BLOCKED " or ""
        local ctext = cp and ("  <- " .. cp) or ""
        local detail = p .. "\n" .. table.concat(parts, "\n")
        if cp then detail = detail .. "\ncaller: " .. cp end
        L.emit(kind, ("%s%-12s %s  %s%s"):format(tag, name, p, oneLine(table.concat(parts, ", "), 140), ctext),
            detail, { dir = kind, method = name, path = p, args = parts, caller = cp, blocked = it.blocked or false }, t,
            { raw = args, inst = inst, method = name })
    elseif kind == "RET" then
        L.emit("RET", ("%-12s %s -> %s"):format(name, p, oneLine(table.concat(parts, ", "), 140)),
            p .. "\n" .. table.concat(parts, "\n"), { method = name, path = p, ret = parts }, t)
    elseif kind == "VAL" then
        L.emit(kind, ("%s: %s -> %s"):format(p, oneLine(parts[1], 60), oneLine(parts[2], 60)), nil,
            { path = p, old = parts[1], new = parts[2] }, t)
    elseif kind == "ATR" then
        L.emit(kind, ("%s @%s: %s -> %s"):format(p, name, oneLine(parts[1], 60), oneLine(parts[2], 60)), nil,
            { path = p, attr = name, old = parts[1], new = parts[2] }, t)
    else
        L.emit(kind, ("%s (%s)"):format(p, name), nil, { path = p, class = name }, t)
    end
end

-- tulis statistik remote (sekali, saat live berhenti)
function L.writeStats()
    if not CAN_WRITE or next(L.rstat) == nil then return end
    local w = W.new("remote_stats_" .. os.date("%H%M%S"), "txt", "live")
    local rows = {}
    for p, s in next, L.rstat do rows[#rows + 1] = { p, s } end
    table.sort(rows, function(a, b)
        local ta, tb = a[2].out + a[2].inn, b[2].out + b[2].inn
        if ta ~= tb then return ta > tb end
        return a[1] < b[1]
    end)
    w.add("# statistik remote selama sesi live (signature = sampel, bukan semua panggilan)")
    for _, r in ipairs(rows) do
        local s = r[2]
        w.add(("%s  OUT=%d IN=%d peak=%d/s%s"):format(r[1], s.out, s.inn, s.peak or 0, s.blocked > 0 and (" BLOCKED=" .. s.blocked) or ""))
        local sigs = {}
        for sg, n in next, s.sigs do sigs[#sigs + 1] = ("%s x%d"):format(sg, n) end
        table.sort(sigs)
        for _, sg in ipairs(sigs) do w.add("    sig: " .. sg) end
        for cp, n in next, s.callers do w.add(("    caller: %s x%d"):format(cp, n)) end
        for _, ln in ipairs(L.profLines(s)) do w.add("    " .. ln) end
        if s.sample then w.add("    contoh: " .. s.sample) end
    end
    w.close()
    LOG.add("info", ("remote_stats ditulis (%d remote)"):format(#rows))
end

function L.profLines(s)
    local out = {}
    if not s.pf then return out end
    for i = 1, 8 do
        local e = s.pf[i]
        if not e then break end
        local ts = {}
        for t, n in next, e.types do ts[#ts + 1] = ("%s x%d"):format(t, n) end
        table.sort(ts)
        local extra = ""
        if e.min ~= nil then extra = extra .. ("  rentang=[%s .. %s]"):format(tostring(e.min), tostring(e.max)) end
        if next(e.strs) ~= nil then
            local vs = {}
            for v, n in next, e.strs do vs[#vs + 1] = U.clean(("%q x%d"):format(v, n)) end
            table.sort(vs)
            extra = extra .. ((e.many and "  nilai (>10 variasi, sampel): " or "  nilai (enum-like): ") .. table.concat(vs, ", "))
        end
        out[#out + 1] = ("arg%d: %s%s"):format(i, table.concat(ts, " | "), extra)
    end
    return out
end

-- katalog remote dalam Markdown (ditulis sekali, saat live berhenti)
function L.writeCatalog()
    if not CAN_WRITE or next(L.rstat) == nil then return end
    local w = W.new("remote_catalog_" .. os.date("%H%M%S"), "md", "live")
    local rows = {}
    for p, s in next, L.rstat do rows[#rows + 1] = { p, s } end
    table.sort(rows, function(a, b)
        local ta, tb = a[2].out + a[2].inn, b[2].out + b[2].inn
        if ta ~= tb then return ta > tb end
        return a[1] < b[1]
    end)
    w.add("# Katalog remote (dari sesi live)")
    w.add("Catatan: berdasarkan sampel panggilan yang teramati; tipe / rentang / enum bisa belum lengkap.")
    w.add("")
    for _, r in ipairs(rows) do
        local s = r[2]
        w.add(("## `%s`"):format(r[1]))
        w.add(("- panggilan: OUT %d / IN %d | puncak %d/s%s"):format(s.out, s.inn, s.peak or 0, s.blocked > 0 and (" | diblok " .. s.blocked) or ""))
        for cp, n in next, s.callers do w.add(("- caller: `%s` x%d"):format(cp, n)) end
        for _, ln in ipairs(L.profLines(s)) do w.add("- " .. ln) end
        if s.sample then w.add("- contoh: `" .. (s.sample:gsub("`", "'")) .. "`") end
        w.add("")
    end
    w.close()
    LOG.add("info", ("remote_catalog ditulis (%d remote)"):format(#rows))
end

function L.loop()
    local lastFlush = os.clock()
    while L.on and not APP.dead do
        task.wait(0.12)
        if os.clock() - L.winT >= 1 then L.win, L.winT = {}, os.clock() end
        local t0 = os.clock()
        while L.qh < L.qt and os.clock() - t0 < 0.01 do
            L.qh += 1
            local it = L.q[L.qh]
            L.q[L.qh] = nil
            pcall(L.process, it)
        end
        if L.qh >= L.qt then L.qh, L.qt = 0, 0 end
        if os.clock() - lastFlush >= CFG.LiveFlushSec then
            lastFlush = os.clock()
            if L.wLog then L.wLog.close() end
            if L.wJson then L.wJson.close() end
        end
    end
    -- habiskan sisa antrean sebelum menutup
    local t1 = os.clock()
    while L.qh < L.qt and os.clock() - t1 < 1 do
        L.qh += 1
        local it = L.q[L.qh]
        L.q[L.qh] = nil
        pcall(L.process, it)
    end
    if L.wLog then L.wLog.close() end
    if L.wJson then L.wJson.close() end
    pcall(L.writeStats)
    pcall(L.writeCatalog)
end

function L.start()
    if L.on then return end
    if not SCAN.done then LOG.add("warn", "scan belum selesai") return end
    L.on, L.epoch = true, os.time() - os.clock()
    L.q, L.qh, L.qt, L.dropped, L.stats, L.feed = {}, 0, 0, 0, {}, {}
    L.muted, L.win, L.winT, L.watchN = {}, {}, os.clock(), 0
    L.rstat, L.rstatN = {}, 0
    L.fm = {}
    L.wLog, L.wJson = nil, nil
    if CAN_WRITE then
        local tag = os.date("%H%M%S") -- tiap sesi live punya file sendiri (v3 menimpa sesi sebelumnya)
        L.wLog = W.new("events_" .. tag, "log", "live")
        L.wJson = (CFG.LiveJSONL and HttpService) and W.new("events_" .. tag, "jsonl", "live") or nil
    else
        LOG.add("warn", "tanpa writefile: live tidak disimpan ke file (hanya tampil di UI)")
    end
    local o = CFG.Live
    if o.remotes then
        ENV.DumperPP_Hook4, ENV.DumperPP_Ret4 = L.hook, L.ret
        if not ensureHook() then LOG.add("warn", "hookmetamethod tidak tersedia: live hanya menangkap remote IN") end
        for _, r in ipairs(INDEX.remotes) do L.hookIn(r) end
    end
    if o.values then
        for _, v in ipairs(INDEX.values) do L.watchValue(v) end
        for _, a in ipairs(INDEX.attrs) do L.watchAttr(a) end
    end
    L.conns[#L.conns + 1] = game.DescendantAdded:Connect(L.onAdded)
    if o.instances then L.conns[#L.conns + 1] = game.DescendantRemoving:Connect(L.onRemoving) end
    task.spawn(L.loop)
    LOG.add("info", ("live aktif | scope: %s | diawasi: %d | log: %s/live"):format(
        SC.active() and "sistem terpilih" or "seluruh game", L.watchN, W.root or "-"))
end

function L.stop()
    if not L.on then return end
    L.on = false
    ENV.DumperPP_Hook4, ENV.DumperPP_Ret4 = nil, nil
    for _, c in ipairs(L.conns) do pcall(function() c:Disconnect() end) end
    L.conns, L.hooked, L.watched = {}, setmetatable({}, { __mode = "k" }), setmetatable({}, { __mode = "k" })
    task.delay(0.3, function() W.flushAll() end)
    LOG.add("info", "live dihentikan, log + remote_stats tersimpan")
end
onCleanup(function() L.on = false end)
onCleanup(function() for _, c in ipairs(L.conns) do pcall(function() c:Disconnect() end) end end)

-- ---------- aksi pada event yang dipilih di feed ----------
function L.toCode(e)
    if not (e and e.raw and e.inst) then return e and e.detail or "" end
    local args = {}
    for i = 1, e.raw.n do args[i] = U.lua(e.raw[i], 5) end
    local ref = U.luaInst(e.inst)
    if e.kind == "OUT" then
        return ("%s:%s(%s)"):format(ref, e.method, table.concat(args, ", "))
    end
    -- event IN: simulasi sisi client (butuh firesignal)
    return ("firesignal(%s.OnClientEvent%s)"):format(ref, #args > 0 and (", " .. table.concat(args, ", ")) or "")
end

function L.replay(e)
    if not (e and e.raw and e.inst) then return false, "event ini tidak bisa di-replay" end
    local inst, raw, m = e.inst, e.raw, e.method
    if e.kind == "OUT" then
        task.spawn(function()
            local ok, err = pcall(function() return inst[m](inst, table.unpack(raw, 1, raw.n)) end)
            if not ok then LOG.add("warn", "replay gagal: " .. tostring(err)) end
        end)
        return true, "replay terkirim: " .. memoPath(inst)
    elseif e.kind == "IN " and CAP.firesignal then
        local ok, err = pcall(CAP.firesignal, inst.OnClientEvent, table.unpack(raw, 1, raw.n))
        if not ok then LOG.add("warn", "firesignal gagal: " .. tostring(err)) return false, "firesignal gagal" end
        return true, "firesignal terkirim: " .. memoPath(inst)
    end
    return false, "tidak didukung untuk event ini"
end

function L.toggleBlock(e)
    if not (e and e.kind == "OUT" and e.inst) then return nil end
    local on = not L.blocked[e.inst]
    L.blocked[e.inst] = on or nil
    return on, memoPath(e.inst)
end

