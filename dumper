local Store = { dirtyAt = nil, defaults = {}, active = nil }
local SAVE_KEYS, SAVE_SET = {}, {}
do
	-- Enabled sengaja nggak disimpan (script jangan nyala OFF diam-diam); Debug/Trace nggak disimpan biar print massal nggak nyala sendiri
	local skipKeys = { UI = true, ConfigFile = true, Enabled = true, Debug = true, Trace = true, DebugPlan = true }
