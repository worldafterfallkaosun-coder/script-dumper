-- ---------- helper diff ----------
local function norm(p) return (tostring(p):gsub("\\", "/")) end
local function tailOf(p) return norm(p):match("([^/]+)/?$") or norm(p) end

local function readAll(path)
    if not (CAP.readfile and CAP.isfile) then return nil end
    local okE, ex = pcall(CAP.isfile, path)
    if not okE or not ex then return nil end
    local ok, s = pcall(CAP.readfile, path)
    if ok and type(s) == "string" then return s end
    return nil
end

local function readParts(root, name, ext)
    local out, part = {}, 1
    while part <= 40 do
        local f = (part == 1) and ("%s/%s.%s"):format(root, name, ext) or ("%s/%s.part%d.%s"):format(root, name, part, ext)
        local s = readAll(f)
        if not s then break end
        out[#out + 1] = s
        part += 1
    end
    return table.concat(out, "\n")
end

local function lineSet(text, filter)
    local set, list = {}, {}
    for line in text:gmatch("[^\r\n]+") do
        if not filter or filter(line) then
            if not set[line] then
                set[line] = true
                list[#list + 1] = line
            end
        end
    end
    return set, list
end

local function scriptMap(text)
    local map = {}
    for line in text:gmatch("[^\r\n]+") do
        local _, cls, path, hash = line:match("^(.-) | (.-) | (.-) | (%S*)$")
        if path then map[path] = { hash = hash, cls = cls } end
    end
    return map
end

local function manifestOf(root)
    local s = readAll(root .. "/manifest.json")
    if not s or not HttpService then return nil end
    local ok, d = pcall(HttpService.JSONDecode, HttpService, s)
    return ok and type(d) == "table" and d or nil
end

local function scopeKey(m)
    if not m then return "?" end
    local s = m.scope
    if type(s) == "table" then
        local c = {}
        for _, v in ipairs(s) do c[#c + 1] = tostring(v) end
        table.sort(c)
        return table.concat(c, ",")
    end
    return tostring(s or "all")
end

local function topGroups(list)
    local g, rows = {}, {}
    for _, l in ipairs(list) do
        local path = l:match("^%S+%s+(.+)$") or l
        local k = path:match("^([^%.]+%.[^%.]+)") or path
        g[k] = (g[k] or 0) + 1
    end
    for k, n in next, g do rows[#rows + 1] = { k, n } end
    table.sort(rows, function(a, b)
        if a[2] ~= b[2] then return a[2] > b[2] end
        return a[1] < b[1]
    end)
    return rows
end

-- cari folder dump terakhir (lebih lama dari curRoot) untuk PlaceId yang sama
function D.findPrev(curRoot)
    if not (CAP.listfiles and CAP.isfile and CAP.readfile) then return nil end
    local curTail = tailOf(curRoot)
    local pid = tostring(game.PlaceId) .. "_"
    local okT, top = pcall(CAP.listfiles, "DumpPP")
    if not okT or type(top) ~= "table" then return nil end
    local best, bestTail
    for _, base in ipairs(top) do
        base = norm(base)
        if tailOf(base):sub(1, #pid) == pid then
            local okS, subs = pcall(CAP.listfiles, base)
            if okS and type(subs) == "table" then
                for _, s in ipairs(subs) do
                    s = norm(s)
                    local tl = tailOf(s)
                    if tl:match("^%d+_%d+$") and tl < curTail and (not bestTail or tl > bestTail) then
                        local okM, has = pcall(CAP.isfile, s .. "/manifest.json")
                        if okM and has then best, bestTail = s, tl end
                    end
                end
            end
        end
    end
    return best
end

function D.diff(curRoot, prevRoot)
    if not (CAP.readfile and CAP.isfile and CAP.writefile) then
        LOG.add("warn", "diff butuh readfile/isfile/writefile")
        return false
    end
    prevRoot = prevRoot or D.findPrev(curRoot)
    if not prevRoot then
        LOG.add("info", "diff: belum ada dump sebelumnya untuk place ini (atau executor tanpa listfiles)")
        return false
    end
    local mc, mp = manifestOf(curRoot), manifestOf(prevRoot)
    if not mc then
        LOG.add("warn", "diff: dump saat ini belum punya manifest, jalankan dump dulu")
        return false
    end
    if scopeKey(mc) ~= scopeKey(mp) then
        LOG.add("warn", ("diff dilewati: scope beda (%s vs %s)"):format(scopeKey(mc), scopeKey(mp)))
        return false
    end

    local wd = W.new("diff_vs_prev")
    wd.add("# Dumper++ diff")
    wd.add("sekarang : " .. curRoot .. "  (PlaceVersion " .. tostring(mc.placeVersion) .. ")")
    wd.add("sebelum  : " .. prevRoot .. "  (PlaceVersion " .. tostring(mp and mp.placeVersion) .. ")")
    wd.add("scope    : " .. scopeKey(mc))
    wd.add("")

    local function emitDiff(title, curSet, curList, prevSet, prevList, grouped)
        local added, removed = {}, {}
        for _, l in ipairs(curList) do if not prevSet[l] then added[#added + 1] = l end end
        for _, l in ipairs(prevList) do if not curSet[l] then removed[#removed + 1] = l end end
        wd.add(("== %s: +%d / -%d =="):format(title, #added, #removed))
        if grouped then
            for _, sign in ipairs({ "+", "-" }) do
                local rows = topGroups(sign == "+" and added or removed)
                for i = 1, math.min(#rows, 25) do
                    wd.add(("  grup %s %-40s %d"):format(sign, rows[i][1], rows[i][2]))
                end
            end
        end
        for _, pair in ipairs({ { "+", added }, { "-", removed } }) do
            local list = pair[2]
            for i, l in ipairs(list) do
                if i > 1500 then
                    wd.add(("%s ... (+%d lagi)"):format(pair[1], #list - 1500))
                    break
                end
                wd.add(pair[1] .. " " .. l)
            end
        end
        wd.add("")
        return #added, #removed
    end

    local cSet, cList = lineSet(readParts(curRoot, "instances", "txt"))
    local pSet, pList = lineSet(readParts(prevRoot, "instances", "txt"))
    local ia, ir = emitDiff("INSTANCE", cSet, cList, pSet, pList, true)

    local isRemote = function(l) return l:sub(1, 1) == "[" end
    local cRs, cRl = lineSet(readParts(curRoot, "remotes", "txt"), isRemote)
    local pRs, pRl = lineSet(readParts(prevRoot, "remotes", "txt"), isRemote)
    local ra, rr = emitDiff("REMOTE", cRs, cRl, pRs, pRl, false)

    local cm = scriptMap(readParts(curRoot, "scripts/_index", "txt"))
    local pm = scriptMap(readParts(prevRoot, "scripts/_index", "txt"))
    local sNew, sGone, sChg = {}, {}, {}
    for path, e in next, cm do
        local o = pm[path]
        if not o then
            sNew[#sNew + 1] = ("%s  [%s]"):format(path, e.cls)
        elseif o.hash ~= e.hash and e.hash ~= "?" and o.hash ~= "?" then
            sChg[#sChg + 1] = ("%s  [%s]  %s -> %s"):format(path, e.cls, o.hash:sub(1, 10), e.hash:sub(1, 10))
        end
    end
    for path, e in next, pm do
        if not cm[path] then sGone[#sGone + 1] = ("%s  [%s]"):format(path, e.cls) end
    end
    table.sort(sNew) table.sort(sGone) table.sort(sChg)
    wd.add(("== SCRIPT: baru %d / hilang %d / berubah %d =="):format(#sNew, #sGone, #sChg))
    for _, pair in ipairs({ { "+", sNew }, { "-", sGone }, { "~", sChg } }) do
        for i, l in ipairs(pair[2]) do
            if i > 1500 then
                wd.add(("%s ... (+%d lagi)"):format(pair[1], #pair[2] - 1500))
                break
            end
            wd.add(pair[1] .. " " .. l)
        end
    end
    wd.close()
    LOG.add("info", ("diff vs %s | instance +%d/-%d | remote +%d/-%d | script +%d/-%d ~%d -> diff_vs_prev.txt"):format(
        tailOf(prevRoot), ia, ir, ra, rr, #sNew, #sGone, #sChg))
    return true
end

function D.diffLatest()
    if not W.root then
        LOG.add("warn", "diff: belum ada dump di sesi ini, jalankan dump dulu")
        return false
    end
    local ok, res = pcall(D.diff, W.root)
    if not ok then LOG.add("error", "diff gagal: " .. tostring(res)) return false end
    return res
end

-- ---------- dump utama ----------
function D.run()
    if D.running then return end
    if not CAN_WRITE then
        LOG.add("error", "executor tidak punya writefile/appendfile/makefolder: dump dibatalkan")
        return
    end
    D.running, APP.cancel = true, false
    W.newRoot()
    SRC.hits, SRC.miss, SRC.disk = 0, 0, 0
    SRC.failed = setmetatable({}, { __mode = "k" }) -- dump eksplisit selalu mencoba ulang script yang gagal
    local ROOT = W.ensureRoot()
    pcall(CAP.makefolder, ROOT .. "/scripts")
    if CFG.DumpBytecode then pcall(CAP.makefolder, ROOT .. "/bytecode") end

    local M = CFG.Modules
    local errors, timings = {}, {}
    local counts = {
        tree = 0, nil_ = 0, values = 0, attrs = 0, tags = 0, scripts = 0, dups = 0,
        modules = 0, senv = 0, remotes = 0, gcFuncs = 0, gcTables = 0, gui = 0, prompts = 0, player = 0, xrefRemotes = 0,
        callsites = 0, strings = 0, cacheHits = 0, cacheDisk = 0, cacheMiss = 0,
    }
    local XR = { names = {}, refs = {}, reqs = {}, sizes = {} }
    local AN = {
        sites = {}, nsites = 0, handlers = {}, strs = {}, nstr = 0, urls = {}, nurls = 0,
        assets = {}, nassets = 0, prof = {},
    }
    local selNames = {}
    for id in next, SC.sel do selNames[#selNames + 1] = id end
    table.sort(selNames)
    local scoped = SC.active()
    LOG.add("info", scoped and ("scope: " .. table.concat(selNames, ", ")) or "scope: seluruh game")

    local phasesOn = {
        M.instances, M.tags, M.scripts, M.modules_return and CAP.getloadedmodules, M.senv and CAP.getsenv,
        M.gc and CAP.getgc, M.remotes, M.gui, M.prompts, M.player, M.saveinstance and CAP.saveinstance,
    }
    local total, phaseNo, curBase = 0, 0, 0
    for i = 1, 11 do if phasesOn[i] then total += 1 end end
    total = math.max(total, 1)

    local function sub(frac, text) D.status(text, curBase + frac / total, true) end
    local function phase(name, enabled, fn)
        if not enabled or APP.cancel then return end
        phaseNo += 1
        curBase = (phaseNo - 1) / total
        D.status(name .. " ...", curBase)
        local t0 = os.clock()
        local ok, err = pcall(fn)
        W.flushAll()
        timings[name] = math.floor((os.clock() - t0) * 100) / 100
        if not ok then
            errors[#errors + 1] = name .. ": " .. tostring(err)
            LOG.add("error", name .. " gagal: " .. tostring(err))
        end
    end

    local ok, err = pcall(function()
        if not SCAN.done or os.clock() - SCAN.at > 60 then
            D.status("refresh scan ...", 0)
            S.run(function(f, t) D.status(t, f * 0.02, true) end)
        end

        local scriptList, scriptSet, loadedMods, loadedList = {}, {}, {}, {}
        local function addScript(s)
            if not scriptSet[s] then
                scriptSet[s] = true
                scriptList[#scriptList + 1] = s
            end
        end

        -- 1. instance tree + values + attributes
        phase("instances", M.instances, function()
            local list = INDEX.all
            local total2 = #list
            local wTree, wNil = W.new("instances"), W.new("nil_instances")
            local wVals, wAttr = W.new("values"), W.new("attributes")
            local classCount = {}
            for i = 1, total2 do
                U.pace()
                local inst = list[i]
                pcall(function()
                    if inst == game or (APP.gui and inst:IsDescendantOf(APP.gui)) then return end
                    if not SC.inst(inst) then return end
                    local cls = inst.ClassName
                    local intree = U.inGame(inst)
                    local p = U.path(inst, intree)
                    local w = intree and wTree or wNil
                    w.add(("%-26s %s"):format(cls, p))
                    if intree then counts.tree += 1 else counts.nil_ += 1 end
                    classCount[cls] = (classCount[cls] or 0) + 1
                    if inst:IsA("ValueBase") then
                        local okv, val = pcall(function() return inst.Value end)
                        wVals.add(("%-14s %s = %s"):format(cls, p, okv and U.ser(val, 2, {}, "") or "<?>"))
                        counts.values += 1
                    end
                    local oka, attrs = pcall(inst.GetAttributes, inst)
                    if oka and type(attrs) == "table" and next(attrs) ~= nil then
                        wAttr.add(p)
                        for k, val in next, attrs do
                            wAttr.add(("    %s = %s"):format(tostring(k), U.ser(val, 2, {}, "    ")))
                        end
                        counts.attrs += 1
                    end
                end)
                if i % 2000 == 0 then sub(i / total2, ("instances %d/%d"):format(i, total2)) end
            end
            local rows = {}
            for cls, n in next, classCount do rows[#rows + 1] = { cls, n } end
            table.sort(rows, function(a, b) return a[2] > b[2] end)
            local wc = W.new("class_stats")
            for _, r in ipairs(rows) do wc.add(("%8d  %s"):format(r[2], r[1])) end
        end)

        -- 2. tags
        phase("tags", M.tags, function()
            local CS = svc("CollectionService")
            local w = W.new("tags")
            for _, tag in ipairs(CS:GetAllTags()) do
                U.pace()
                local items = CS:GetTagged(tag)
                local keep = SC.str(tag)
                if not keep then
                    for i = 1, math.min(#items, 20) do
                        if SC.inst(items[i]) then keep = true break end
                    end
                end
                if keep then
                    w.add(("## %s (%d)"):format(tag, #items))
                    for i, inst in ipairs(items) do
                        if i > 50 then w.add("  ...") break end
                        w.add("  " .. U.path(inst))
                    end
                    counts.tags += 1
                end
            end
        end)

        -- 3. script + module (decompile paralel, dedup by hash) + xref
        phase("scripts", M.scripts, function()
            for _, s in ipairs(INDEX.scripts) do addScript(s) end
            if CAP.getscripts then
                local okS, l = pcall(CAP.getscripts)
                if okS then for _, s in ipairs(l) do addScript(s) end end
            end
            if CAP.getloadedmodules then
                local okM, l = pcall(CAP.getloadedmodules)
                if okM then
                    for _, m in ipairs(l) do
                        loadedMods[m] = true
                        loadedList[#loadedList + 1] = m
                        addScript(m)
                    end
                end
            end

            -- nama remote untuk xref
            if CFG.XRef then
                for _, r in ipairs(INDEX.remotes) do
                    local okN, nm = pcall(function() return r.Name end)
                    if okN then
                        local e = XR.names[nm]
                        if not e then
                            e = { paths = {}, count = 0 }
                            XR.names[nm] = e
                        end
                        e.count += 1
                        if #e.paths < 4 then e.paths[#e.paths + 1] = ("[%s] %s"):format(r.ClassName, U.path(r)) end
                    end
                end
            end
            local function xscan(m, body)
                XR.sizes[m.p] = #body
                if not CFG.XRef then return end
                local found = {}
                for w in body:gmatch("[%a_][%w_]*") do
                    if XR.names[w] then found[w] = true end
                end
                for q in body:gmatch("[\"']([^\"'\r\n]+)[\"']") do
                    if XR.names[q] then found[q] = true end
                end
                for nm in next, found do
                    local lst = XR.refs[nm]
                    if not lst then
                        lst = {}
                        XR.refs[nm] = lst
                    end
                    lst[#lst + 1] = m.p
                end
                local n = 0
                for expr in body:gmatch("require%s*%(([^%)\r\n]+)%)") do
                    n += 1
                    if n > 25 then break end
                    local l = XR.reqs[m.p]
                    if not l then
                        l = {}
                        XR.reqs[m.p] = l
                    end
                    l[#l + 1] = U.clean(expr:sub(1, 100))
                end
            end

            -- ===== v5: analisis statis per script (callsite remote, string, url, asset, profil) =====
            local SENDM = { "FireServer", "InvokeServer" }
            local function cnt(body, pat)
                local n = 0
                for _ in body:gmatch(pat) do n += 1 end
                return n
            end
            local function remoteName(ref)
                local lit = ref:match("[\"']([^\"']+)[\"']%)*%]*$")
                if lit then return lit end
                return ref:match("([%a_][%w_]*)$") or ref
            end
            local function bump(tbl, key, nKey, cap)
                local c = tbl[key]
                if c then
                    tbl[key] = c + 1
                elseif AN[nKey] < cap then
                    tbl[key] = 1
                    AN[nKey] += 1
                end
            end
            local function ana(m, body)
                if not (M.callsites or M.strings) then return end
                local nlines = 0
                SRC.eachLine(body, function(line, ln)
                    nlines = ln
                    if #line > 600 then return end
                    if M.callsites then
                        for _, meth in ipairs(SENDM) do
                            local a, b = line:find(":" .. meth .. "(", 1, true)
                            if a and AN.nsites < 30000 then
                                AN.nsites += 1
                                AN.sites[AN.nsites] = {
                                    ref = line:sub(1, a - 1):match("([%w_%.%[%]\"'%(%)]+)$") or "?",
                                    meth = meth, args = U.clean(line:sub(b + 1, b + 160)), p = m.p, ln = ln,
                                }
                            end
                        end
                        local hr, params = line:match("([%w_%.%[%]\"']+)%.OnClientEvent:Connect%(function%(([^%)]*)%)")
                        if not hr then
                            hr, params = line:match("([%w_%.%[%]\"']+)%.OnClientInvoke%s*=%s*function%(([^%)]*)%)")
                        end
                        if hr and #AN.handlers < 8000 then
                            AN.handlers[#AN.handlers + 1] = { ref = hr, params = params, p = m.p, ln = ln }
                        end
                    end
                    if M.strings then
                        for q in line:gmatch('"([^"\\]+)"') do
                            local n = #q
                            if n >= 4 and n <= 160 then
                                local e = AN.strs[q]
                                if e then
                                    e[1] += 1
                                elseif AN.nstr < 60000 then
                                    AN.strs[q] = { 1, m.p }
                                    AN.nstr += 1
                                end
                            end
                        end
                    end
                end)
                if M.strings then
                    for id in body:gmatch("rbxassetid://(%d+)") do bump(AN.assets, id, "nassets", 40000) end
                    for u in body:gmatch("https?://[%w%-%._~:/%?#@!%$&%*%+,;=%%]+") do
                        if #u < 200 then bump(AN.urls, u, "nurls", 5000) end
                    end
                end
                local pr = {
                    fire = cnt(body, ":FireServer%("), invoke = cnt(body, ":InvokeServer%("), onclient = cnt(body, "OnClientEvent"),
                    http = cnt(body, "HttpService") + cnt(body, "RequestAsync"),
                    dyn = cnt(body, "loadstring") + cnt(body, "getfenv") + cnt(body, "setfenv"),
                    conn = cnt(body, ":Connect%("), kick = cnt(body, ":Kick%("), lines = nlines,
                }
                pr.score = pr.fire + pr.invoke * 2 + pr.onclient + pr.http * 3 + pr.dyn * 3
                    + math.floor(pr.conn / 5) + math.floor(nlines / 400)
                AN.prof[#AN.prof + 1] = { m.p, pr }
            end

            local meta, jobs, primaryOf = {}, {}, {}
            for _, s in ipairs(scriptList) do
                U.pace()
                if (CFG.DumpCore or not U.isCore(s)) and SC.inst(s) then
                    local i = #meta + 1
                    local p = U.path(s)
                    local hash
                    if CAP.getscripthash then
                        local okh, h = pcall(CAP.getscripthash, s)
                        if okh and h then hash = tostring(h) end
                    end
                    local fname = ("%04d_%s.lua"):format(i, (p:gsub("[^%w_%.%-]", "_")):sub(-90))
                    local m = { s = s, p = p, hash = hash, fname = fname, cls = s.ClassName }
                    meta[i] = m
                    local primary = hash and primaryOf[hash]
                    if primary then
                        m.dupOf = primary
                        primary.copies = (primary.copies or 1) + 1
                        counts.dups += 1
                    else
                        if hash then primaryOf[hash] = m end
                        jobs[#jobs + 1] = m
                    end
                end
            end

            local function process(m)
                local s = m.s
                local body, real
                if CFG.DecompileScripts and CAP.decompile then
                    local b, isReal, why = SRC.get(s)
                    if isReal and b then
                        body, real = b, true
                    else
                        body = "-- decompile gagal: " .. tostring(why or "hasil kosong") .. "\n" .. U.fallbackBody(s)
                    end
                else
                    body = U.fallbackBody(s)
                end
                if real then
                    pcall(xscan, m, body)
                    pcall(ana, m, body)
                end
                local extra = ""
                pcall(function()
                    if s:IsA("BaseScript") then
                        extra = ("-- Enabled   : %s\n-- RunContext: %s\n"):format(tostring(s.Enabled), tostring(s.RunContext))
                    end
                end)
                local header = ("-- Path      : %s\n-- Class     : %s\n-- Hash      : %s\n-- Loaded    : %s\n-- Copies    : %d\n%s\n"):format(
                    m.p, m.cls, m.hash or "?", tostring(loadedMods[s] == true), m.copies or 1, extra)
                CAP.writefile(ROOT .. "/scripts/" .. m.fname, header .. body)
                if CFG.DumpBytecode and CAP.getscriptbytecode then
                    local okb, bc = pcall(CAP.getscriptbytecode, s)
                    if okb and type(bc) == "string" then
                        pcall(CAP.writefile, ROOT .. "/bytecode/" .. (m.fname:gsub("%.lua$", ".bin")), bc)
                    end
                end
            end

            local N = math.max(1, CFG.DecompileWorkers)
            local nextJob, finished, workersDone, totalJobs = 1, 0, 0, #jobs
            local function worker()
                while true do
                    U.pace()
                    local i = nextJob
                    if i > totalJobs then return end
                    nextJob = i + 1
                    local job = jobs[i]
                    local okp, e = pcall(process, job)
                    if okp then
                        counts.scripts += 1
                    else
                        errors[#errors + 1] = ("script %s: %s"):format(job.p, tostring(e))
                    end
                    finished += 1
                    if finished % 5 == 0 then
                        sub(finished / totalJobs, ("scripts %d/%d (dup dilewati: %d)"):format(finished, totalJobs, counts.dups))
                    end
                end
            end
            for _ = 1, N do
                task.spawn(function()
                    pcall(worker)
                    workersDone += 1
                end)
            end
            while workersDone < N do task.wait(0.1) end

            local idx = W.new("scripts/_index")
            for _, m in ipairs(meta) do
                local where = m.dupOf and ("dup -> " .. m.dupOf.fname) or m.fname
                idx.add(("%s | %s | %s | %s"):format(where, m.cls, m.p, m.hash or "?"))
            end
            idx.close()

            -- xref.txt: remote -> script yang menyebut namanya, lalu daftar require per script
            if CFG.XRef and not APP.cancel then
                local wx = W.new("xref")
                local rows = {}
                for nm, e in next, XR.names do rows[#rows + 1] = { nm, e, XR.refs[nm] or {} } end
                table.sort(rows, function(a, b)
                    if #a[3] ~= #b[3] then return #a[3] > #b[3] end
                    return a[1] < b[1]
                end)
                wx.add("# REMOTE -> script client yang menyebut namanya")
                wx.add("# (pencocokan berdasarkan nama string/identifier; nama umum bisa false positive)")
                wx.add("")
                for _, r in ipairs(rows) do
                    wx.add(("## %s  (x%d remote)  refs=%d"):format(r[1], r[2].count, #r[3]))
                    for _, p in ipairs(r[2].paths) do wx.add("   remote: " .. p) end
                    for i, p in ipairs(r[3]) do
                        if i > 15 then
                            wx.add(("   ... +%d script lagi"):format(#r[3] - 15))
                            break
                        end
                        wx.add("   <- " .. p)
                    end
                    if #r[3] == 0 then wx.add("   (tidak disebut script client: kemungkinan dipicu server / nama dinamis / obfuscated)") end
                    if #r[3] > 0 then counts.xrefRemotes += 1 end
                end
                wx.add("")
                wx.add("# REQUIRE per script")
                local rp = {}
                for p in next, XR.reqs do rp[#rp + 1] = p end
                table.sort(rp)
                for _, p in ipairs(rp) do
                    wx.add("## " .. p)
                    for _, e in ipairs(XR.reqs[p]) do wx.add("   require(" .. e .. ")") end
                end
                wx.close()
            end

            -- ===== v5: tulis hasil analisis statis =====
            if not APP.cancel then
                counts.callsites, counts.strings = AN.nsites, AN.nstr
                counts.cacheHits, counts.cacheDisk, counts.cacheMiss = SRC.hits, SRC.disk, SRC.miss

                if M.callsites and (AN.nsites > 0 or #AN.handlers > 0) then
                    pcall(function()
                        local groups, order = {}, {}
                        local function grp(ref)
                            local nm = remoteName(ref)
                            local known = XR.names[nm]
                            local key = known and nm or ref
                            local g = groups[key]
                            if not g then
                                g = { key = key, known = known, out = {}, inn = {} }
                                groups[key] = g
                                order[#order + 1] = g
                            end
                            return g
                        end
                        for _, st in ipairs(AN.sites) do
                            local g = grp(st.ref)
                            g.out[#g.out + 1] = st
                        end
                        for _, h in ipairs(AN.handlers) do
                            local g = grp(h.ref)
                            g.inn[#g.inn + 1] = h
                        end
                        table.sort(order, function(a, b)
                            local ta, tb = #a.out + #a.inn, #b.out + #b.inn
                            if ta ~= tb then return ta > tb end
                            return a.key < b.key
                        end)
                        local w = W.new("remote_callsites")
                        w.add("# CALLSITE remote dari decompile script client (statis; melengkapi live spy)")
                        w.add("# nomor baris = baris pada hasil decompile. key yang bukan nama remote = variabel/ekspresi.")
                        w.add("")
                        for _, g in ipairs(order) do
                            w.add(("## %s  OUT=%d IN=%d%s"):format(g.key, #g.out, #g.inn,
                                g.known and ("  [remote: " .. (g.known.paths[1] or "?") .. "]") or ""))
                            for i, st in ipairs(g.out) do
                                if i > 12 then
                                    w.add(("   ... +%d callsite OUT lagi"):format(#g.out - 12))
                                    break
                                end
                                w.add(("   OUT %s(%s)  <- %s:%d"):format(st.meth, st.args, st.p, st.ln))
                            end
                            for i, h in ipairs(g.inn) do
                                if i > 6 then
                                    w.add(("   ... +%d handler lagi"):format(#g.inn - 6))
                                    break
                                end
                                w.add(("   IN  function(%s)  <- %s:%d"):format(h.params, h.p, h.ln))
                            end
                        end
                        w.close()
                    end)
                end

                if M.strings then
                    pcall(function()
                        local rows = {}
                        for q, e in next, AN.strs do rows[#rows + 1] = { q, e[1], e[2] } end
                        table.sort(rows, function(a, b)
                            if a[2] ~= b[2] then return a[2] > b[2] end
                            return a[1] < b[1]
                        end)
                        local w = W.new("strings")
                        w.add("# string literal dari script client (>=4 karakter): jumlah | string | contoh script")
                        for i, r in ipairs(rows) do
                            if i % 3000 == 0 then U.pace() end
                            w.add(("%5d  %s  | %s"):format(r[2], U.clean(r[1]), r[3]))
                        end
                        w.close()

                        local us, as = {}, {}
                        for u, n in next, AN.urls do us[#us + 1] = { u, n } end
                        for id, n in next, AN.assets do as[#as + 1] = { id, n } end
                        local function byCount(a, b)
                            if a[2] ~= b[2] then return a[2] > b[2] end
                            return a[1] < b[1]
                        end
                        table.sort(us, byCount)
                        table.sort(as, byCount)
                        local wu = W.new("urls_assets")
                        wu.add("# URL di script client (" .. #us .. ")")
                        for _, r in ipairs(us) do wu.add(("%5d  %s"):format(r[2], U.clean(r[1]))) end
                        wu.add("")
                        wu.add("# rbxassetid di script client (" .. #as .. ")")
                        for _, r in ipairs(as) do wu.add(("%5d  rbxassetid://%s"):format(r[2], r[1])) end
                        wu.close()
                    end)

                    pcall(function()
                        table.sort(AN.prof, function(a, b)
                            if a[2].score ~= b[2].score then return a[2].score > b[2].score end
                            return a[1] < b[1]
                        end)
                        local w = W.new("script_profile")
                        w.add("# peringkat script menurut aktivitas jaringan / kode dinamis (statis, dari hasil decompile)")
                        w.add("# score = fire + invoke*2 + onclient + http*3 + dyn*3 + connect/5 + baris/400")
                        for i, r in ipairs(AN.prof) do
                            if i > 400 then break end
                            local p = r[2]
                            w.add(("%5d  fire=%d invoke=%d onclient=%d http=%d dyn=%d conn=%d kick=%d lines=%d  %s"):format(
                                p.score, p.fire, p.invoke, p.onclient, p.http, p.dyn, p.conn, p.kick, p.lines, r[1]))
                        end
                        w.close()
                    end)
                end

                -- graf require (Mermaid): hanya sisi yang nama modulnya unik
                pcall(function()
                    local byName = {}
                    for _, mm in ipairs(meta) do
                        if mm.cls == "ModuleScript" then
                            local nm = mm.p:match("([^%.]+)$") or mm.p
                            local l = byName[nm]
                            if not l then
                                l = {}
                                byName[nm] = l
                            end
                            l[#l + 1] = mm.p
                        end
                    end
                    local ids, nid, nodeLines, edgeLines, unresolved = {}, 0, {}, {}, 0
                    local function node(p)
                        local id = ids[p]
                        if not id then
                            nid += 1
                            id = "n" .. nid
                            ids[p] = id
                            local short = (p:match("([^%.]+)$") or p):gsub("[^%w_%-]", "_")
                            nodeLines[#nodeLines + 1] = ('  %s["%s"]'):format(id, short)
                        end
                        return id
                    end
                    local rp = {}
                    for p in next, XR.reqs do rp[#rp + 1] = p end
                    table.sort(rp)
                    for _, p in ipairs(rp) do
                        for _, expr in ipairs(XR.reqs[p]) do
                            local cand = byName[remoteName(expr)]
                            if cand and #cand == 1 then
                                if #edgeLines < 600 then
                                    edgeLines[#edgeLines + 1] = ("  %s --> %s"):format(node(p), node(cand[1]))
                                end
                            else
                                unresolved += 1
                            end
                        end
                    end
                    if #edgeLines > 0 then
                        local w = W.new("require_graph", "mmd")
                        w.add("flowchart LR")
                        for _, l in ipairs(nodeLines) do w.add(l) end
                        for _, l in ipairs(edgeLines) do w.add(l) end
                        w.add(("%%%% sisi %d | require tidak terselesaikan (variabel / dinamis): %d"):format(#edgeLines, unresolved))
                        w.close()
                    end
                end)
            end
        end)

        -- 4. return ModuleScript yang sudah ke-load
