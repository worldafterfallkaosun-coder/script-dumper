    Frame = frame,
    Events = EV,
    Report = report,
    Summary = summaryText,
    State = function()
        local now = os.clock()
        return {
            blockHeld = blockHeld, lockedIn = lockedUntil - now, readyIn = readyAt - now, dodgeReadyIn = dodgeReadyAt - now,
            pending = #pending, expected = #expected, queue = #queue, guards = #swingGuards,
            stunSlack = stunSlack, tuneM1 = tune.M1, tuneM2 = tune.M2, blockFor = blockFor ~= nil,
        }
    end,
    Why = whyReport,
    Reset = resetStats,
    Save = Store.save,
    Load = Store.load,
    UI = UI,
    Stop = function()
        alive = false
        pcall(Store.save)
        pcall(uninstallSwingHook)
        if blockHeld then
            pcall(sendBlock, false)
            blockHeld = false
        end
        for _, c in ipairs(connections) do
            pcall(function()
                c:Disconnect()
            end)
        end
        for _, c in ipairs(UI.conns or {}) do
            pcall(function()
                c:Disconnect()
            end)
        end
        table.clear(queue)
        if UI.gui then
            pcall(function()
                UI.gui:Destroy()
            end)
            UI.gui = nil
        end
    end,
}

