    local statLbl = ordered(ctl, label(ctl, "live belum aktif | log: live/events_<jam>.log + .jsonl + remote_stats", { Size = UDim2.new(1, 0, 0, 16), TextSize = 11, TextColor3 = T.dim, Font = Enum.Font.Code, TextWrapped = false }))

    feedFrame = new("ScrollingFrame", {
        Size = UDim2.new(1, -16, 1, -250), Position = UDim2.new(0, 8, 0, 210), BackgroundColor3 = T.panel, BorderSizePixel = 0,
        ScrollBarThickness = 3, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
    }, lv)
    corner(feedFrame)
    new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 1) }, feedFrame)
    new("UIPadding", { PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4), PaddingTop = UDim.new(0, 4) }, feedFrame)
    ORD[feedFrame] = 0
    local actRow = new("Frame", { Size = UDim2.new(1, -16, 0, 28), Position = UDim2.new(0, 8, 1, -34), BackgroundTransparency = 1 }, lv)
    new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4) }, actRow)
    pages.live = lv

    -- feed mengisi sisa ruang di bawah panel kontrol (tinggi panel berubah mengikuti isi)
    local function relayout()
        local y = ctl.AbsoluteSize.Y + 4
        if y < 60 then return end
        feedFrame.Position = UDim2.fromOffset(8, y)
        feedFrame.Size = UDim2.new(1, -16, 1, -(y + 40))
    end
    ctl:GetPropertyChangedSignal("AbsoluteSize"):Connect(relayout)

    -- baris feed bisa dipilih; tombol aksi bekerja pada baris terpilih
    local sel, selRow
    local function setSel(e, row)
        if selRow and selRow.Parent then selRow.BackgroundTransparency = 1 end
        sel, selRow = e, row
        row.BackgroundColor3, row.BackgroundTransparency = T.panel2, 0.4
        setStatus("dipilih: " .. e.line:sub(1, 80), nil)
    end
    local function need()
        if sel then return true end
        setStatus("pilih event dulu (tap barisnya)", nil, T.warn)
        return false
    end
    button(actRow, "Detail", function()
        if need() then copy(sel.detail, "detail disalin") end
    end, { Size = UDim2.new(0.25, -3, 1, 0), TextSize = 12 })
    button(actRow, "Kode", function()
        if not need() then return end
        local okc, code = pcall(L.toCode, sel)
        if okc then copy(code, "kode Lua disalin") else setStatus("gagal membuat kode", nil, T.bad) end
    end, { Size = UDim2.new(0.25, -3, 1, 0), TextSize = 12 })
    button(actRow, "Replay", function()
        if not need() then return end
        local okr, msg = L.replay(sel)
        setStatus(msg or "", nil, okr and T.accent or T.warn)
    end, { Size = UDim2.new(0.25, -3, 1, 0), TextSize = 12 })
    button(actRow, "Block", function()
        if not need() then return end
        local on, p = L.toggleBlock(sel)
        if on == nil then
            setStatus("block hanya untuk event OUT", nil, T.warn)
        else
            setStatus((on and "BLOCK aktif (selama Live jalan): " or "block dilepas: ") .. p, nil, on and T.bad or T.accent)
        end
    end, { Size = UDim2.new(0.25, -3, 1, 0), TextSize = 12 })

    local function pumpFeed()
        local feed = L.feed
        if #feed == 0 then return end
        L.feed = {}
        if paused then return end
        for _, e in ipairs(feed) do
            local row = ordered(feedFrame, new("TextButton", {
                Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
                Text = e.line, TextColor3 = KIND_COLOR[e.kind] or T.text, Font = Enum.Font.Code, TextSize = 11,
                TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, AutoButtonColor = false, BorderSizePixel = 0,
            }, feedFrame))
            row.Activated:Connect(function() setSel(e, row) end)
        end
        local kids = {}
        for _, c in ipairs(feedFrame:GetChildren()) do if c:IsA("TextButton") then kids[#kids + 1] = c end end
        table.sort(kids, function(a, b) return a.LayoutOrder < b.LayoutOrder end)
        for i = 1, #kids - CFG.UIMaxRows do kids[i]:Destroy() end
        feedFrame.CanvasPosition = Vector2.new(0, 1e6)
    end
    task.spawn(function()
        while not APP.dead do
            task.wait(0.25)
            pcall(pumpFeed)
            if L.on or next(L.stats) then
                statLbl.Text = ("OUT %d | IN %d | RET %d | VAL %d | ATR %d | watch %d | drop %d | mute %d"):format(
                    L.stats.OUT or 0, L.stats["IN "] or 0, L.stats.RET or 0, L.stats.VAL or 0, L.stats.ATR or 0,
                    L.watchN, L.dropped, (function() local n = 0 for _ in next, L.muted do n += 1 end return n end)())
            end
        end
    end)

    -------------------------------------------------- Cari
    local sr = new("Frame", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Visible = false }, content)
    local qbox = new("TextBox", {
        Size = UDim2.new(1, -16, 0, 30), Position = UDim2.fromOffset(8, 8), BackgroundColor3 = T.panel, TextColor3 = T.text,
        PlaceholderText = "cari: nama / kelas / isi script / konstanta (min 2 huruf)", PlaceholderColor3 = T.dim, Text = "",
        Font = Enum.Font.Gotham, TextSize = 12, ClearTextOnFocus = false, BorderSizePixel = 0, TextXAlignment = Enum.TextXAlignment.Left,
    }, sr)
    corner(qbox)
    new("UIPadding", { PaddingLeft = UDim.new(0, 10) }, qbox)
    local srow = new("Frame", { Size = UDim2.new(1, -16, 0, 28), Position = UDim2.fromOffset(8, 44), BackgroundTransparency = 1 }, sr)
    new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4) }, srow)
    local resFrame = new("ScrollingFrame", {
        Size = UDim2.new(1, -16, 1, -86), Position = UDim2.fromOffset(8, 78), BackgroundColor3 = T.panel, BorderSizePixel = 0,
        ScrollBarThickness = 3, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
    }, sr)
    corner(resFrame)
    new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2) }, resFrame)
    new("UIPadding", { PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4), PaddingTop = UDim.new(0, 4) }, resFrame)
    ORD[resFrame] = 0

    local function renderResults(list)
        for _, c in ipairs(resFrame:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end
        ORD[resFrame] = 0
        for i, r in ipairs(list) do
            if i > CFG.SearchMax then break end
            local row = ordered(resFrame, new("TextButton", {
                Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
                Text = r.text, TextColor3 = T.text, Font = Enum.Font.Code, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left,
                TextWrapped = true, AutoButtonColor = false, BorderSizePixel = 0,
            }, resFrame))
            row.Activated:Connect(function() copy(r.copy or r.text, r.copy and "kode path disalin" or "baris disalin") end)
        end
        resFrame.CanvasPosition = Vector2.new(0, 0)
    end

    local searching = false
    local function runSearch(mode)
        if searching then return end
        local q = qbox.Text:lower():match("^%s*(.-)%s*$")
        if #q < 2 then
            setStatus("isi minimal 2 huruf", nil, T.warn)
            return
        end
        if not SCAN.done then
            setStatus("scan belum selesai", nil, T.warn)
            return
        end
        searching = true
        setStatus("mencari (" .. mode .. ")...", nil)
        task.spawn(function()
            local ok, res, err = pcall(SR[mode], q, CFG.SearchMax)
            searching = false
            if not ok then
                LOG.add("error", "cari: " .. tostring(res))
                setStatus("pencarian gagal (lihat Logs)", nil, T.bad)
                return
            end
            if not res then
                setStatus(tostring(err), nil, T.warn)
                return
            end
            renderResults(res)
            setStatus(("%d hasil | tap baris = salin"):format(#res), 1, T.accent)
        end)
    end
    button(srow, "Instance", function() runSearch("inst") end, { Size = UDim2.new(0.25, -3, 1, 0), TextSize = 12 })
    button(srow, "Remote", function() runSearch("remote") end, { Size = UDim2.new(0.25, -3, 1, 0), TextSize = 12 })
    button(srow, "Source", function() runSearch("src") end, { Size = UDim2.new(0.25, -3, 1, 0), TextSize = 12, BackgroundColor3 = T.accent, TextColor3 = T.bg })
    button(srow, "GC", function() runSearch("gc") end, { Size = UDim2.new(0.25, -3, 1, 0), TextSize = 12, BackgroundColor3 = T.blue, TextColor3 = T.bg })
    qbox.FocusLost:Connect(function(enter) if enter then runSearch("inst") end end)

    -------------------------------------------------- Logs
    local lg = new("Frame", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Visible = false }, content)
    local lrow = new("Frame", { Size = UDim2.new(1, -16, 0, 28), Position = UDim2.fromOffset(8, 8), BackgroundTransparency = 1 }, lg)
    new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4) }, lrow)
    button(lrow, "Salin path", function()
        if W.root then copy("workspace/" .. W.root, "path disalin") end
    end, { Size = UDim2.new(0.34, -3, 1, 0), TextSize = 12 })
    button(lrow, "Salin log", function()
        local t = {}
        for _, e in ipairs(LOG.lines) do t[#t + 1] = e.text end
        copy(table.concat(t, "\n"), "log disalin")
    end, { Size = UDim2.new(0.33, -3, 1, 0), TextSize = 12 })
    button(lrow, "Rescan", function() doRescan() end, { Size = UDim2.new(0.33, -3, 1, 0), TextSize = 12 })
    local logFrame = new("ScrollingFrame", {
        Size = UDim2.new(1, -16, 1, -48), Position = UDim2.fromOffset(8, 42), BackgroundColor3 = T.panel, BorderSizePixel = 0,
        ScrollBarThickness = 3, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
    }, lg)
    corner(logFrame)
    new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, logFrame)
    new("UIPadding", { PaddingLeft = UDim.new(0, 6), PaddingTop = UDim.new(0, 4) }, logFrame)
    ORD[logFrame] = 0
    local function addLogRow(e)
        ordered(logFrame, label(logFrame, e.text, {
            Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Font = Enum.Font.Code, TextSize = 11,
            TextColor3 = e.level == "error" and T.bad or (e.level == "warn" and T.warn or T.text),
        }))
        logFrame.CanvasPosition = Vector2.new(0, 1e6)
    end
    for _, e in ipairs(LOG.lines) do addLogRow(e) end
    LOG.onAdd = function(e)
        addLogRow(e)
        if e.level == "error" then setStatus(e.text, nil, T.bad) end
    end

    -------------------------------------------------- overview content + rescan
    local function fillOverview()
        local I = SCAN.info
        local lines = {
            ("<b>%s</b>"):format(W.gname),
            ("PlaceId %d  |  Executor %s"):format(game.PlaceId, tostring(I.executor)),
            ("instance %d (tree %d, nil %d)"):format(I.total or 0, I.tree or 0, I.nil_ or 0),
            ("remote %d | script %d | value %d | attr-holder %d"):format(I.remotes or 0, I.scripts or 0, I.values or 0, I.attrs or 0),
            ("prompt %d | tombol %d"):format(I.prompts or 0, I.buttons or 0),
            ("player %d | karakter %s | leaderstats %s"):format(I.players or 0, I.character and "ya" or "belum", I.leaderstats and "ada" or "tidak"),
            ("sistem terdeteksi: %d  (scan %.2fs)"):format(#SCAN.systems, I.seconds or 0),
        }
        if I.streaming then
            lines[#lines + 1] = '<font color="#F5B450">StreamingEnabled aktif: hanya instance yang ter-stream yang terlihat. Dekati area penting lalu Rescan.</font>'
        end
        if not CAN_WRITE then
            lines[#lines + 1] = '<font color="#EB646E">Executor tanpa writefile: dump/log file tidak bisa disimpan.</font>'
        end
        infoLbl.Text = table.concat(lines, "\n")
        fwLbl.Text = "<b>Framework:</b> " .. (#SCAN.frameworks > 0 and table.concat(SCAN.frameworks, ", ") or "tidak terdeteksi")
        local parts = {}
        for _, n in ipairs(CAPLIST) do
            parts[#parts + 1] = ('<font color="%s">%s%s</font>'):format(CAP[n] and "#5ADC8C" or "#EB646E", CAP[n] and "+" or "-", n)
        end
        capLbl.Text = "<b>Kemampuan executor:</b> " .. table.concat(parts, "  ")
    end

    doRescan = function()
        if SCAN.busy or D.running then return end
        task.spawn(function()
            local ok, err = pcall(S.run, function(f, t) setStatus(t, f) end)
            if not ok then LOG.add("error", "scan: " .. tostring(err)) end
            fillOverview()
            buildSystems()
            refreshScope()
            setStatus("scan selesai", 1, T.accent)
        end)
    end
    ordered(ov, button(ov, "RESCAN MAP", function() doRescan() end, { Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = T.blue, TextColor3 = T.bg, Font = Enum.Font.GothamBold }))

    addTab("ov", "Overview", ov)
    addTab("dump", "Dump", dp)
    addTab("live", "Live", lv)
    addTab("search", "Cari", sr)
    addTab("logs", "Logs", lg)
    fillOverview()
    buildSystems()
    refreshScope()
    showPage("dump")
    setStatus(("siap | %d sistem | RightControl = sembunyi"):format(#SCAN.systems), 0)

    gui.Parent = (CAP.gethui and CAP.gethui()) or CoreGui
end

