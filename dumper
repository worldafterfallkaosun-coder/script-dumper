    UI.toast = function(msg, kind)
        if not (CFG.Toasts and gui.Parent and gui.Enabled and alive) then
            return
        end
        local col = (kind == "bad" and T.bad) or (kind == "ok" and T.good) or (kind == "warn" and T.warn) or accent
        toastSeq += 1
        local f = make("Frame", { LayoutOrder = toastSeq, Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = T.bar, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 30 }, toastHost)
        corner(f, 8)
        local st = stroke(f, col, 1.2, 1)
        local lb = text(f, tostring(msg), 12, T.text, Enum.Font.GothamMedium, { Size = UDim2.new(1, -16, 1, 0), Position = UDim2.fromOffset(8, 0), TextTransparency = 1, ZIndex = 31, TextXAlignment = Enum.TextXAlignment.Center })
        tween(f, 0.15, { BackgroundTransparency = 0.05 })
        tween(st, 0.15, { Transparency = 0.2 })
        tween(lb, 0.15, { TextTransparency = 0 })
        toasts[#toasts + 1] = f
        while #toasts > 3 do
            local old = table.remove(toasts, 1)
            pcall(function()
                old:Destroy()
            end)
        end
        task.delay(2.2, function()
            if f.Parent then
                tween(f, 0.3, { BackgroundTransparency = 1 })
                tween(st, 0.3, { Transparency = 1 })
                tween(lb, 0.3, { TextTransparency = 1 })
            end
        end)
        task.delay(2.55, function()
            pcall(function()
                f:Destroy()
            end)
        end)
    end

