    local function clampToScreen(f)
        local vs = gui.AbsoluteSize
        local ap, as = f.AbsolutePosition, f.AbsoluteSize
        local dx, dy = 0, 0
        if ap.X + as.X > vs.X then
            dx = vs.X - (ap.X + as.X)
        end
        if ap.X + dx < 0 then
            dx = -ap.X
        end
        if ap.Y + as.Y > vs.Y then
            dy = vs.Y - (ap.Y + as.Y)
        end
        if ap.Y + dy < 0 then
            dy = -ap.Y
        end
        if dx ~= 0 or dy ~= 0 then
            local p = f.Position
            f.Position = UDim2.new(p.X.Scale, p.X.Offset + dx, p.Y.Scale, p.Y.Offset + dy)
        end
    end

    local function makeDraggable(handle, target, onTap)
        hook(handle.InputBegan, function(input)
            if not isPointer(input) then
