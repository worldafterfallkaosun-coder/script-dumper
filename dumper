if type(ENV.DumperPP) == "table" and type(ENV.DumperPP.Destroy) == "function" then
    pcall(ENV.DumperPP.Destroy)
end

local APP = { cleanups = {}, cancel = false, dead = false }
ENV.DumperPP = APP
local function onCleanup(f) APP.cleanups[#APP.cleanups + 1] = f end
function APP.Destroy()
    APP.dead, APP.cancel = true, true
    ENV.DumperPP_Hook4, ENV.DumperPP_Ret4 = nil, nil
    for i = #APP.cleanups, 1, -1 do pcall(APP.cleanups[i]) end
    if ENV.DumperPP == APP then ENV.DumperPP = nil end
end
function APP.Stop() APP.cancel = true end

