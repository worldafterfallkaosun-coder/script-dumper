function APP.LiveStart() return L.start() end
function APP.LiveStop() return L.stop() end
APP.CFG, APP.SCAN, APP.INDEX, APP.LIVE = CFG, SCAN, INDEX, L

task.spawn(function()
    UI.splash()
    local ok, err = pcall(S.run, UI.splashSet)
    if not ok then
        LOG.add("error", "scan gagal: " .. tostring(err))
        SCAN.busy, SCAN.done = false, true
    end
    if APP.dead then return end
    local okU, errU = pcall(UI.build)
    if not okU then
        LOG.add("error", "ui gagal: " .. tostring(errU) .. " (API tetap bisa dipakai lewat getgenv().DumperPP)")
        if splash.gui then pcall(function() splash.gui:Destroy() end) end
    end
end)
