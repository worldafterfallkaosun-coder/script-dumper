---------------------------------------------------------------------
-- helper dasar
---------------------------------------------------------------------
local lastYield = os.clock()
local function pace()
    if ENV.DumperPP_Stop then error("dihentikan oleh user", 0) end
    if os.clock() - lastYield > CFG.FrameBudget then
        task.wait()
        lastYield = os.clock()
    end
end

local function each(list, fn)
    for _, x in ipairs(list) do
        pace()
        pcall(fn, x)
    end
end

local function clean(s)
    return (tostring(s):gsub("%c", " "))
end

local function inGame(inst)
    local ok, r = pcall(inst.IsDescendantOf, inst, game)
    return ok and r == true
end

local function path(inst, intree)
    local ok, p = pcall(inst.GetFullName, inst)
    if not ok then return "<?>" end
    if intree == nil then intree = inGame(inst) end
    return (intree and "" or "[NIL] ") .. p
end

local function isCore(s)
    local ok, r = pcall(function()
        return (CoreGui and s:IsDescendantOf(CoreGui))
            or (CorePackages and s:IsDescendantOf(CorePackages))
    end)
    return ok and r == true
end

-- owner fungsi -> path script (di-cache per script, bukan per fungsi)
local ownerCache = setmetatable({}, { __mode = "k" })
local function ownerOf(f)
    local ok, s = pcall(function() return getfenv(f).script end)
    if ok and typeof(s) == "Instance" then
        local c = ownerCache[s]
        if not c then
            c = path(s)
            ownerCache[s] = c
        end
        return c
    end
    return nil
end

local function fnDesc(f, noOwner)
    local i = {}
    if debug.getinfo then
        local ok, r = pcall(debug.getinfo, f)
        if ok and type(r) == "table" then i = r end
    end
    local va = (i.is_vararg == true or i.is_vararg == 1) and "+..." or ""
    local desc = ("fn:%s line=%s params=%s%s upv=%s"):format(
        tostring(i.name or "?"), tostring(i.linedefined or i.line or "?"),
        tostring(i.numparams or "?"), va, tostring(i.nups or "?"))
    if not noOwner then
        desc = desc .. " owner=" .. (ownerOf(f) or tostring(i.short_src or i.source or "?"))
    end
    return desc
end

local function constSummary(f)
    if not debug.getconstants then return "" end
    local ok, c = pcall(debug.getconstants, f)
    if not ok or type(c) ~= "table" then return "" end
    local s = {}
    for _, k in next, c do
        if type(k) == "string" and #k > 2 and #k < 60 then
            s[#s + 1] = clean(k)
            if #s >= 16 then break end
        end
    end
    return #s > 0 and ("  consts={" .. table.concat(s, ", ") .. "}") or ""
end

local function upvalSummary(f)
    if not debug.getupvalues then return "" end
    local ok, u = pcall(debug.getupvalues, f)
    if not ok or type(u) ~= "table" then return "" end
    local types, n = {}, 0
    for _, v in next, u do
        n += 1
        if n <= 6 then types[n] = typeof(v) end
    end
    if n == 0 then return "" end
    return "  upvals={" .. table.concat(types, ",") .. (n > 6 and ",..." or "") .. "}"
end

local function mtSummary(t)
    if not getrawmetatable then return nil end
    local ok, mt = pcall(getrawmetatable, t)
    if not ok or type(mt) ~= "table" then return nil end
    local keys = {}
    pcall(function()
        for k, v in next, mt do
            keys[#keys + 1] = tostring(k) .. "=" .. typeof(v)
            if #keys >= 12 then break end
        end
    end)
    return "{" .. table.concat(keys, ", ") .. "}"
end

-- serializer: pakai `next` (bypass __pairs/__iter), tampilkan metatable
local function ser(v, depth, seen, ind)
    local t = typeof(v)
    if t == "string" then
        local s = clean(v:sub(1, CFG.MaxStringLen))
        return '"' .. s .. (#v > CFG.MaxStringLen and '..."' or '"')
    elseif t == "number" or t == "boolean" or t == "nil" then
        return tostring(v)
    elseif t == "Instance" then
        local ok, cls = pcall(function() return v.ClassName end)
        return ("Instance<%s> %s"):format(ok and cls or "?", path(v))
    elseif t == "function" then
        return fnDesc(v)
    elseif t == "table" then
        if seen[v] then return "<cycle>" end
        if depth <= 0 then return "{...}" end
        seen[v] = true
        local out, n, cut = {}, 0, false
        local mt = mtSummary(v)
        if mt then out[#out + 1] = ind .. "  -- metatable: " .. mt end
        pcall(function()
            for k, val in next, v do
                n += 1
                if n > CFG.MaxTableKeys then
                    cut = true
                    break
                end
                out[#out + 1] = ("%s  [%s] = %s"):format(
                    ind, ser(k, 0, seen, ""), ser(val, depth - 1, seen, ind .. "  "))
            end
        end)
        seen[v] = nil
        if #out == 0 then return "{}" end
        if cut then out[#out + 1] = ind .. "  -- (dipotong)" end
        return "{\n" .. table.concat(out, ",\n") .. "\n" .. ind .. "}"
    end
    local ok, s = pcall(tostring, v)
    return ("%s(%s)"):format(t, clean(ok and s or "?"))
end

---------------------------------------------------------------------
-- writer berbuffer + auto-split file besar + flush semua saat error
---------------------------------------------------------------------
local writers = {}
local function newWriter(name, ext)
    ext = ext or "txt"
    local part, bytes, buf, n = 1, 0, {}, 0
    local function fileName()
        if part == 1 then return ("%s/%s.%s"):format(ROOT, name, ext) end
        return ("%s/%s.part%d.%s"):format(ROOT, name, part, ext)
    end
    local current = fileName()
    writefile(current, "")

    local w = {}
    local function flush()
        if n > 0 then
            appendfile(current, table.concat(buf, "\n", 1, n) .. "\n")
            buf, n = {}, 0
        end
    end
    function w.add(line)
        n += 1
        buf[n] = line
        bytes += #line + 1
        if n >= 300 then flush() end
        if bytes >= CFG.MaxFileBytes then
            flush()
            part += 1
            bytes = 0
            current = fileName()
            writefile(current, "")
        end
    end
    w.close = flush
    writers[#writers + 1] = w
    return w
end

local function flushAll()
    for _, w in ipairs(writers) do pcall(w.close) end
end

---------------------------------------------------------------------
-- state bersama
---------------------------------------------------------------------
local errors, timings = {}, {}
local scriptList, scriptSet, remotes = {}, {}, {}
local loadedMods, loadedList = {}, {}
local counts = {
    tree = 0, nil_ = 0, values = 0, attrs = 0, tags = 0,
    scripts = 0, dups = 0, modules = 0, senv = 0,
    remotes = 0, gcFuncs = 0, gcTables = 0, captured = 0,
}

local function addScript(s)
    if not scriptSet[s] then
        scriptSet[s] = true
        scriptList[#scriptList + 1] = s
    end
end

local REMOTE_CLASSES = {
    RemoteEvent = true, RemoteFunction = true, UnreliableRemoteEvent = true,
    BindableEvent = true, BindableFunction = true,
}

local function phase(name, enabled, fn)
    phaseIdx += 1
    if not enabled then return end
    if ENV.DumperPP_Stop then return end
    curBase = (phaseIdx - 1) / PHASE_TOTAL
    status(name .. " ...", curBase)
    local t0 = os.clock()
    local ok, err = pcall(fn)
    flushAll()
    timings[name] = math.floor((os.clock() - t0) * 100) / 100
    if not ok then
        errors[#errors + 1] = name .. ": " .. tostring(err)
        status(name .. " gagal (lihat _errors.txt)")
    end
end

-- jalankan fungsi dengan timeout; thread yang kelamaan dibatalkan
local function withTimeout(fn, timeout, ...)
    local done, ok, res = false, false, nil
    local args = table.pack(...)
    local th = task.spawn(function()
        ok, res = pcall(fn, table.unpack(args, 1, args.n))
        done = true
    end)
    local t0 = os.clock()
    while not done and os.clock() - t0 < timeout do task.wait() end
    if not done then
        pcall(task.cancel, th)
        return false, "timeout"
    end
    return ok, res
end

-- fallback kalau decompile mati: constants + upvalue + proto (rekursif)
local function closureReport(f, out, depth, ind)
    if #out > 6000 then return end
    out[#out + 1] = ind .. "-- " .. fnDesc(f, true) .. upvalSummary(f)
    if debug.getconstants then
        local ok, c = pcall(debug.getconstants, f)
        if ok and type(c) == "table" then
            for i, k in next, c do
                local tk = type(k)
                if tk == "string" then
                    out[#out + 1] = ("%s-- k[%s] \"%s\""):format(ind, tostring(i), clean(k:sub(1, 120)))
                elseif tk == "number" then
                    out[#out + 1] = ("%s-- k[%s] %s"):format(ind, tostring(i), tostring(k))
                end
            end
        end
    end
    if depth > 0 and debug.getprotos then
        local ok, protos = pcall(debug.getprotos, f)
        if ok and type(protos) == "table" then
            for _, p in next, protos do
                if type(p) == "function" then closureReport(p, out, depth - 1, ind .. "  ") end
            end
        end
    end
end

local function fallbackBody(s)
    if not getscriptclosure then
        return "-- executor tidak punya decompile maupun getscriptclosure"
    end
    local ok, f = pcall(getscriptclosure, s)
    if not ok or type(f) ~= "function" then return "-- getscriptclosure gagal" end
    local out = { "-- [fallback] constants / upvalue / proto dari closure script" }
    closureReport(f, out, 3, "")
    return table.concat(out, "\n")
end

---------------------------------------------------------------------
-- 1. semua instance (termasuk nil-parented) + values + attributes
---------------------------------------------------------------------
phase("instances", true, function()
    local list
    if getinstances then
        list = getinstances()
    else
        list = game:GetDescendants()
        if getnilinstances then
            for _, i in ipairs(getnilinstances()) do list[#list + 1] = i end
        end
    end
    local total = #list

    local wTree = newWriter("instances")
    local wNil = newWriter("nil_instances")
    local wVals = CFG.DumpValues and newWriter("values") or nil
    local wAttr = CFG.DumpValues and newWriter("attributes") or nil
    local classCount = {}

    local function handle(inst)
        if inst == game then return end
        if ui.gui and (inst == ui.gui or inst:IsDescendantOf(ui.gui)) then return end

        local cls = inst.ClassName
        local intree = inGame(inst)
        local p = path(inst, intree)

        local w = intree and wTree or wNil
        w.add(("%-26s %s"):format(cls, p))
        if intree then counts.tree += 1 else counts.nil_ += 1 end
        classCount[cls] = (classCount[cls] or 0) + 1

        if inst:IsA("LuaSourceContainer") then addScript(inst) end
        if REMOTE_CLASSES[cls] then remotes[#remotes + 1] = inst end

        if wVals then
            if inst:IsA("ValueBase") then
                local okv, val = pcall(function() return inst.Value end)
                wVals.add(("%-14s %s = %s"):format(cls, p, okv and ser(val, 2, {}, "") or "<?>"))
                counts.values += 1
            end
            local oka, attrs = pcall(inst.GetAttributes, inst)
            if oka and type(attrs) == "table" and next(attrs) ~= nil then
                wAttr.add(p)
                for k, val in next, attrs do
                    wAttr.add(("    %s = %s"):format(tostring(k), ser(val, 2, {}, "    ")))
                end
                counts.attrs += 1
            end
        end
    end

    for i, inst in ipairs(list) do
        pace()
        pcall(handle, inst)
        if i % 2000 == 0 then
            sub(i / total, ("instances %d/%d"):format(i, total))
        end
    end

    local rows = {}
    for cls, n in next, classCount do rows[#rows + 1] = { cls, n } end
    table.sort(rows, function(a, b) return a[2] > b[2] end)
    local wc = newWriter("class_stats")
    for _, r in ipairs(rows) do wc.add(("%8d  %s"):format(r[2], r[1])) end
end)

