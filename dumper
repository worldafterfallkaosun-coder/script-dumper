    local function makeSwitch(parent, key, pos, onChange)
        local track = make("TextButton", {
            AnchorPoint = Vector2.new(1, 0.5), Position = pos, Size = UDim2.fromOffset(38, 20), Text = "",
            AutoButtonColor = false, BackgroundColor3 = T.off, BorderSizePixel = 0,
        }, parent)
        corner(track, 10)
        local knob = make("Frame", { Size = UDim2.fromOffset(14, 14), Position = UDim2.fromOffset(3, 3), BackgroundColor3 = T.text, BorderSizePixel = 0 }, track)
        corner(knob, 7)
        local function paint(animate)
            local on = CFG[key] and true or false
            local kp = on and UDim2.fromOffset(21, 3) or UDim2.fromOffset(3, 3)
            local col = on and accent or T.off
            if animate == true then
                tween(knob, 0.12, { Position = kp })
                tween(track, 0.12, { BackgroundColor3 = col })
            else
                knob.Position = kp
                track.BackgroundColor3 = col
            end
        end
        hook(track.Activated, function()
            CFG[key] = not CFG[key]
            paint(true)
            Store.touch()
            if onChange then
                onChange(CFG[key])
            end
        end)
        paints[#paints + 1] = paint
        paint(false)
        return track
    end

    local function switchRow(parent, label, key, hint, onChange)
        local row = make("Frame", { Size = UDim2.new(1, 0, 0, hint and 38 or 28), BackgroundTransparency = 1 }, parent)
        text(row, label, 12, T.text, Enum.Font.GothamMedium, { Size = UDim2.new(1, -50, 0, 18), Position = UDim2.fromOffset(0, hint and 0 or 5) })
        if hint then
            text(row, hint, 10, T.sub, Enum.Font.Gotham, { Size = UDim2.new(1, -50, 0, 14), Position = UDim2.fromOffset(0, 19), TextTruncate = Enum.TextTruncate.AtEnd })
        end
        makeSwitch(row, key, UDim2.new(1, 0, 0.5, 0), onChange)
        return row
    end

    local function sliderRow(parent, label, key, lo, hi, step, fmt, opts)
        opts = opts or {}
        local get = opts.get or function()
            return CFG[key]
        end
        local set = opts.set or function(v)
            CFG[key] = v
        end
        local row = make("Frame", { Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1 }, parent)
        text(row, label, 12, T.text, Enum.Font.GothamMedium, { Size = UDim2.new(0.62, 0, 0, 18) })
        local val = text(row, "", 12, accent, Enum.Font.GothamBold, {
            Position = UDim2.new(0.62, 0, 0, 0), Size = UDim2.new(0.38, 0, 0, 18), TextXAlignment = Enum.TextXAlignment.Right,
        })
        accentBind[#accentBind + 1] = { val, "TextColor3" }
        local track = make("Frame", { Position = UDim2.new(0, 0, 0, 29), Size = UDim2.new(1, 0, 0, 6), BackgroundColor3 = T.off, BorderSizePixel = 0 }, row)
        corner(track, 3)
        local fill = make("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = accent, BorderSizePixel = 0 }, track)
        corner(fill, 3)
        accentBind[#accentBind + 1] = { fill, "BackgroundColor3" }
        local knob = make("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.fromOffset(14, 14),
            BackgroundColor3 = T.text, BorderSizePixel = 0,
        }, track)
        corner(knob, 7)
        local hit = make("TextButton", { Position = UDim2.new(0, 0, 0, 18), Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1, Text = "", AutoButtonColor = false }, row)
        local function paint()
            local v = get()
            local a = math.clamp((v - lo) / (hi - lo), 0, 1)
            fill.Size = UDim2.new(a, 0, 1, 0)
            knob.Position = UDim2.new(a, 0, 0.5, 0)
            setT(val, fmt(v))
        end
        local function fromX(x)
            local w = math.max(track.AbsoluteSize.X, 1)
            local a = math.clamp((x - track.AbsolutePosition.X) / w, 0, 1)
            local v = lo + a * (hi - lo)
            v = math.floor(v / step + 0.5) * step
            v = tonumber(("%.4f"):format(math.clamp(v, lo, hi)))
            set(v)
            paint()
        end
        hook(hit.InputBegan, function(input)
            if not isPointer(input) then
                return
            end
            local sf = row:FindFirstAncestorOfClass("ScrollingFrame")
            if sf then
                sf.ScrollingEnabled = false
            end
            fromX(input.Position.X)
            activeDrag = {
                lock = sf,
                update = function(i)
                    fromX(i.Position.X)
                end,
                finish = function()
                    Store.touch()
                    if opts.onChange then
                        opts.onChange(get())
                    end
                end,
            }
        end)
        paints[#paints + 1] = paint
        paint()
        return row
    end

