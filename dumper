        end)
        if ok and type(data) == "table" then
            if data.SettingsRev ~= CFG.SettingsRev then data.DecompileWorkers = nil end
            merge(CFG, data)
        end
    end
    if type(ENV.DumperPP_Config) == "table" then merge(CFG, ENV.DumperPP_Config) end
end

