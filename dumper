            end
            local startPos, startUdim, moved = input.Position, target.Position, false
            activeDrag = {
                update = function(i)
                    local d = i.Position - startPos
                    if not moved and d.Magnitude > 6 then
                        moved = true
                    end
                    if moved then
                        target.Position = UDim2.new(startUdim.X.Scale, startUdim.X.Offset + d.X, startUdim.Y.Scale, startUdim.Y.Offset + d.Y)
