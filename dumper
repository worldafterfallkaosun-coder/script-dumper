----------------------------------------------------------------------
-- v7: lewat SetLocalBlocking asli game (Local.Blocking, animasi, walkspeed, BlockReadyAt lokal ikut bener; game juga
-- ngecek stun/busy/cooldown/InCombat pakai state-nya sendiri). Return false kalau game nolak ON secara lokal.
local function sendBlock(on)
	if not on then
		lastOwnOff = os.clock()
	end
	if CFG.UseGameBlock then
		local h = getHandler()
		local L = h and h.Local
		if type(L) == "table" and type(h.SetLocalBlocking) == "function" then
			if pcall(h.SetLocalBlocking, h, on) then
				if on then
					local L2 = h.Local
					if type(L2) ~= "table" or L2.Blocking ~= true then
						-- v8: cek lokal game nolak (state stun/busy lokalnya telat), padahal model kita (stun/cooldown/busy
						-- udah lewat) bilang server bakal nerima -> kirim remote langsung. Kalau server nolak, BlockRefused ngurus.
						if CFG.RawOnLocalRefuse then
							rawOn = true
							Combat:FireServer({ Info = "Block", On = true })
							return true
						end
						return false
					end
					rawOn = false
				elseif rawOn then
					rawOn = false
					Combat:FireServer({ Info = "Block", On = false })
				end
				return true
			end
		end
	end
	rawOn = false
	Combat:FireServer({ Info = "Block", On = on })
	return true
end

local function scheduleRelease(at)
	releaseAt = at
	cancel(releaseHandle)
	releaseHandle = schedule(at, function()
		if not blockHeld then
			return
		end
		sendBlock(false)
		blockHeld = false
		-- server: BlockReadyAt = waktu Block OFF + BlockCooldown
		readyAt = os.clock() + SR.BlockCooldown
	end)
end

local function pressBlock(hold)
	local now = os.clock()
	if blockHeld then
		trace("block gagal: block masih nyala")
		return false
	end
	if now < readyAt - 0.005 then
		if CFG.Trace then trace(("block gagal: cooldown block (sisa %.2fs)"):format(readyAt - now)) end
		return false
	end
	if now < lockedUntil then
		if CFG.Trace then trace(("block gagal: lagi kekunci stun/refuse (sisa %.2fs)"):format(lockedUntil - now)) end
		return false
	end
	local gl = gameLock()
	if gl and now < gl - 0.01 then
		if CFG.Trace then trace(("block gagal: state game bilang belum boleh (sisa %.2fs)"):format(gl - now)) end
		return false
	end
	-- lu lagi nahan block manual -> jangan diganggu (OFF kita bakal ngelepas block lu)
	local char = LocalPlayer.Character
	-- v5: atribut Blocking yang cuma telat ke-replicate abis OFF dari script sendiri bukan block manual
	if char and char:GetAttribute("Blocking") == true and (now - lastOwnOff) > net.rtt + 0.2 then
		trace("block gagal: lu lagi nahan block manual")
		return false
	end
	if CFG.Trace then trace(("BLOCK ON dikirim (hold %.3f)"):format(hold)) end
	blockHeld = true
	blockOnAt = now
	-- v8: block ini dikirim persis pas stun hit baru lepas -> hasilnya (diterima / ditolak) jadi bahan belajar stunSlack
	if CFG.FastUnlock and now - stunSrcUntil >= -0.01 and now - stunSrcUntil < 0.15 then
		stunProbeAt = now
	end
	if sendBlock(true) == false then
		blockHeld = false
		if CFG.Trace then trace("block ditolak cek lokal game (stun/busy/cooldown/InCombat)") end
		skip("local-refuse")
		return false
	end
	counters.fired += 1
	scheduleRelease(now + hold)
	return true
end

-- pastikan block yang lagi nyala masih nyala sampai `untilClock`
local function extendHoldTo(untilClock)
	if not blockHeld then
		return false
	end
	local want = math.min(untilClock, blockOnAt + CFG.MaxHold)
	if want > releaseAt then
		scheduleRelease(want)
	end
	return true
end

local function releaseBefore(t)
	if not blockHeld or releaseAt <= t then
		return
	end
	scheduleRelease(math.max(t, os.clock()))
	counters.released += 1
end

-- server udah nolak / matiin block kita -> batalin rencana release, jangan kirim OFF sia-sia
local function dropLocalBlock()
	cancel(releaseHandle)
	blockHeld = false
	rawOn = false
	-- v7: Local.Blocking game jangan nyangkut true (ON berikutnya jadi no-op, nggak ngirim apa-apa)
	if CFG.UseGameBlock then
		local h = getHandler()
		if h and type(h.Local) == "table" and h.Local.Blocking == true and type(h.DropLocalGuard) == "function" then
			pcall(h.DropLocalGuard, h, workspace:GetServerTimeNow())
		end
	end
end

-- v6: samain status block lokal sama server (atribut Blocking). Server bisa ngelepas block kita (stun dll)
-- tanpa script tau -> blockHeld nyangkut true -> semua rencana berikutnya dikira "udah nyala" padahal nggak.
local function syncBlock(now, char)
	if not (CFG.BlockResync and blockHeld and char) then
		return
	end
	if char:GetAttribute("Blocking") == true then
		blockAttrSeen = true
		return
	end
	if blockAttrSeen and (now - blockOnAt) > net.rtt * 1.5 + 0.25 then
		trace("resync: server nggak lagi nge-block, status lokal direset")
		dropLocalBlock()
		readyAt = math.max(readyAt, now)
	end
end

----------------------------------------------------------------------
-- v7: PRIORITAS BLOCK vs SWING
-- Server nolak Block ON selama BusyUntil (lu lagi nyerang) dan HoldToSwing game ngayun lagi di frame pertama
-- setelah busy abis. Jadi pas ada hit yang lagi ditunggu, TrySwing game ditahan di jendela
-- [waktu kirim block - lama swing, hit mendarat + ResultPad].
----------------------------------------------------------------------
local swingGuards = {}
local origTrySwing = nil
local hookedHandler = nil

local function guardSwing(atk, sendAt, hitAt)
	if not CFG.GuardPriority then
		return
	end
	local now = os.clock()
	for i = #swingGuards, 1, -1 do
		if swingGuards[i].to < now then
			table.remove(swingGuards, i)
		end
	end
	if #swingGuards >= 12 then
		table.remove(swingGuards, 1)
	end
	swingGuards[#swingGuards + 1] = { atk = atk, from = sendAt - CFG.SwingBusyEst - 0.02, to = hitAt + CFG.ResultPad }
end

local function clearGuards(atk)
	for i = #swingGuards, 1, -1 do
		if swingGuards[i].atk == atk then
			table.remove(swingGuards, i)
		end
	end
end

local function swingBlocked(now)
	for i = 1, #swingGuards do
		local g = swingGuards[i]
		if now >= g.from and now <= g.to then
			return true
		end
	end
	return false
end

local function installSwingHook()
	if origTrySwing then
		return true
	end
	local h = getHandler()
	if not (h and type(h.Local) == "table" and type(h.TrySwing) == "function") then
		return false
	end
	local orig = h.TrySwing
	pcall(function()
		if setreadonly then
			pcall(setreadonly, h, false)
		end
		h.TrySwing = function(self, ...)
			if alive and CFG.Enabled and CFG.GuardPriority then
				local now = os.clock()
				if swingBlocked(now) then
					counters.swingheld += 1
					return
				end
				if blockHeld then
					-- lu mau nyerang dan nggak ada hit yang ditunggu: lepas block script dulu (OFF nyampe duluan)
					releaseBefore(now)
				end
			end
			return orig(self, ...)
		end
	end)
	if h.TrySwing == orig then
		return false
	end
	origTrySwing, hookedHandler = orig, h
	return true
end

local function uninstallSwingHook()
	if origTrySwing and hookedHandler then
		pcall(function()
			hookedHandler.TrySwing = origTrySwing
		end)
	end
	origTrySwing, hookedHandler = nil, nil
end

----------------------------------------------------------------------
-- PREDIKSI WAKTU HIT & ANCAMAN
----------------------------------------------------------------------
local function timeScale(char, style, spec)
	local sf = numAttr(char, "SwingFactor", 1)
	local sp = ((style and style.Speed) or 1) * ((spec and spec.SwingSpeed) or 1)
	if sp <= 0 then
		sp = 1
	end
	return sf / sp
end

local function reachOf(char, style)
	local r = numAttr(char, "ReachFactor", 1)
	if style and style.ReachInfluence and Specs.reachInfl and Specs.reachInfl ~= 0 then
		r = 1 + (r - 1) / Specs.reachInfl * style.ReachInfluence
	end
	return r
end

-- tiru NextCombo server: reset ke 1 kalau kelamaan / abis stun, selain itu maju terus
local function nextCombo(char, style, now)
	local swings = style.M1.Swings
	local st = combo[char]
	local idx
	if not st or st.idx <= 0 then
		idx = 1
	else
		local prev = swings[st.idx]
		local window = (style.M1.ComboWindow or 0.8) + ((prev and prev.Endlag) or 0)
		if now - st.at > window then
			idx = 1
		else
			idx = st.idx % #swings + 1
		end
	end
	combo[char] = { idx = idx, at = now }
	return idx
end

local function m1Plan(attacker, now)
	local style = styleOf(attacker)
	local m1 = style and style.M1
	local swings = type(m1) == "table" and m1.Swings
	if type(swings) ~= "table" or #swings == 0 then
		return {
			kind = "M1",
			lead = CFG.DefaultM1Lead * numAttr(attacker, "SwingFactor", 1),
			reach = numAttr(attacker, "ReachFactor", 1),
		}
	end
	local idx = nextCombo(attacker, style, now)
	local spec = swings[idx]
	if type(spec) ~= "table" then
		spec = swings[1]
		idx = 1
	end
	return {
		kind = "M1",
		lead = (spec.Windup or CFG.DefaultM1Lead) * timeScale(attacker, style, spec),
		reach = reachOf(attacker, style),
		spec = spec,
		height = spec.Height or m1.Height,
		idx = idx,
		key = attacker.Name .. ":" .. idx,
		learn = true,
	}
end

-- hold = Hold dari Flash (nil kalau datang dari Sound HeavySwing)
local function m2Plan(attacker, hold)
	local style = styleOf(attacker)
	local spec = style and style.M2
	if type(spec) ~= "table" then
		return {
			kind = "M2",
			lead = math.max(hold or CFG.HeavyMin, CFG.HeavyMin),
			reach = numAttr(attacker, "ReachFactor", 1),
		}
	end

	local k = timeScale(attacker, style, spec)
	local windup = (spec.Windup or hold or CFG.HeavyMin) * k
	local lunge = spec.Lunge
	if type(lunge) == "table" and (lunge.Speed or 0) > 0 and not spec.Sweep then
		local lw = (lunge.Time or 0) + (lunge.Settle or 0)
		if lw > windup then
			windup = lw
		end
	end

	local lead = windup
	local followUps = spec.FollowUps
	if type(followUps) == "table" and #followUps > 0 then
		-- cuma hit PERTAMA yang penting: parry dia = attacker stun = sisanya batal
		for _, f in ipairs(followUps) do
			local at = ((type(f) == "table" and f.At) or 0) * k
			if at < lead then
				lead = at
			end
		end
	elseif hold then
		local fromHold = hold - (spec.FlashTail or 0)
		if math.abs(lead - fromHold) > 0.12 then
			lead = fromHold -- spec nggak nyambung sama yang dikirim server -> percaya server
		end
	end

	return {
		kind = "M2",
		lead = lead,
		reach = reachOf(attacker, style),
		spec = spec,
		height = spec.Height,
		multi = type(followUps) == "table" and #followUps > 0,
		key = attacker.Name .. ":M2",
		-- jarak-dependen (sweep/projectile/throw/dash/teleport) nggak ikut dipelajari
		learn = not (spec.Sweep or spec.Projectile or spec.Throw or spec.Dash or spec.Teleport),
	}
end

-- sweep / projectile / throw: hit pertama tergantung jarak
local function refineLead(plan, dist)
	local spec = plan.spec
	if type(spec) ~= "table" then
		return plan.lead
	end
	local lead = plan.lead
	local reachEff = (spec.Range or 6) * plan.reach + SR.RangeTolerance + SR.TargetRadius

	if type(spec.Sweep) == "table" then
		local first = spec.Sweep.Start or 0
		local l = spec.Lunge
		if type(l) == "table" and (l.Speed or 0) > 0 then
			local t = (l.Delay or 0) + math.max(0, dist - reachEff) / l.Speed
			first = math.max(first, t)
		end
		return first
	end
	if type(spec.Projectile) == "table" and (spec.Projectile.Speed or 0) > 0 then
		return lead + math.max(0, dist - (spec.Projectile.Forward or 0)) / spec.Projectile.Speed
	end
	if type(spec.Throw) == "table" and (spec.Throw.OutTime or 0) > 0 then
		local speed = (spec.Throw.Distance or 24) / spec.Throw.OutTime
		local travel = math.max(0, dist - (spec.Throw.Forward or 0)) / math.max(speed, 1)
		return lead + math.min(travel, spec.Throw.OutTime)
	end
	return lead
end

local function extraReach(spec)
	if type(spec) ~= "table" then
		return 0
	end
	local e = 0
	local l = spec.Lunge
	if type(l) == "table" and (l.Speed or 0) > 0 then
		e = math.max(e, (l.Speed or 0) * (l.Time or 0))
	end
	if type(spec.Pull) == "table" then
		e = math.max(e, spec.Pull.Range or 12)
	end
	if type(spec.Teleport) == "table" then
		e = math.max(e, spec.Teleport.Range or 0)
	end
	if type(spec.Dash) == "table" then
		e = math.max(e, spec.Dash.Distance or 0)
	end
	if type(spec.Projectile) == "table" then
		e = math.max(e, spec.Projectile.Distance or 0)
	end
	if type(spec.Throw) == "table" then
		e = math.max(e, spec.Throw.Distance or 0)
	end
	return e
end

-- tiru InReach server: kotak di depan attacker (Range + toleransi, lebar Radius, tinggi Height)
-- boost = margin ekstra (stud) karena ping
local function inVolume(ahrp, pos, plan, boost, apos)
	local spec, reach = plan.spec, plan.reach or 1
	local d = pos - (apos or ahrp.Position)
	local flat = Vector3.new(d.X, 0, d.Z)
	local mag = flat.Magnitude

	if not (CFG.UseVolume and type(spec) == "table" and type(spec.Range) == "number") then
		if mag > CFG.FallbackRange * reach + boost then
			return false
		end
		if mag > 0.5 and CFG.FallbackFacingDot > -1 then
			local look = ahrp.CFrame.LookVector
			local fl = Vector3.new(look.X, 0, look.Z)
			if fl.Magnitude > 0 and fl.Unit:Dot(flat.Unit) < CFG.FallbackFacingDot then
				return false
			end
		end
		return true
	end

	local height = (plan.height or SR.HitHeight) + 2
	if math.abs(d.Y) > height then
		return false
	end
	local range = spec.Range * reach + SR.RangeTolerance + SR.TargetRadius + CFG.RangeMargin + boost + extraReach(spec)
	if spec.MinRange and mag < spec.MinRange * reach - 1 then
		return false
	end
	if spec.Radial then
		return mag <= range
	end
	if mag < 0.5 then
		return true
	end
	local look = ahrp.CFrame.LookVector
	local fl = Vector3.new(look.X, 0, look.Z)
	if fl.Magnitude < 0.01 then
		return mag <= range
	end
	fl = fl.Unit
	local fwd = flat:Dot(fl)
	if fwd < -CFG.BackMargin or fwd > range then
		return false
	end
	local lat = (flat - fl * fwd).Magnitude
	local half = (spec.Radius or 2.5)
		+ SR.TargetRadius
		+ CFG.WidthMargin
		+ boost * 0.5
		+ math.min(math.max(fwd, 0), 8) * CFG.ConeSlack
	return lat <= half
end

local OFFS = { 0, -1, 1, -2, 2 }

-- hasil: ancaman?, jarak datar, pasti? (pasti = masuk volume hitbox; false = cuma "deket banget")
local function threatens(attacker, myHrp, plan, lead)
	local ahrp = attacker:FindFirstChild("HumanoidRootPart")
	if not ahrp then
		return false, 0, false
	end
	local d = myHrp.Position - ahrp.Position
	local dist = Vector3.new(d.X, 0, d.Z).Magnitude
	local boost = math.clamp(net.rtt * CFG.PingMargin, 0, CFG.MaxPingMargin)
	-- v6: lagi lari -> posisi lu di server bisa jauh beda dari yang kerasa di client, range ikut melebar
	local mv = myHrp.AssemblyLinearVelocity
	boost += math.min(math.sqrt(mv.X * mv.X + mv.Z * mv.Z) * CFG.RunMargin, CFG.RunMarginMax)

	if inVolume(ahrp, myHrp.Position, plan, boost) then
		return true, dist, true
	end

	-- v5: attacker juga gerak selama windup (maju / nge-lunge) -> coba posisi dia di masa depan
	local apos = nil
	if CFG.AttackerVelPredict then
		local av = ahrp.AssemblyLinearVelocity
		local t = math.clamp(lead - 0.05, 0, 0.35)
		apos = ahrp.Position + Vector3.new(av.X, 0, av.Z) * t * 0.7
		if inVolume(ahrp, myHrp.Position, plan, boost, apos) then
			return true, dist, true
		end
	end

	-- server ngecek posisi lu yang di-rewind (bisa di masa lalu) + gerak lu selama windup.
	-- Coba beberapa horizon: kena di salah satu = anggap ancaman.
	local h = lead - CFG.AttackerLag - net.rtt
	for _, o in ipairs(OFFS) do
		local hh = math.clamp(h + o * CFG.LagSpread, -0.5, 0.45)
		local p = posAtRel(myHrp, hh)
		if inVolume(ahrp, p, plan, boost) then
			return true, dist, true
		end
		if apos and inVolume(ahrp, p, plan, boost, apos) then
			return true, dist, true
		end
	end

	-- v5: deket banget = tetap dianggap ancaman buat BLOCK/PARRY (attacker bisa muter / maju pas windup)
	if CFG.CloseAlways > 0 and math.abs(d.Y) < 8 and dist <= CFG.CloseAlways * (plan.reach or 1) + boost then
		return true, dist, false
	end
	return false, dist, false
end

----------------------------------------------------------------------
-- ARBITRASE RENCANA (satu parry per jendela cooldown, M2 menang atas M1)
----------------------------------------------------------------------
local function arbitrate(kind, hitAt, now)
	for i = #pending, 1, -1 do
		local p = pending[i]
		if p.done or p.hit < now - 0.2 then
			table.remove(pending, i)
		end
	end
	for i = #pending, 1, -1 do
		local p = pending[i]
		local gap = math.abs(hitAt - p.hit)
		if p.kind == "DODGE" and gap < 0.18 then
			return "dup" -- iframe dodge yang udah dijadwalin nutup hit ini juga
		end
		if gap < CFG.ConflictWindow then
			if kind == "M2" and p.kind == "M1" then
				-- M2 = GuardBroken kalau nggak diparry, M1 cukup ke-Block -> M2 yang diprioritaskan
				cancel(p.handle)
				table.remove(pending, i)
				counters.cancelled += 1
			elseif gap < CFG.DedupeWindow or (kind == "M1" and p.kind == "M2") then
				if gap >= CFG.DedupeWindow then
					-- hit ini tetap perlu dijaga: jangan sampai block keburu dilepas abis parry
					noteExpected(false, hitAt, now, kind)
				end
				return "dup"
			end
		end
	end
	return "ok"
end

----------------------------------------------------------------------
-- DODGE (v4)
-- Server: Dodge = Info "Dodge". Syarat: InCombat, TIDAK lagi Blocking, nggak stun, DodgeReadyAt lewat,
-- nggak Busy. Dapat IFrames (0.26s default) mulai dari saat paket NYAMPE di server. Hit yang mendarat
-- pas IFrames aktif = "Dodged" (nol damage, M2 juga). Cooldown dash 2.25s, Block ON ditolak selama Busy (0.4s).
----------------------------------------------------------------------
local function dashOf()
	local d = { IFrames = SR.Dash.IFrames, Duration = SR.Dash.Duration, Cooldown = SR.Dash.Cooldown }
	local char = LocalPlayer.Character
	local style = char and styleOf(char)
	local o = style and style.Dash
	if type(o) == "table" then
		d.IFrames = type(o.IFrames) == "number" and o.IFrames or d.IFrames
		d.Duration = type(o.Duration) == "number" and o.Duration or d.Duration
		d.Cooldown = type(o.Cooldown) == "number" and o.Cooldown or d.Cooldown
	end
	return d
end

local function dodgeLocal()
	if not CFG.DodgeViaGame then
		return nil
	end
	local h = getHandler()
	local L = h and h.Local
	if h and type(L) == "table" and type(h.TryDodge) == "function" then
		return h, L
	end
	return nil
end

local DODGE_KEYS = { "DodgeReadyAt", "BusyUntil", "StunnedUntil" } -- v6: nggak alokasi tabel tiap panggil

-- berapa detik lagi dodge baru bisa dikirim (0 = siap). forPlan = ikut hitung dodge yang udah dijadwalin
local function dodgeWait(now, forPlan)
	local w = math.max(dodgeReadyAt - now, dodgeBusyUntil - now, stunUntil - now, 0)
	if forPlan then
		w = math.max(w, dodgePlannedUntil - now)
	end
	local h, L = dodgeLocal()
	if L then
		local ok, res = pcall(function()
			local sn = workspace:GetServerTimeNow()
			local m = 0
			for _, k in ipairs(DODGE_KEYS) do
				local v = L[k]
				if type(v) == "number" and v > sn then
					m = math.max(m, v - sn)
				end
			end
			return m
		end)
		if ok and type(res) == "number" and res < 4 then
			w = math.max(w, res)
		end
	end
	return w
end

local function fireDodge()
	local now = os.clock()
	local char = LocalPlayer.Character
	if not char then
		return false
	end
	if dodgeWait(now) > 0.02 then
		trace("dodge gagal: belum siap (cooldown/busy/stun)")
		return false
	end
	if not blockHeld and char:GetAttribute("Blocking") == true and (now - lastOwnOff) > net.rtt + 0.2 then
		trace("dodge gagal: lu lagi nahan block manual")
		return false
	end
	local d = dashOf()

	-- server nolak Dodge kalau masih Blocking -> lepas block kita dulu (OFF sampai duluan, urutan remote terjaga)
	if blockHeld then
		cancel(releaseHandle)
		sendBlock(false)
		blockHeld = false
		readyAt = now + SR.BlockCooldown
		counters.released += 1
		trace("block dilepas buat dodge")
	end

	local fired = false
	local h, L = dodgeLocal()
	if h then
		-- pakai fungsi dodge asli game: animasi + dorongan + state lokal ikut bener
		local before = L.DodgeReadyAt
		local ok, err = pcall(h.TryDodge, h)
		if not ok then
			trace("TryDodge error:", tostring(err))
		elseif L.DodgeReadyAt ~= before then
			fired = true
		end
	else
		Combat:FireServer({ Info = "Dodge", Direction = CFG.DodgeDirection, T = workspace:GetServerTimeNow() })
		fired = true
	end

	if not fired then
		trace("dodge ditolak game lokal")
		return false
	end
	dodgeSentAt = now
	dodgeReadyAt = now + d.Cooldown - 0.05
	dodgeBusyUntil = now + d.Duration
	lockedUntil = math.max(lockedUntil, now + d.Duration) -- Block ON ditolak server selama Busy
	counters.dodgesent += 1
	trace((h and "DODGE dikirim (game TryDodge)" or "DODGE dikirim (remote langsung)"))
	return true
end

-- v5: hitung kemungkinan dodge tanpa jadwalin apa-apa. hasil: ok, sendIn, age, wait, dashInfo
local function dodgeProbe(lead, now, rtt, fl)
	local d = dashOf()
	local target = math.clamp(d.IFrames * CFG.DodgeAgeFrac, 0.04, math.max(d.IFrames - 0.06, 0.05))
	local wait = dodgeWait(now, true)
	local sendIn = lead - target - rtt - fl + (math.random() * 2 - 1) * CFG.Jitter
	if sendIn < wait then
		sendIn = wait
	end
	if sendIn < 0 then
		sendIn = 0
	end
	local age = lead - rtt - fl - sendIn -- berapa lama IFrames udah jalan pas hit mendarat
	local ok = age >= CFG.DodgeMinAge and age <= d.IFrames - CFG.DodgeEdge
	return ok, sendIn, age, wait, d
end

-- jadwalin dodge supaya hit mendarat di tengah IFrames. true = urusan hit ini udah ditangani
local function planDodge(attacker, plan, lead, now, rtt, fl, tag, why)
	if not (alive and CFG.DodgeEnabled) then
		return false
	end
	if plan.kind == "M2" and not CFG.DodgeForM2 then
		return false
	end
	if plan.kind == "M1" and not CFG.DodgeForM1 then
		return false
	end
	-- v5: dodge itu jatah langka (cd 2.25s) -> cuma dipakai buat ancaman yang pasti masuk hitbox
	if CFG.SmartMode and not reactSure then
		skip("dodge-unsure")
		return false
	end
	local ok, sendIn, age, wait, d = dodgeProbe(lead, now, rtt, fl)
	if not ok then
		if CFG.Trace then trace(
			("%s: dodge nggak mungkin (%s) age %.3f iframe %.2f tunggu %.2fs"):format(
				tag, tostring(why), age, d.IFrames, wait
			)
		) end
		skip(age < CFG.DodgeMinAge and "dodge-late" or "dodge-early")
		return false
	end

	local hitAt = now + lead
	local verdict = arbitrate(plan.kind, hitAt, now)
	if verdict ~= "ok" then
		skip(verdict)
		return true -- hit ini udah ditutup rencana lain
	end

	local tok = (planToken[attacker] or 0) + 1
	planToken[attacker] = tok
	counters.dodgeplanned += 1
	if CFG.LogEvents then
		pushEv("plan", ("%s %s -> dodge lead %.2f kirim +%.2f"):format(tag, nameOf(attacker), lead, sendIn))
	end
	dodgePlannedUntil = now + sendIn + d.Cooldown - 0.05
	dodgeBlockUntil = math.max(dodgeBlockUntil, now + sendIn + d.Duration)
	noteExpected(attacker, hitAt, now, "DODGE")
	guardSwing(attacker, now + sendIn, hitAt)
	if CFG.Trace then trace(
		("%s dari %s: DODGE (%s) lead %.3f rtt %.3f -> kirim %.3fs lagi (umur iframe %.3f)"):format(
			tag, attacker.Name, tostring(why), lead, rtt, sendIn, age
		)
	) end
	local rec = { kind = "DODGE", hit = hitAt, done = false }
	pending[#pending + 1] = rec
	rec.handle = schedule(now + sendIn, function()
		rec.done = true
		if not alive or not CFG.Enabled then
			return
		end
		if planToken[attacker] ~= tok then
			counters.cancelled += 1
			dodgePlannedUntil = 0
			dodgeBlockUntil = 0
			return
		end
		-- v9: attacker udah mati / knocked -> jatah dodge (cd 2.25s) jangan dibuang
		if CFG.RecheckAttacker and attackerGone(attacker) then
			counters.cancelled += 1
			counters.recheck += 1
			dodgePlannedUntil = 0
			dodgeBlockUntil = 0
			skip("attacker-gone")
			return
		end
		-- v5: cek ulang sebelum buang jatah dodge: attacker masih ngincer lu?
		if CFG.SmartMode then
			local c2, h2 = myState()
			if c2 and h2 and not threatens(attacker, h2, plan, math.max(hitAt - os.clock(), 0)) then
				counters.cancelled += 1
				dodgePlannedUntil = 0
				dodgeBlockUntil = 0
				skip("dodge-recheck")
				return
			end
		end
		if not fireDodge() then
			dodgePlannedUntil = 0
			dodgeBlockUntil = 0
		end
	end)
	return true
end

