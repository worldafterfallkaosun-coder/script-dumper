        end)
    end, { Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = CAN_WRITE and T.accent or T.off, TextColor3 = T.bg, Font = Enum.Font.GothamBold }))

    -------------------------------------------------- Live
    local lv = new("Frame", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Visible = false }, content)
    local ctl = new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1 }, lv)
    new("UIListLayout", { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder }, ctl)
    new("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), PaddingTop = UDim.new(0, 8) }, ctl)
