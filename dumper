-- v6: antrean dicek 2x per frame (PreRender + Heartbeat) -> kuantisasi timing separuh
local function pumpQueue(now)
	if #queue == 0 then
		return
	end
	local early = frame.avg * CFG.FireEarly
	local i = 1
	while i <= #queue do
		local q = queue[i]
		if q.dead or q.ran then
			table.remove(queue, i)
		elseif q.at - early <= now then
			table.remove(queue, i)
			runHandle(q)
		else
			i += 1
		end
	end
end

table.insert(
	connections,
	RunService.Heartbeat:Connect(function(dt)
		local t0 = os.clock()
		local now = t0
		-- bagian ini nggak boleh sampai ngebunuh pemrosesan antrean
		local okFrame, errFrame = pcall(frameTick, dt, now)
		if not okFrame and not frameErrShown then
			frameErrShown = true
			print("[AutoParry] error frame:", errFrame)
		end

		pumpQueue(now)

		-- watchdog: block nyangkut nyala kelamaan -> paksa lepas biar nggak macet selamanya
		if blockHeld and now > releaseAt + 0.6 then
			trace("watchdog: block nyangkut, dilepas paksa")
			pcall(sendBlock, false)
			blockHeld = false
			readyAt = now + SR.BlockCooldown
		end

		cpuAcc += os.clock() - t0
		frame.cpu += (cpuAcc - frame.cpu) * 0.1
		if cpuAcc > frame.cpuMax then
			frame.cpuMax = cpuAcc
		end
		cpuAcc = 0
	end)
)

