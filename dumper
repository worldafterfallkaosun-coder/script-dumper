function Store.touch()
	if CFG.SaveConfig then
		Store.dirtyAt = os.clock()
	end
end

function Store.save()
	Store.dirtyAt = nil
	if type(writefile) ~= "function" then
		return false
	end
	local data = {}
	for _, k in ipairs(SAVE_KEYS) do
		local v = CFG[k]
		if typeof(v) == "EnumItem" then
			data[k] = v.Name
		elseif k == "PingOverride" then
			data[k] = v or 0
		elseif v ~= nil then
			data[k] = v
		end
	end
	local okJ, raw = pcall(HttpService.JSONEncode, HttpService, data)
	if not okJ then
		return false
	end
	return (pcall(writefile, CFG.ConfigFile, raw))
end

function Store.load()
	if type(isfile) ~= "function" or type(readfile) ~= "function" then
		return false
	end
	local okE, exists = pcall(isfile, CFG.ConfigFile)
	if not okE or not exists then
		return false
	end
	local okR, raw = pcall(readfile, CFG.ConfigFile)
	if not okR or type(raw) ~= "string" then
		return false
	end
	local okD, data = pcall(HttpService.JSONDecode, HttpService, raw)
	if not okD or type(data) ~= "table" then
		return false
	end
	for k, v in pairs(data) do
		if SAVE_SET[k] then
			local cur = CFG[k]
			if k == "PingOverride" then
				CFG.PingOverride = (type(v) == "number" and v > 0 and v < 2) and v or nil
			elseif typeof(cur) == "EnumItem" then
				if type(v) == "string" then
					local okK, kc = pcall(function()
						return Enum.KeyCode[v]
					end)
					if okK and kc then
						CFG[k] = kc
					end
				end
			elseif type(v) == type(cur) then
				if type(v) ~= "number" or (v == v and math.abs(v) < 1e6) then
					CFG[k] = v
				end
			end
		end
	end
	return true
end

function Store.reset()
	for k, v in pairs(Store.defaults) do
		CFG[k] = v
	end
	CFG.PingOverride = nil
	Store.touch()
end

function Store.apply(name)
	for _, p in ipairs(Store.presets) do
		if p.name == name then
			for k, v in pairs(p.set) do
				CFG[k] = v
			end
			Store.active = name
			Store.touch()
			return true
		end
	end
	return false
end

function Store.activePreset()
	for _, p in ipairs(Store.presets) do
		local same = true
		for k, v in pairs(p.set) do
			if type(CFG[k]) ~= "number" or math.abs(CFG[k] - v) > 1e-6 then
				same = false
				break
			end
		end
		if same then
			return p.name
		end
	end
	return "Kustom"
end

