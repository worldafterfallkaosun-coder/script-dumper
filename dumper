-- REACT
----------------------------------------------------------------------
local function corrFor(attacker, plan)
	if plan.nocorr then
		return 0 -- v10: plan skill nggak ikut koreksi lead M1
	end
	if plan.key then
		local c = leadCorr[plan.key]
		if c then
			return c
		end
	end
	if plan.kind == "M1" then
		return leadAll[attacker.Name] or 0
	end
	return 0
end

-- block yang udah nyala dipertahanin sampai hit ini ketutup (block biasa / chain guard)
local function guardExtend(attacker, plan, tag, lead, now, rtt, fl, ha, note)
	local verdict = arbitrate(plan.kind, now + lead, now)
	if verdict ~= "ok" then
		return skip(verdict)
	end
	pending[#pending + 1] = { kind = plan.kind, hit = now + lead, done = false }
	noteExpected(attacker, now + lead, now, plan.kind)
	guardSwing(attacker, now, now + lead + CFG.ResultPad)
	local coverTo = math.max(now + lead - rtt - fl + ha, now + lead + CFG.ResultPad)
	if extendHoldTo(coverTo) then
		counters.chained += 1
		if CFG.Trace then trace(("%s dari %s: block ditahan terus (%s), cover sampai +%.3fs"):format(tag, attacker.Name, note, coverTo - now)) end
	else
		if CFG.Trace then trace(("%s dari %s: block udah lepas, nggak bisa ditahan lagi (%s)"):format(tag, attacker.Name, note)) end
	end
end

-- v7: rencana yang diprediksi (swing berikutnya belum kelihatan) dicek ulang sebelum block dikirim
local function predictedStillValid(attacker, plan, hitAt)
	if not attacker.Parent then
		return false
	end
	local ahum = attacker:FindFirstChildOfClass("Humanoid")
	if ahum and ahum.Health <= 0 then
		return false
	end
	local c, h = myState()
	if not (c and h) then
		return false
	end
	local ok, dist = threatens(attacker, h, plan, math.max(hitAt - os.clock(), 0))
	if ok then
		return true
	end
	-- v8: rencana dari reflex combo: attacker masih di sekitar lu dan combo-nya masih jalan -> tetap kirim
	if plan.reflex and CFG.ComboKeep then
		local cv = comboVictim[attacker]
		if cv and os.clock() - cv.at < CFG.ComboKeepTime + 0.5 and dist <= CFG.ComboKeepRange then
			return true
		end
	end
	return false
end

-- v7: Block ON gagal gara-gara kekunci (stun abis kena hit / busy / cooldown) tapi masih sempat nyampe
-- sebelum hit mendarat -> coba lagi begitu kunci kebuka
local function retryAfterUnlock(attacker, tok, hitAt, rtt, fl, ha, mode)
	if not CFG.RetryAfterUnlock or blockHeld then
		return
	end
	local t = os.clock()
	local gl = gameLock()
	local unlock = math.max(readyAt - 0.005, lockedUntil, dodgeBlockUntil, gl and (gl - 0.01) or -math.huge)
	if unlock <= t or unlock + 0.012 > hitAt - rtt - fl + CFG.LateTolerance then
		return
	end
	counters.retried += 1
	schedule(unlock + 0.012 + frame.avg * CFG.FireEarly, function()
		if not alive or not CFG.Enabled or blockHeld or planToken[attacker] ~= tok then
			return
		end
		if pressBlock(math.max(hitAt - os.clock(), 0) + CFG.ResultPad + ha) then
			pressMode = mode
			blockFor = attacker
		end
	end)
end

-- Block ON baru dijadwalin. mode "parry" = ngincer window parry, "plain" = cukup block nyala pas hit
local function scheduleBlock(attacker, plan, tag, lead, sendIn, age, ha, rtt, fl, now, mode, bound)
	local hitAt = now + lead
	local verdict = arbitrate(plan.kind, hitAt, now)
	if verdict ~= "ok" then
		return skip(verdict)
	end

	local tok = (planToken[attacker] or 0) + 1
	planToken[attacker] = tok
	local resultAt = hitAt + CFG.ResultPad
	local hold = math.max(age, 0) + ha
	-- v4: hold minimal sampai event hasil hit nyampe, biar Blocked bisa disambung chain guard
	-- (kalau hasilnya Parried, block langsung dilepas lagi di onHit)
	if now + sendIn + hold < resultAt then
		hold = resultAt - (now + sendIn)
	end
	local coverTo = math.max(now + lead - rtt - fl + ha, resultAt) -- block harus tetap nyala sampai jam ini biar hit ini ketutup
	counters.planned += 1
	if CFG.LogEvents then
		pushEv("plan", ("%s %s -> %s lead %.2f kirim +%.2f"):format(tag, nameOf(attacker), mode, lead, sendIn))
	end
	noteExpected(attacker, hitAt, now, plan.kind)
	if CFG.DebugPlan then
		if CFG.Debug then log(
			("%s plan[%s]: lead %.3f rtt %.3f±%.3f fps %.0f sendIn %.3f age %.3f hold %.3f tune %+.3f"):format(
				tag, mode, lead, rtt, net.var, frame.fps, sendIn, age, hold, tune[plan.kind]
			)
		) end
	end

	if CFG.Trace then trace(
		("%s dari %s [%s]: lead %.3f rtt %.3f fps %.0f -> kirim %.3fs lagi (umur block %.3f)"):format(
			tag, attacker.Name, mode, lead, rtt, frame.fps, sendIn, age
		)
	) end
	local rec = { kind = plan.kind, hit = hitAt, done = false }
	pending[#pending + 1] = rec
	guardSwing(attacker, now + sendIn, hitAt)
	-- v6: kalau waktunya ditentuin kunci (cooldown block / busy / stun), jangan kirim lebih awal dari kunci kebuka.
	-- Dulu FireEarly bikin paket keluar setengah frame sebelum kunci kebuka -> ditolak pengecekan sendiri -> hit lolos.
	rec.handle = schedule(now + sendIn + (bound and frame.avg * CFG.FireEarly or 0), function()
		rec.done = true
		if not alive or not CFG.Enabled then
			return
		end
		if planToken[attacker] ~= tok then
			counters.cancelled += 1
			return
		end
		if CFG.RecheckAttacker and attackerGone(attacker) then
			counters.cancelled += 1
			counters.recheck += 1
			skip("attacker-gone")
			return
		end
		if plan.predicted and not predictedStillValid(attacker, plan, hitAt) then
			counters.cancelled += 1
			skip("predict-recheck")
			return
		end
		if pressBlock(hold) then
			pressMode = mode
			blockFor = attacker
		elseif plan.kind == "M1" and CFG.ChainGuard and extendHoldTo(coverTo) then
			-- block udah nyala (rencana sebelumnya / chain): M1 cukup ditutup pakai perpanjangan hold
			counters.chained += 1
		else
			retryAfterUnlock(attacker, tok, hitAt, rtt, fl, ha, mode)
		end
	end)
end

-- terlalu mepet / kekunci: jalur lama v3.1 (LateMode)
local function lateFallback(plan, tag, lead, rtt, fl, bound, wait)
	if bound then
		counters.locked += 1
		skip("locked")
		if CFG.Debug then log(("%s kekunci cooldown block (sisa %.2fs, lead %.3f)"):format(tag, wait, lead)) end
	else
		counters.late += 1
		skip("late")
		if CFG.Debug then log(("%s terlalu cepat buat di-react (lead %.3f <= rtt %.3f + frame %.3f)"):format(tag, lead, rtt, fl)) end
	end
	local mode = plan.kind == "M2" and CFG.LateModeM2 or CFG.LateModeM1
	if mode == "block" then
		if pressBlock(CFG.LateHold) then
			pressMode = "plain"
		elseif plan.kind == "M1" and CFG.ChainGuard then
			extendHoldTo(os.clock() + CFG.LateHold)
		end
	end
end

-- v10: sama persis kayak CombatHandler.FromBehind (server): penyerang di belakang lu = block lu dipecahin + damage penuh
local SK = { barr = setmetatable({}, weak), seen = {} } -- v10: satu tabel buat semua helper skill (hemat jatah local Luau)
function SK.behind(attacker, hrp, angleDeg)
	local ahrp = attacker:FindFirstChild("HumanoidRootPart")
	if not ahrp then
		return false
	end
	local d = (ahrp.Position - hrp.Position) * Vector3.new(1, 0, 1)
	local lk = hrp.CFrame.LookVector * Vector3.new(1, 0, 1)
	if d.Magnitude < 0.001 or lk.Magnitude < 0.001 then
		return false
	end
	return d.Unit:Dot(lk.Unit) < math.cos(math.rad(angleDeg or 100))
end

--[[
	Keputusan per hit (v4):
	  M1: parry (block baru / block lama yang masih di window)
		  -> kalau parry nggak mungkin (parry cd, unparryable, block lama): BLOCK BIASA, ditahan nyambung
		  -> kalau block juga nggak sempat / kekunci: DODGE
	  M2: parry
		  -> kalau parry nggak mungkin (parry cd, unparryable, block lama, kekunci, kecepetan): DODGE
		  -> (opsional) kalau parry M2 dari attacker itu sebelumnya miss: dodge DULUAN
]]
local function react(attacker, plan, tag)
	if not alive or not CFG.Enabled or typeof(attacker) ~= "Instance" then
		return
	end
	local char, hrp = myState()
	if not char or attacker == char then
		return
	end
	local why = cannotAct(char, attacker)
	if why then
		return skip(why)
	end
	local ahum = attacker:FindFirstChildOfClass("Humanoid")
	if ahum and ahum.Health <= 0 then
		return
	end

	local now = os.clock()
	sampleNet(now)
	syncBlock(now, char)
	local rtt = net.rtt
	local fl = frameLag()
	local sigma = sigmaNow()
	local corr = corrFor(attacker, plan)
	local unparry = (plan.spec and plan.spec.Unparryable) and true or false

	-- v7: plan prediksi leadnya jauh (~0.9s) -> cek ancaman pakai horizon pendek, posisi 0.9s ke depan nggak bisa ditebak
	local isThreat, dist, sure =
		threatens(attacker, hrp, plan, plan.predicted and math.min(plan.lead + corr, 0.35) or (plan.lead + corr))
	-- v8: attacker ini lagi nge-combo lu (hit/block barusan) -> tetap ancaman walau cek hitbox meleset (knockback, ping, lunge)
	if (not isThreat or not sure) and plan.kind == "M1" and CFG.ComboKeep then
		local cv = comboVictim[attacker]
		if cv and now - cv.at < CFG.ComboKeepTime and attacker:FindFirstChild("HumanoidRootPart") and dist <= CFG.ComboKeepRange * (plan.reach or 1) then
			isThreat, sure = true, true
		end
	end
	if not isThreat then
		return skip("range")
	end
	reactSure = sure
	if plan.predicted and not sure then
		return skip("predict-unsure") -- cuma nebak kalau attacker beneran ngincer lu
	end

	local lead
	if plan.kind == "M1" then
		lead = plan.lead + corr
	else
		lead = refineLead(plan, dist) + corr
	end

	-- hit bakal mendarat pas lu masih iframe (abis dash) -> nggak perlu
	local iu = char:GetAttribute("IFramesUntil")
	if type(iu) == "number" and iu > workspace:GetServerTimeNow() + lead then
		return skip("iframes")
	end

	-- v10: server ngubah block jadi Hit kalau penyerang ada di belakang lu (BackHit) -> parry/block percuma, tinggal dodge
	if CFG.BackHitGuard and SR.BackHit.Enabled and SK.behind(attacker, hrp, SR.BackHit.Angle) then
		counters.behind += 1
		if CFG.DodgeEnabled and planDodge(attacker, plan, lead, now, rtt, fl, tag, "dari belakang") then
			return
		end
		return skip("behind")
	end

	local isM2 = plan.kind == "M2"
	local ha = holdAfter()

	-- parry masih cooldown pas hit mendarat?
	local parryCd = now + lead < parriedAt + SR.ParryCooldown - 0.02
	local reason = unparry and "unparryable" or (parryCd and "parrycd" or nil)

	-- kapan paling cepat Block ON bisa diterima server
	local earliest = math.max(readyAt, lockedUntil, dodgeBlockUntil, gameLock() or -math.huge)
	local wait = earliest - now
	local function calc(targetAge, tn)
		local s = lead - targetAge - rtt - fl + tn + (math.random() * 2 - 1) * CFG.Jitter
		local b = false
		if s < wait then
			s = wait
			b = true
		end
		if s < 0 then
			s = 0
		end
		return s, lead - rtt - fl - s, b
	end

	-- bisa diparry?
	local canParry, mode = false, nil
	local sendIn, age, bound = 0, 0, false
	local parryConf = 0 -- v5: peluang parry berhasil (0..1)
	if not reason then
		if blockHeld then
			-- block yang lagi nyala cuma bisa nge-parry kalau umurnya pas hit masih di dalam window
			local heldAge = (now - blockOnAt) + lead - rtt - fl
			if heldAge >= 0 and heldAge <= SR.ParryWindow - 0.04 then
				canParry, mode = true, "held"
				parryConf = confWindow(heldAge, SR.ParryWindow, sigma)
			else
				reason = "heldold"
			end
		else
			sendIn, age, bound = calc(targetAgeFor(isM2), tune[plan.kind])
			if age >= -CFG.LateTolerance then
				canParry, mode = true, "fresh"
				parryConf = confWindow(age, SR.ParryWindow, sigma)
			else
				reason = bound and "locked" or "late"
			end
		end
	end

	------------------------------------------------------------------
	-- M2 (BreaksBlock): cuma parry yang nyelametin, block biasa = GuardBroken -> sisanya DODGE
	------------------------------------------------------------------
	if isM2 then
		local dodgeFirst = CFG.DodgeFirstM2
			or (CFG.DodgeAfterMiss and (m2Miss[attacker] or 0) > 0 and now - (m2MissAt[attacker] or -math.huge) < CFG.M2MissMemory)
		local dodgeWhy = "M2 dodge duluan"
		-- v5: bandingin peluang sukses parry vs dodge, ambil yang lebih tinggi
		if not dodgeFirst and canParry and CFG.SmartMode and CFG.DodgeEnabled and CFG.DodgeForM2 and sure then
			local dOK, _, dAge, _, dd = dodgeProbe(lead, now, rtt, fl)
			if dOK then
				local dc = confWindow(dAge, dd.IFrames, sigma)
				-- M2 multi-hit: parry nge-stun attacker (sisa hit batal), dodge cuma nutup hit pertama -> syarat lebih ketat
				local gap = plan.multi and CFG.DodgeSwitchGap * 2 or CFG.DodgeSwitchGap
				if dc >= CFG.DodgeMinConf and dc - parryConf > gap then
					dodgeFirst = true
					dodgeWhy = ("peluang dodge %.0f%% > parry %.0f%%"):format(dc * 100, parryConf * 100)
				end
			end
		end
		if dodgeFirst and planDodge(attacker, plan, lead, now, rtt, fl, tag, dodgeWhy) then
			return
		end
		if not canParry then
			if planDodge(attacker, plan, lead, now, rtt, fl, tag, reason) then
				return
			end
			-- dodge juga nggak bisa: seenggaknya jangan sampai GuardBroken (lepas block sebelum M2 mendarat)
			if blockHeld and CFG.ReleaseBeforeHeavy then
				releaseBefore(now + lead - rtt - fl - 0.03)
			end
			if reason == "late" or reason == "locked" then
				return lateFallback(plan, tag, lead, rtt, fl, bound, wait)
			end
			return skip(reason == "heldold" and "heldold" or reason)
		end
		if mode == "held" then
			return guardExtend(attacker, plan, tag, lead, now, rtt, fl, ha, "masih di window parry")
		end
		return scheduleBlock(attacker, plan, tag, lead, sendIn, age, ha, rtt, fl, now, "parry", bound)
	end

	------------------------------------------------------------------
	-- M1: parry kalau bisa, kalau nggak BLOCK BIASA (ditahan), kalau block juga nggak bisa DODGE
	------------------------------------------------------------------
	if canParry then
		if mode == "held" then
			return guardExtend(attacker, plan, tag, lead, now, rtt, fl, ha, "masih di window parry")
		end
		return scheduleBlock(attacker, plan, tag, lead, sendIn, age, ha, rtt, fl, now, "parry", bound)
	end

	if blockHeld and CFG.ChainGuard then
		return guardExtend(attacker, plan, tag, lead, now, rtt, fl, ha, "block biasa (" .. tostring(reason) .. ")")
	end

	if CFG.BlockFallback and not blockHeld then
		local s2, a2, b2 = calc(CFG.BlockOnlyAge, 0)
		if a2 >= -CFG.LateTolerance then
			if CFG.Trace then trace(("%s dari %s: parry nggak mungkin (%s) -> block biasa"):format(tag, attacker.Name, tostring(reason))) end
			return scheduleBlock(attacker, plan, tag, lead, s2, a2, ha, rtt, fl, now, "plain", b2)
		end
		bound = b2
	end

	if planDodge(attacker, plan, lead, now, rtt, fl, tag, "block nggak sempat") then
		return
	end
	return lateFallback(plan, tag, lead, rtt, fl, bound, wait)
end

----------------------------------------------------------------------
-- COMBAT EVENTS
----------------------------------------------------------------------
-- v7: tebak swing M1 berikutnya dalam combo. Server: swing ke-(i+1) mulai (Windup_i + Endlag_i) setelah swing ke-i
-- (HoldToSwing = persis pas busy abis), hit-nya Windup_(i+1) setelahnya. Jadi hit berikutnya = sekarang +
-- (W_i + E_i) * k + W_(i+1) * k, dihitung dari Sound swing sekarang -> block bisa dikirim jauh sebelum Sound berikutnya
-- nyampe (yang lead-nya sering < ping). Dicek ulang pas mau dikirim; kalau swing aslinya nongol, di-dedupe.
local function predictFollowUp(attacker, plan, now)
	if not (alive and CFG.Enabled and CFG.PredictCombo and CFG.BlockFallback) then
		return
	end
	local spec, idx = plan.spec, plan.idx
	if type(spec) ~= "table" or type(idx) ~= "number" then
		return
	end
	local style = styleOf(attacker)
	local swings = style and style.M1 and style.M1.Swings
	if type(swings) ~= "table" or idx >= #swings then
		return -- swing terakhir: abis ini ada ChainCooldown, nggak ditebak
	end
	local nxt = swings[idx + 1]
	if type(nxt) ~= "table" then
		return
	end
	local char, hrp = myState()
	local ahrp = attacker:FindFirstChild("HumanoidRootPart")
	if not (char and hrp and ahrp) or (ahrp.Position - hrp.Position).Magnitude > CFG.PredictMaxDist then
		return
	end
	local k1 = timeScale(attacker, style, spec)
	local k2 = timeScale(attacker, style, nxt)
	local key = attacker.Name .. ":" .. (idx + 1)
	local w2 = (nxt.Windup or CFG.DefaultM1Lead) * k2 + (leadCorr[key] or 0)
	-- swing berikutnya masih cukup lead buat di-react biasa -> nggak usah nebak
	if w2 - net.rtt - frameLag() >= CFG.PredictBelow then
		return
	end
	local lead2 = ((spec.Windup or CFG.DefaultM1Lead) + (spec.Endlag or 0.45)) * k1 + (nxt.Windup or CFG.DefaultM1Lead) * k2
	counters.predicted += 1
	react(attacker, {
		kind = "M1",
		lead = lead2,
		reach = reachOf(attacker, style),
		spec = nxt,
		height = nxt.Height or style.M1.Height,
		idx = idx + 1,
		key = key,
		learn = false,
		predicted = true,
	}, "M1*")
end

-- v8: M1 dari attacker barusan nyampe ke lu (kena / ke-block) -> hit combo berikutnya mendarat Endlag_i*k + Windup_(i+1)*k setelah
-- hit itu (swing berikutnya mulai pas busy abis, sama kayak predictFollowUp). Bedanya: dihitung dari event HIT yang beneran nyampe
-- dan dijalanin SETELAH stun/lock ke-update, jadi react nunda Block ON sampai kunci kebuka lalu kirim tepat waktu (parry kalau
-- umur block masuk window, kalau nggak block biasa, kalau block nggak sempat dodge). Gating dilonggarin lewat comboVictim.
local function hitReflex(attacker, now)
	if not (alive and CFG.Enabled and CFG.HitReflex and CFG.BlockFallback) then
		return
	end
	local style = styleOf(attacker)
	local swings = style and style.M1 and style.M1.Swings
	local st = combo[attacker]
	if type(swings) ~= "table" or not st or type(st.idx) ~= "number" then
		return
	end
	local idx = st.idx
	local spec, nxt = swings[idx], swings[idx + 1]
	if type(spec) ~= "table" or type(nxt) ~= "table" then
		return -- swing terakhir: abis ini ada ChainCooldown
	end
	local ahrp = attacker:FindFirstChild("HumanoidRootPart")
	local _, hrp = myState()
	if not (ahrp and hrp) or (ahrp.Position - hrp.Position).Magnitude > CFG.ComboKeepRange then
		return
	end
	local k1 = timeScale(attacker, style, spec)
	local k2 = timeScale(attacker, style, nxt)
	counters.reflex += 1
	react(attacker, {
		kind = "M1",
		lead = (spec.Endlag or 0.45) * k1 + (nxt.Windup or CFG.DefaultM1Lead) * k2,
		reach = reachOf(attacker, style),
		spec = nxt,
		height = nxt.Height or style.M1.Height,
		idx = idx + 1,
		key = attacker.Name .. ":" .. (idx + 1),
		learn = false,
		predicted = true,
		reflex = true,
	}, "M1r")
end

-- v10: skill multi-hit (barrage). Skill nggak ngirim Sound/Flash swing yang bisa dibaca, jadi dipandu dari event Hit:
-- hit ke-n nyampe -> hit ke-(n+1) mendarat Interval setelahnya (lead dihitung dari kedatangan event, sama kayak hitReflex).
-- SK.barr[attacker] = { n = hit ke-n barrage ini, at = hit terakhir yang nyampe, spec }; SK.seen = Kind hit yang udah dicatat

function SK.norm(s)
	if type(s) ~= "string" then
		return nil
	end
	return (s:lower():gsub("[%s_]+", ""))
end

function SK.spec(attacker, gap)
	local mine = SK.norm(attacker:GetAttribute("Style"))
	local best, bestE = nil, math.huge
	for _, b in ipairs(Specs.barrages) do
		local bs = SK.norm(b.style)
		if bs == nil or bs == mine then
			local e = gap and math.abs(b.interval - gap) or (bs == mine and 0 or 0.5)
			if e < bestE then
				best, bestE = b, e
			end
		end
	end
	if best then
		return best
	end
	return { name = "?", hits = CFG.BarrageDefaultHits, interval = CFG.BarrageDefaultInterval, breaks = false }
end

function SK.reflex(attacker, now, res)
	if not (alive and CFG.Enabled and CFG.BarrageGuard and CFG.BlockFallback) then
		return
	end
	local b0 = SK.barr[attacker]
	local n, spec
	if b0 and (now - b0.at) <= b0.spec.interval * CFG.BarrageWindow then
		n = b0.n + 1
		spec = (n == 2) and SK.spec(attacker, now - b0.at) or b0.spec
	else
		n, spec = 1, SK.spec(attacker, nil)
	end
	SK.barr[attacker] = { n = n, at = now, spec = spec }

	-- attacker yang lagi nge-barrage lu tetap ancaman walau cek hitbox meleset (sama kayak combo M1)
	local cv = comboVictim[attacker]
	if cv and now - cv.at < CFG.ComboKeepTime then
		cv.n += 1
	else
		cv = { n = 1 }
		comboVictim[attacker] = cv
	end
	cv.at = now

	if n >= spec.hits then
		return -- hit terakhir
	end
	local ahrp = attacker:FindFirstChild("HumanoidRootPart")
	local _, hrp = myState()
	if not (ahrp and hrp) or (ahrp.Position - hrp.Position).Magnitude > CFG.ComboKeepRange * 1.5 then
		return
	end
	counters.barrage += 1
	react(attacker, {
		kind = spec.breaks and "M2" or "M1",
		lead = spec.interval,
		reach = numAttr(attacker, "ReachFactor", 1),
		key = "SK:" .. attacker.Name,
		learn = false,
		predicted = true,
		reflex = true,
		nocorr = true,
		skill = true,
	}, "SK")
end

-- v8: belajar seberapa awal block boleh dikirim pas stun lepas. accepted = block yang dikirim pas unlock diterima server.
local function stunLearn(accepted)
	if not CFG.FastUnlock or os.clock() - stunProbeAt > 1.0 then
		return
	end
	stunProbeAt = -math.huge
	if accepted then
		stunSlack = math.max(CFG.StunSlackMin, stunSlack - 0.06)
	else
		stunSlack = math.min(CFG.StunSlackMax, stunSlack + 0.12)
	end
end

local function resyncCombo(attacker, obs)
	local style = styleOf(attacker)
	local m1 = style and style.M1
	local swings = type(m1) == "table" and m1.Swings
	local st = combo[attacker]
	if type(swings) ~= "table" or not st then
		return
	end
	local bestI, bestE = nil, 0.04
	for i, sp in ipairs(swings) do
		if type(sp) == "table" then
			local e = math.abs((sp.Windup or 0) * timeScale(attacker, style, sp) - obs)
			if e < bestE then
				bestI, bestE = i, e
			end
		end
	end
	if bestI then
		st.idx = bestI
	end
end

local function tuneBy(kind, dir)
	if not CFG.Adaptive then
		return
	end
	local s = streak[kind]
	if s.dir == dir then
		s.n += 1
	else
		s.dir = dir
		s.n = 1
	end
	local step = CFG.TuneStep * math.min(1 + (s.n - 1) * 0.5, 3)
	tune[kind] = math.clamp(tune[kind] + dir * step, -CFG.TuneMax, CFG.TuneMax)
end

-- belajar selisih Sound -> Hit per swing (kedua event kena jalur jaringan yang sama,
-- jadi selisihnya = lead sebenarnya di server, nggak kena ping)
local function learnLead(attacker, kind, now)
	local rec = swingAt[attacker]
	if not rec or rec.kind ~= kind then
		return
	end
	swingAt[attacker] = nil
	local obs = now - rec.t
	if obs < 0.04 or obs > 1.0 then
		return
	end
	local err = obs - rec.lead
	if kind == "M1" and math.abs(err) > 0.06 then
		resyncCombo(attacker, obs) -- kemungkinan salah index combo, jangan dipelajari
		return
	end
	if rec.learn and rec.key then
		local n = leadN[rec.key] or 0
		local g = math.max(0.3, 1 / (n + 1.5)) -- sampel awal gain gede, lama-lama stabil di 0.3
		local cur = leadCorr[rec.key] or 0
		leadCorr[rec.key] = math.clamp(cur * (1 - g) + err * g, -0.1, 0.1)
		leadN[rec.key] = n + 1
	end
	if kind == "M1" then
		local cur = leadAll[attacker.Name] or 0
		leadAll[attacker.Name] = math.clamp(cur * 0.8 + err * 0.2, -0.06, 0.06)
	end
end

local function onHit(data)
	local attacker, victim = data.Attacker, data.Victim
	local myChar = LocalPlayer.Character
	local now = os.clock()

	if (data.Kind == "M1" or data.Kind == "M2") and typeof(attacker) == "Instance" then
		learnLead(attacker, data.Kind, now)
	end

	-- gue yang nyerang dan ke-parry -> gue yang stun
	if attacker == myChar and data.Result == "Parried" then
		lockedUntil = math.max(lockedUntil, now + (data.AttackerStun or SR.ParryRecovery) - net.rtt / 2)
		return
	end
	if victim ~= myChar then
		return
	end

	local kind = data.Kind == "M2" and "M2" or "M1"
	-- v10: Kind selain M1/M2 = hit skill (barrage dll). Dulu ikut dihitung M1 -> ngerusak tune, combo, dan hitReflex
	local isSK = CFG.SkillAware and data.Kind ~= "M1" and data.Kind ~= "M2"
	if isSK and type(data.Kind) == "string" and not SK.seen[data.Kind] then
		SK.seen[data.Kind] = true
		evt("info", "Hit Kind lain: " .. data.Kind)
	end
	local sent = (now - blockOnAt) < 0.6 and lastRefusedAt < blockOnAt and pressMode == "parry" and (now - dodgeSentAt) > 0.8
		and (not CFG.TuneByAttacker or blockFor == attacker) and not isSK
	local res = data.Result
	local inParryCd = (now - parriedAt) < SR.ParryCooldown

	-- v8: lacak combo: attacker yang barusan kena/ke-block M1 ke lu lagi nge-combo, parry/dodge = combo putus
	if kind == "M1" and not isSK and typeof(attacker) == "Instance" then
		if res == "Hit" or res == "Blocked" or res == "GuardBroken" then
			local cv = comboVictim[attacker]
			if cv and now - cv.at < CFG.ComboKeepTime then
				cv.n += 1
			else
				cv = { n = 1 }
				comboVictim[attacker] = cv
			end
			cv.at = now
		elseif res == "Parried" or res == "Dodged" then
			comboVictim[attacker] = nil
		end
	end

	-- v4: parry M2 miss -> M2 berikutnya dari attacker ini dodge duluan
	if kind == "M2" and typeof(attacker) == "Instance" then
		if res == "Parried" then
			m2Miss[attacker] = nil
		elseif res == "GuardBroken" or res == "Hit" then
			m2Miss[attacker] = (m2Miss[attacker] or 0) + 1
				m2MissAt[attacker] = now
			trace("parry M2 miss dari", attacker.Name, "x" .. m2Miss[attacker], "-> M2 berikutnya dodge duluan")
		end
	end

	if res == "Parried" then
		counters.parried += 1
		if stunProbeAt == blockOnAt and lastRefusedAt < blockOnAt then
			stunLearn(true)
		end
		evt("parry", "PARRY " .. kind .. " · " .. nameOf(attacker))
		parriedAt = now
		if not isSK then
			streak[kind].n = 0
			streak[kind].dir = 0
		end
		if typeof(attacker) == "Instance" then
			combo[attacker] = nil -- attacker kena stun -> combo reset di server
			clearGuards(attacker) -- v7: abis parry lu bebas nyerang balik
			planToken[attacker] = (planToken[attacker] or 0) + 1
		end
		-- v4: abis parry, lepas block biar cooldown-nya (0.75s) cepet beres buat parry berikutnya,
		-- kecuali ada hit lain yang lagi ditunggu dalam <0.9s
		if CFG.ReleaseOnParry and blockHeld then
			local keep, lastAt = false, 0
			for _, e in ipairs(expected) do
				if e.kind ~= "DODGE" and e.atk ~= attacker and e.at > now + 0.12 and e.at < now + 0.9 then
					keep = true
					lastAt = math.max(lastAt, e.at)
				end
			end
			-- v6: attacker LAIN yang baru ngayun di deket lu -> tahan block sampai parry cooldown lewat
			if not keep and CFG.CrowdGuard then
				local _, myHrp = myState()
				if myHrp then
					for a, t in pairs(lastSwingSeen) do
						if a ~= attacker and now - t < CFG.CrowdWindow and a.Parent then
							local ah = a:FindFirstChild("HumanoidRootPart")
							if ah and (ah.Position - myHrp.Position).Magnitude <= CFG.CrowdRadius then
								keep = true
								lastAt = math.max(lastAt, now + SR.ParryCooldown - 0.05)
							end
						end
					end
				end
			end
			if not keep then
				releaseBefore(now)
			else
				-- v5: ada hit lain yang lagi ditunggu -> block tetap nyala sampai hit itu ketutup
				extendHoldTo(lastAt + CFG.ResultPad + holdAfter())
			end
		end
		if CFG.Debug then log(("PARRY  (%d parry / %d block / %d gb / %d hit)"):format(counters.parried, counters.blocked, counters.guardbroken, counters.hit)) end
	elseif res == "Blocked" then
		counters.blocked += 1
		if stunProbeAt == blockOnAt and lastRefusedAt < blockOnAt then
			stunLearn(true)
		end
		evt("block", "block " .. kind .. " · " .. nameOf(attacker))
		-- ke-Block doang = umur block kegedean (kecepetan) -> kirim lebih lambat
		if sent and not inParryCd then
			tuneBy(kind, 1)
		end
		if CFG.ChainGuard and kind == "M1" then
			extendHoldTo(now + CFG.ChainHold)
		end
		if CFG.Debug then log(("block  %s (tune M1 %+.3f M2 %+.3f%s)"):format(kind, tune.M1, tune.M2, inParryCd and ", parry cooldown" or "")) end
	elseif res == "GuardBroken" then
		counters.guardbroken += 1
		evt("gb", "GUARD BREAK " .. kind .. " · " .. nameOf(attacker))
		dropLocalBlock()
		lockedUntil = math.max(lockedUntil, now + SR.GuardBreak - net.rtt / 2)
		if sent and not inParryCd then
			tuneBy(kind, 1)
		end
		if CFG.Debug then log(("GUARD BREAK %s (tune M1 %+.3f M2 %+.3f%s)"):format(kind, tune.M1, tune.M2, inParryCd and ", parry cooldown" or "")) end
	elseif res == "Hit" then
		counters.hit += 1
		local lockBefore = math.max(lockedUntil - now, 0) -- v8: kondisi kunci SEBELUM stun hit ini masuk
		evt("hit", "KENA " .. kind .. " · " .. nameOf(attacker))
		if (now - dodgeSentAt) < 0.9 then
			counters.dodgemiss += 1
			if CFG.Trace then trace(("dodge nggak nutup hit ini (dodge dikirim %.2fs lalu)"):format(now - dodgeSentAt)) end
		end
		if type(data.Stun) == "number" then
			-- v8: unlock stun dihitung pakai stunComp() (dipelajari); dodge tetap konservatif (iframe nggak boleh nyasar)
			local su = now + data.Stun - stunComp()
			lockedUntil = math.max(lockedUntil, su)
			stunUntil = math.max(stunUntil, now + data.Stun - net.rtt / 2)
			stunSrcUntil = su
		end
		-- kena padahal block udah dikirim = kelambatan -> kirim lebih cepat
		if sent then
			tuneBy(kind, -1)
		end
		local reason = (now - lastSkip.at) < 1.2 and lastSkip.reason or (sent and "block telat" or "nggak ada rencana")
		if CFG.WhyHit then
			local cvw = typeof(attacker) == "Instance" and comboVictim[attacker]
			whyLog[#whyLog + 1] = {
				t = now, kind = kind, who = nameOf(attacker), why = reason, rtt = net.rtt, fps = frame.fps,
				held = blockHeld, locked = lockBefore, stun = type(data.Stun) == "number" and data.Stun or 0,
				sent = sent and true or false, slack = stunSlack, combo = cvw and cvw.n or 1,
			}
			if #whyLog > 20 then
				table.remove(whyLog, 1)
			end
		end
		if CFG.Debug then log(
			("kena   %s (tune M1 %+.3f M2 %+.3f, rtt %.3f±%.3f, fps %.0f, alasan: %s)"):format(
				kind, tune.M1, tune.M2, net.rtt, net.var, frame.fps, reason
			)
		) end
	elseif res == "Dodged" then
		counters.dodged += 1
		evt("dodge", "DODGE " .. kind .. " · " .. nameOf(attacker))
		if CFG.Debug then log(("DODGE sukses %s (%d dodge)"):format(kind, counters.dodged)) end
	end

	-- v8: abis kena / ke-block M1 -> langsung rencanain hit combo berikutnya (stun/lock udah ke-update di atas)
	if isSK and typeof(attacker) == "Instance" then
		if res == "Parried" then
			SK.barr[attacker] = nil -- barrage dibatalin server (MoveHandler:Cancel "Parried")
		else
			local okB, errB = pcall(SK.reflex, attacker, now, res)
			if not okB then
				trace("barrageReflex error:", tostring(errB))
			end
		end
	elseif (res == "Hit" or res == "Blocked") and kind == "M1" and typeof(attacker) == "Instance" then
		local okR, errR = pcall(hitReflex, attacker, now)
		if not okR then
			trace("hitReflex error:", tostring(errR))
		end
	end
end

-- v5: swing dari attacker yang jauh banget nggak perlu diproses
local function isFar(a)
	local ahrp = a:FindFirstChild("HumanoidRootPart")
	local _, hrp = myState()
	if not ahrp or not hrp then
		return false
	end
	return (ahrp.Position - hrp.Position).Magnitude > CFG.MaxTrackDist
end

-- v5: block ditolak server (lagi busy/cooldown) tapi masih ada M1 yang bakal dateng -> coba lagi begitu kunci kebuka
local retryHandle = nil
local lastRetryAt, retryWindowAt, retryCount = -math.huge, -math.huge, 0
local function retryGuard()
	if not (alive and CFG.Enabled and CFG.BlockFallback) then
		return
	end
	local now = os.clock()
	local target = nil
	for _, e in ipairs(expected) do
		if e.kind == "M1" and e.at > now + 0.15 and e.at < now + 1.0 and (not target or e.at > target) then
			target = e.at
		end
	end
	if not target then
		return
	end
	-- v6: batasin retry (server nolak terus -> dulu bisa spam remote tiap 10ms)
	if now - lastRetryAt < CFG.RetryMinGap then
		return
	end
	if now - retryWindowAt > 1.0 then
		retryWindowAt, retryCount = now, 0
	end
	if retryCount >= CFG.RetryMax then
		return
	end
	retryCount += 1
	lastRetryAt = now
	local at = math.max(lockedUntil, readyAt, now) + 0.01 + frame.avg * CFG.FireEarly
	if at >= target then
		return
	end
	cancel(retryHandle)
	retryHandle = schedule(at, function()
		if not alive or not CFG.Enabled or blockHeld then
			return
		end
		local hold = math.max(target - os.clock(), 0) + CFG.ResultPad + holdAfter()
		if pressBlock(hold) then
			pressMode = "plain"
			counters.chained += 1
			trace("block dicoba lagi abis ditolak")
		end
	end)
end

local seenKind = {}

local function onCombat(data)
	if type(data) ~= "table" then
		return
	end
	local info, kind = data.Info, data.Kind
	if not CFG.Enabled and (info == "Sound" or info == "Flash") then
		return
	end

	if info == "Sound" then
		local a = data.Character
		if typeof(a) ~= "Instance" or a == LocalPlayer.Character then
			return
		end
		if isFar(a) then
			return
		end
		if kind == "HeavySwing" then
			-- cadangan kalau Flash nggak nyampe (Flash biasanya nyampe duluan, jadi ini di-dedupe)
			local now = os.clock()
			if now - (heavySeen[a] or -math.huge) > 0.25 then
				heavySeen[a] = now
				local plan = m2Plan(a, nil)
				swingAt[a] = { t = now, lead = plan.lead, kind = "M2", key = plan.key, learn = plan.learn }
				lastSwingSeen[a] = now
				react(a, plan, "M2")
			end
		elseif Specs.swingSound[kind] then
			local now = os.clock()
			trace("swing M1 kebaca dari", a.Name, "sound:", tostring(kind))
			local plan = m1Plan(a, now)
			swingAt[a] = { t = now, lead = plan.lead, kind = "M1", key = plan.key, learn = plan.learn }
			lastSwingSeen[a] = now
			react(a, plan, "M1")
			predictFollowUp(a, plan, now)
		elseif CFG.Trace and not seenKind[tostring(kind)] then
			seenKind[tostring(kind)] = true
			trace("sound lain (nggak dianggap swing):", tostring(kind))
		end
	elseif info == "Flash" and kind == "Heavy" then
		local a, hold = data.Character, data.Hold
		if typeof(a) == "Instance" and a ~= LocalPlayer.Character and type(hold) == "number" and not isFar(a) then
			local now = os.clock()
			trace("heavy M2 kebaca dari", a.Name, "hold:", hold)
			heavySeen[a] = now
			local plan = m2Plan(a, hold)
			swingAt[a] = { t = now, lead = plan.lead, kind = "M2", key = plan.key, learn = plan.learn }
			lastSwingSeen[a] = now
			react(a, plan, "M2")
		end
	elseif info == "EndFlash" then
		-- heavy attacker dibatalin (kena stun / ke-parry orang lain) -> hit nggak bakal mendarat
		local a = data.Character
		if typeof(a) == "Instance" then
			planToken[a] = (planToken[a] or 0) + 1
			clearGuards(a)
			swingAt[a] = nil
		end
	elseif info == "Hit" then
		onHit(data)
	elseif info == "BlockRefused" then
		local untilServer = data.Until
		if type(untilServer) == "number" then
			lockedUntil = math.max(lockedUntil, os.clock() + math.max(0, untilServer - workspace:GetServerTimeNow()))
		end
		if stunProbeAt == blockOnAt and os.clock() - blockOnAt < net.rtt + 0.4 then
			stunLearn(false) -- v8: block pas-unlock ditolak -> kita kemaleman? bukan, kecepetan -> pengaman dinaikin
		end
		lastRefusedAt = os.clock()
		counters.refused += 1
		dropLocalBlock()
		if CFG.Debug then log(("block ditolak server (sisa %.2fs)"):format(math.max(0, lockedUntil - os.clock()))) end
		if CFG.GuardRetryOnRefuse then
			retryGuard()
		end
	end
end

