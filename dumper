        Size = UDim2.new(1, 0, 0, 18), TextSize = 12, TextColor3 = T.dim, Font = Enum.Font.GothamBold,
    }))
end
local function toggle(parent, txt, get, set, supported)
    local b = ordered(parent, new("TextButton", {
        Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = T.panel, Text = "", AutoButtonColor = false, BorderSizePixel = 0,
    }, parent))
    corner(b)
