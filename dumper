        { "remotes", "Remote + handler client", true },
        { "saveinstance", "saveinstance() bawaan executor", CAP.saveinstance ~= nil },
    }
    for _, m in ipairs(MODS) do
        toggle(dp, m[2], function() return CFG.Modules[m[1]] end, function(v) CFG.Modules[m[1]] = v end, m[3])
