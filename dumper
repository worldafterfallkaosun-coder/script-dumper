    toggle(ctl, "Instance spawn / hapus", function() return CFG.Live.instances end, function(v) CFG.Live.instances = v end)
    local brow = ordered(ctl, new("Frame", { Size = UDim2.new(1, 0, 0, 28), BackgroundTransparency = 1 }, ctl))
