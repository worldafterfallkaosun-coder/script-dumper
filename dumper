---------------------------------------------------------------------
local SR = {}

-- indeks nama (huruf kecil) dibangun sekali per scan: pencarian berikutnya tanpa pcall per instance
local NIDX = { at = nil, rows = {} }
local function nameIndex()
    if NIDX.at == SCAN.at and #NIDX.rows > 0 then return NIDX.rows end
    local rows = {}
    for i, inst in ipairs(INDEX.all) do
        if i % 1500 == 0 then U.pace() end
        local ok, name, cls = pcall(function() return inst.Name, inst.ClassName end)
        if ok and type(name) == "string" then rows[#rows + 1] = { inst, name:lower(), cls:lower() } end
    end
    NIDX.at, NIDX.rows = SCAN.at, rows
    return rows
end

function SR.inst(q, limit)
    local out = {}
    for i, r in ipairs(nameIndex()) do
        if i % 4000 == 0 then U.pace() end
        if r[2]:find(q, 1, true) or r[3]:find(q, 1, true) then
            local inst = r[1]
            local mine = false
            if APP.gui then
                local okG, res = pcall(inst.IsDescendantOf, inst, APP.gui)
                mine = okG and res
            end
            if not mine then
                local okC, code = pcall(U.luaInst, inst)
                local okN, cls = pcall(function() return inst.ClassName end)
                out[#out + 1] = { text = ("%-20s %s"):format(okN and cls or "?", U.path(inst)), copy = okC and code or nil }
                if #out >= limit then break end
            end
        end
    end
    return out
end

-- grep isi script: decompile paralel (SRC.get = cache memori + disk), tampilkan path:baris
function SR.src(q, limit)
    if not (CAP.decompile and CFG.DecompileScripts) then return nil, "butuh decompile (aktifkan toggle Decompile)" end
    local list, seen = {}, {}
    local function add(s)
        if typeof(s) == "Instance" and not seen[s] and (CFG.DumpCore or not U.isCore(s)) and SC.inst(s) then
            seen[s] = true
            list[#list + 1] = s
        end
    end
    for _, s in ipairs(INDEX.scripts) do add(s) end
    if CAP.getscripts then
        local ok, l = pcall(CAP.getscripts)
        if ok and type(l) == "table" then for _, s in ipairs(l) do add(s) end end
    end
    if CAP.getloadedmodules then
        local ok, l = pcall(CAP.getloadedmodules)
        if ok and type(l) == "table" then for _, s in ipairs(l) do add(s) end end
    end
    if #list == 0 then return nil, "tidak ada script terlihat" end

    local out, nextI, done = {}, 1, 0
    local N = math.max(1, CFG.DecompileWorkers)
    local function worker()
        while #out < limit do
            U.pace()
            local i = nextI
            if i > #list then return end
            nextI = i + 1
            local s = list[i]
            local body = SRC.get(s)
            if body and body:lower():find(q, 1, true) then
                local p = U.path(s)
                local hits = 0
                SRC.eachLine(body, function(line, ln)
                    if #line <= 2000 and line:lower():find(q, 1, true) then
                        hits += 1
                        out[#out + 1] = { text = ("%s:%d  %s"):format(p, ln, U.clean((line:match("^%s*(.-)%s*$") or line):sub(1, 140))) }
                        if hits >= 5 or #out >= limit then return true end
                    end
                end)
            end
        end
    end
    for _ = 1, N do
        task.spawn(function()
            pcall(worker)
            done += 1
        end)
    end
    while done < N do task.wait(0.1) end
    while #out > limit do out[#out] = nil end
    return out
end

function SR.remote(q, limit)
    local out = {}
    for _, r in ipairs(INDEX.remotes) do
        U.pace()
        local ok, name = pcall(function() return r.Name end)
        if ok and name:lower():find(q, 1, true) then
            local okC, code = pcall(U.luaInst, r)
            out[#out + 1] = { text = ("[%s] %s"):format(r.ClassName, U.path(r)), copy = okC and code or nil }
            if #out >= limit then break end
        end
    end
    return out
end

function SR.gc(q, limit)
    if not (CAP.getgc and debug.getconstants) then return nil, "butuh getgc + debug.getconstants" end
    local okG, gc = pcall(CAP.getgc, true)
    if not okG or type(gc) ~= "table" then return nil, "getgc gagal" end
    local isL = CAP.islclosure or function() return true end
    local isExec = CAP.isexecutorclosure or function() return false end
    local out = {}
    for _, v in ipairs(gc) do
        U.pace()
        if type(v) == "function" and isL(v) and not isExec(v) then
            local ok, c = pcall(debug.getconstants, v)
            if ok and type(c) == "table" then
                for _, k in next, c do
                    if type(k) == "string" and k:lower():find(q, 1, true) then
                        out[#out + 1] = { text = U.fnDesc(v) .. '  k="' .. U.clean(k:sub(1, 60)) .. '"' }
                        break
                    end
                end
            end
            if #out >= limit then break end
        end
    end
    return out
end

