-- 1. util (serializer, path, timeout, dsb)
---------------------------------------------------------------------
local U = {}
do
    local lastYield = os.clock()
    function U.pace()
        if APP.cancel then error("dihentikan", 0) end
        if os.clock() - lastYield > CFG.FrameBudget then
            task.wait()
            lastYield = os.clock()
        end
    end
    function U.each(list, fn)
        for _, x in ipairs(list) do
            U.pace()
            pcall(fn, x)
        end
    end
    function U.clean(s) return (tostring(s):gsub("%c", " ")) end

    function U.inGame(inst)
        local ok, r = pcall(inst.IsDescendantOf, inst, game)
        return ok and r == true
    end
    function U.path(inst, intree)
        local ok, p = pcall(inst.GetFullName, inst)
        if not ok then return "<?>" end
        if intree == nil then intree = U.inGame(inst) end
        return (intree and "" or "[NIL] ") .. p
    end
    function U.isCore(s)
        local ok, r = pcall(function()
            return (CoreGui and s:IsDescendantOf(CoreGui)) or (CorePackages and s:IsDescendantOf(CorePackages))
        end)
        return ok and r == true
    end

    local ownerCache = setmetatable({}, { __mode = "k" })
    function U.ownerOf(f)
        local ok, s = pcall(function() return getfenv(f).script end)
        if ok and typeof(s) == "Instance" then
            local c = ownerCache[s]
            if not c then
                c = U.path(s)
                ownerCache[s] = c
            end
            return c
        end
        return nil
    end

    function U.fnDesc(f, noOwner)
        local i = {}
        if debug.getinfo then
            local ok, r = pcall(debug.getinfo, f)
            if ok and type(r) == "table" then i = r end
        end
        local va = (i.is_vararg == true or i.is_vararg == 1) and "+..." or ""
        local d = ("fn:%s line=%s params=%s%s upv=%s"):format(
            tostring(i.name or "?"), tostring(i.linedefined or i.line or "?"),
            tostring(i.numparams or "?"), va, tostring(i.nups or "?"))
        if not noOwner then d = d .. " owner=" .. (U.ownerOf(f) or tostring(i.short_src or i.source or "?")) end
        return d
    end
    function U.constSummary(f)
        if not debug.getconstants then return "" end
        local ok, c = pcall(debug.getconstants, f)
        if not ok or type(c) ~= "table" then return "" end
        local s = {}
        for _, k in next, c do
            if type(k) == "string" and #k > 2 and #k < 60 then
                s[#s + 1] = U.clean(k)
                if #s >= 16 then break end
            end
        end
        return #s > 0 and ("  consts={" .. table.concat(s, ", ") .. "}") or ""
    end
    function U.upvalSummary(f)
        if not debug.getupvalues then return "" end
        local ok, u = pcall(debug.getupvalues, f)
        if not ok or type(u) ~= "table" then return "" end
        local types, n = {}, 0
        for _, v in next, u do
            n += 1
            if n <= 6 then types[n] = typeof(v) end
        end
        if n == 0 then return "" end
        return "  upvals={" .. table.concat(types, ",") .. (n > 6 and ",..." or "") .. "}"
    end
    local function mtSummary(t)
        if not CAP.getrawmetatable then return nil end
        local ok, mt = pcall(CAP.getrawmetatable, t)
        if not ok or type(mt) ~= "table" then return nil end
        local keys = {}
        pcall(function()
            for k, v in next, mt do
                keys[#keys + 1] = tostring(k) .. "=" .. typeof(v)
                if #keys >= 12 then break end
            end
        end)
        return "{" .. table.concat(keys, ", ") .. "}"
    end

    -- serializer: pakai `next` (bypass __pairs/__iter), tampilkan metatable
    function U.ser(v, depth, seen, ind)
        local t = typeof(v)
        if t == "string" then
            local s = U.clean(v:sub(1, CFG.MaxStringLen))
            return '"' .. s .. (#v > CFG.MaxStringLen and '..."' or '"')
        elseif t == "number" or t == "boolean" or t == "nil" then
            return tostring(v)
        elseif t == "Instance" then
            local ok, cls = pcall(function() return v.ClassName end)
            return ("Instance<%s> %s"):format(ok and cls or "?", U.path(v))
        elseif t == "function" then
            return U.fnDesc(v)
        elseif t == "table" then
            if seen[v] then return "<cycle>" end
            if depth <= 0 then return "{...}" end
            seen[v] = true
            local out, n, cut = {}, 0, false
            local mt = mtSummary(v)
            if mt then out[#out + 1] = ind .. "  -- metatable: " .. mt end
            pcall(function()
                for k, val in next, v do
                    n += 1
                    if n > CFG.MaxTableKeys then
                        cut = true
                        break
                    end
                    out[#out + 1] = ("%s  [%s] = %s"):format(ind, U.ser(k, 0, seen, ""), U.ser(val, depth - 1, seen, ind .. "  "))
                end
            end)
            seen[v] = nil
            if #out == 0 then return "{}" end
            if cut then out[#out + 1] = ind .. "  -- (dipotong)" end
            return "{\n" .. table.concat(out, ",\n") .. "\n" .. ind .. "}"
        end
        local ok, s = pcall(tostring, v)
        return ("%s(%s)"):format(t, U.clean(ok and s or "?"))
    end

    ------------------------------------------------------------------
    -- serializer KODE Lua (dipakai "Salin kode" di live spy) + signature argumen
    ------------------------------------------------------------------
    local LUA_KW = {}
    for w in ("and break do else elseif end false for function if in local nil not or repeat return then true until while"):gmatch("%a+") do
        LUA_KW[w] = true
    end
    local function isIdent(s) return s:match("^[%a_][%w_]*$") ~= nil and not LUA_KW[s] end

    function U.luaInst(inst)
        if not U.inGame(inst) then
            local ok, n, c = pcall(function() return inst.Name, inst.ClassName end)
            if not ok then return "nil --[[Instance]]" end
            return ("(function() if getnilinstances then for _, v in next, getnilinstances() do if v.Name == %q and v.ClassName == %q then return v end end end end)()"):format(n, c)
        end
        local chain, cur, guard = {}, inst, 0
        while cur and cur ~= game and guard < 120 do
            guard += 1
            table.insert(chain, 1, cur.Name)
            cur = cur.Parent
        end
        if #chain == 0 then return "game" end
        local lp = Players and Players.LocalPlayer
        local out, start
        if lp and chain[1] == "Players" and chain[2] == lp.Name then
            out, start = 'game:GetService("Players").LocalPlayer', 3
        else
            local okS = pcall(game.GetService, game, chain[1])
            out = okS and ("game:GetService(%q)"):format(chain[1]) or ("game[%q]"):format(chain[1])
            start = 2
        end
        for i = start, #chain do
            local seg = chain[i]
            out ..= isIdent(seg) and ("." .. seg) or ("[%q]"):format(seg)
        end
        return out
    end

    function U.lua(v, depth, seen)
        depth = depth or 4
        local t = typeof(v)
        if t == "string" then
            return ("%q"):format(v)
        elseif t == "number" then
            if v ~= v then return "0/0" end
            if v == math.huge then return "math.huge" end
            if v == -math.huge then return "-math.huge" end
            return tostring(v)
        elseif t == "boolean" or t == "nil" then
            return tostring(v)
        elseif t == "Instance" then
            local ok, r = pcall(U.luaInst, v)
            return ok and r or "nil --[[Instance]]"
        elseif t == "Vector3" then
            return ("Vector3.new(%s, %s, %s)"):format(v.X, v.Y, v.Z)
        elseif t == "Vector2" then
            return ("Vector2.new(%s, %s)"):format(v.X, v.Y)
        elseif t == "CFrame" then
            return "CFrame.new(" .. table.concat({ v:GetComponents() }, ", ") .. ")"
        elseif t == "Color3" then
            return ("Color3.new(%s, %s, %s)"):format(v.R, v.G, v.B)
        elseif t == "UDim2" then
            return ("UDim2.new(%s, %s, %s, %s)"):format(v.X.Scale, v.X.Offset, v.Y.Scale, v.Y.Offset)
        elseif t == "UDim" then
            return ("UDim.new(%s, %s)"):format(v.Scale, v.Offset)
        elseif t == "BrickColor" then
            return ("BrickColor.new(%q)"):format(v.Name)
        elseif t == "EnumItem" then
            return tostring(v)
        elseif t == "table" then
            seen = seen or {}
            if seen[v] then return "nil --[[cycle]]" end
            if depth <= 0 then return "{} --[[kedalaman]]" end
            seen[v] = true
            local parts, n, idx = {}, 0, 0
            pcall(function()
                for k, val in next, v do
                    n += 1
                    if n > 200 then
                        parts[#parts + 1] = "--[[dipotong]]"
                        break
                    end
                    if type(k) == "number" and k == idx + 1 then
                        idx = k
                        parts[#parts + 1] = U.lua(val, depth - 1, seen)
                    elseif type(k) == "string" and isIdent(k) then
                        parts[#parts + 1] = k .. " = " .. U.lua(val, depth - 1, seen)
                    else
                        parts[#parts + 1] = "[" .. U.lua(k, 0, seen) .. "] = " .. U.lua(val, depth - 1, seen)
                    end
                end
            end)
            seen[v] = nil
            return "{" .. table.concat(parts, ", ") .. "}"
        end
        return ("nil --[[%s]]"):format(t)
    end

    function U.shape(args)
        local out = {}
        for i = 1, math.min(args.n, 12) do
            local v = args[i]
            local t = typeof(v)
            if t == "Instance" then
                local ok, c = pcall(function() return v.ClassName end)
                t = ok and c or "Instance"
            end
            out[i] = t
        end
        if args.n > 12 then out[#out + 1] = "..." end
        return "(" .. table.concat(out, ", ") .. ")"
    end

    -- jalankan fungsi dengan timeout; thread yang kelamaan dibatalkan
    function U.withTimeout(fn, timeout, ...)
        local done, ok, res = false, false, nil
        local args = table.pack(...)
        local th = task.spawn(function()
            ok, res = pcall(fn, table.unpack(args, 1, args.n))
            done = true
        end)
        local t0 = os.clock()
        while not done and os.clock() - t0 < timeout do task.wait() end
        if not done then
            pcall(task.cancel, th)
            return false, "timeout"
        end
        return ok, res
    end

    -- fallback kalau decompile mati: constants + upvalue + proto (rekursif)
    local function closureReport(f, out, depth, ind)
        if #out > 6000 then return end
        out[#out + 1] = ind .. "-- " .. U.fnDesc(f, true) .. U.upvalSummary(f)
        if debug.getconstants then
            local ok, c = pcall(debug.getconstants, f)
            if ok and type(c) == "table" then
                for i, k in next, c do
                    local tk = type(k)
                    if tk == "string" then
                        out[#out + 1] = ("%s-- k[%s] \"%s\""):format(ind, tostring(i), U.clean(k:sub(1, 120)))
                    elseif tk == "number" then
                        out[#out + 1] = ("%s-- k[%s] %s"):format(ind, tostring(i), tostring(k))
                    end
                end
            end
        end
        if depth > 0 and debug.getprotos then
            local ok, protos = pcall(debug.getprotos, f)
            if ok and type(protos) == "table" then
                for _, p in next, protos do
                    if type(p) == "function" then closureReport(p, out, depth - 1, ind .. "  ") end
                end
            end
        end
    end
    function U.fallbackBody(s)
        if not CAP.getscriptclosure then return "-- executor tidak punya decompile maupun getscriptclosure" end
        local ok, f = pcall(CAP.getscriptclosure, s)
        if not ok or type(f) ~= "function" then return "-- getscriptclosure gagal" end
        local out = { "-- [fallback] constants / upvalue / proto dari closure script" }
        closureReport(f, out, 3, "")
        return table.concat(out, "\n")
    end

    -- "CamelCase_name" -> {"camel","case","name"}
    function U.tokens(name)
        local s = tostring(name):gsub("(%l)(%u)", "%1 %2")
        s = s:gsub("(%u)(%u%l)", "%1 %2")
        local out = {}
        for w in s:lower():gmatch("%a+") do out[#out + 1] = w end
        return out
    end
end

