-- 7. remote + handler client-nya (lengkap dengan const & upvalue handler)
---------------------------------------------------------------------
phase("remotes", CFG.DumpRemotes, function()
    local w = newWriter("remotes")
    each(remotes, function(r)
        local cls = r.ClassName
        w.add(("[%s] %s"):format(cls, path(r)))
        counts.remotes += 1

        if getconnections then
            local sig
            if cls == "RemoteEvent" or cls == "UnreliableRemoteEvent" then
                sig = r.OnClientEvent
            elseif cls == "BindableEvent" then
                sig = r.Event
            end
            if sig then
                local ok, conns = pcall(getconnections, sig)
                if ok and type(conns) == "table" then
                    for _, c in ipairs(conns) do
                        local okf, fn = pcall(function() return c.Function end)
                        if okf and type(fn) == "function" then
                            w.add("    handler: " .. fnDesc(fn) .. constSummary(fn) .. upvalSummary(fn))
                        else
                            w.add("    handler: <foreign/C>")
                        end
                    end
                end
            end
        end

        if cls == "RemoteFunction" and getcallbackvalue then
            local ok, cb = pcall(getcallbackvalue, r, "OnClientInvoke")
            if ok and type(cb) == "function" then
                w.add("    OnClientInvoke: " .. fnDesc(cb) .. constSummary(cb) .. upvalSummary(cb))
            end
        end
    end)
end)

---------------------------------------------------------------------
-- 8. capture pasif panggilan remote (IN lewat OnClientEvent, OUT lewat __namecall)
--    Cuma MENCATAT. Hook tetap terpasang sebagai passthrough setelah selesai.
---------------------------------------------------------------------
phase("capture", CFG.CaptureSeconds > 0, function()
    local w = newWriter("remote_calls")
    local log, n, capturing = {}, 0, true
    local conns = {}
    local t0 = os.clock()

    for _, r in ipairs(remotes) do
        local cls = r.ClassName
        if cls == "RemoteEvent" or cls == "UnreliableRemoteEvent" then
            local okc, c = pcall(function()
                return r.OnClientEvent:Connect(function(...)
                    if capturing and n < CFG.MaxCaptured then
                        n += 1
                        log[n] = { dir = "IN ", m = "OnClientEvent", inst = r, args = table.pack(...), t = os.clock() }
                    end
                end)
            end)
            if okc and c then conns[#conns + 1] = c end
        end
    end

    local hookOK = false
    if hookmetamethod and getnamecallmethod then
        local SEND = { FireServer = true, InvokeServer = true, fireServer = true, invokeServer = true }
        local wrap = newcclosure or function(f) return f end
        local old
        local okh = pcall(function()
            old = hookmetamethod(game, "__namecall", wrap(function(self, ...)
                local m = getnamecallmethod()
                -- di dalam hook: kerja minimal, serialisasi dilakukan nanti
                if capturing and SEND[m] and n < CFG.MaxCaptured and typeof(self) == "Instance"
                    and not (checkcaller and checkcaller()) then
                    n += 1
                    log[n] = { dir = "OUT", m = m, inst = self, args = table.pack(...), t = os.clock() }
                end
                if setnamecallmethod then setnamecallmethod(m) end
                return old(self, ...)
            end))
        end)
        hookOK = okh and old ~= nil
    end

    local total = CFG.CaptureSeconds
    while os.clock() - t0 < total do
        if ENV.DumperPP_Stop then break end
        local left = math.max(0, math.floor(total - (os.clock() - t0)))
        sub((os.clock() - t0) / total, ("capture %ds lagi | %d panggilan"):format(left, n))
        task.wait(0.25)
    end
    capturing = false
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end

    if not hookOK then w.add("-- hookmetamethod/getnamecallmethod tidak tersedia: hanya capture IN") end
    for _, e in ipairs(log) do
        pace()
        w.add(("[%s] %-12s %s  (+%.2fs)"):format(e.dir, e.m, path(e.inst), e.t - t0))
        for i = 1, e.args.n do
            w.add(("    arg%d = %s"):format(i, ser(e.args[i], 3, {}, "    ")))
        end
    end
    counts.captured = n
end)

