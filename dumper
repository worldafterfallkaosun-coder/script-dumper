local KW, NAME_MEMO, memoN, customToks = {}, {}, 0, {}
local function addKW(tok, id)
    local l = KW[tok]
    if not l then
        l = {}
        KW[tok] = l
    end
    l[#l + 1] = id
end
for _, s in ipairs(SYSTEMS) do
    for _, k in ipairs(s.kw) do addKW(k, s.id) end
end

function S.classify(name)
    local m = NAME_MEMO[name]
    if m then return m end
    m = {}
    local seen = {}
    for _, w in ipairs(U.tokens(name)) do
        local ids = KW[w] or (w:sub(-1) == "s" and KW[w:sub(1, -2)]) or nil
        if ids then
            for _, id in ipairs(ids) do
                if not seen[id] then
                    seen[id] = true
                    m[#m + 1] = id
                end
            end
        end
    end
    memoN += 1
    if memoN > 60000 then NAME_MEMO, memoN = {}, 0 end
    NAME_MEMO[name] = m
    return m
end

-- scope: sistem yang dipilih user (kosong = seluruh game)
local SC = { sel = {} }
local scMemo = setmetatable({}, { __mode = "k" })
function SC.active() return next(SC.sel) ~= nil end
function SC.reset() scMemo = setmetatable({}, { __mode = "k" }) end
function SC.inst(inst)
    if not SC.active() then return true end
    local r = scMemo[inst]
    if r ~= nil then return r end
    r = false
    local okN, name = pcall(function() return inst.Name end)
    if okN then
        for _, id in ipairs(S.classify(name)) do
            if SC.sel[id] then
                r = true
                break
            end
        end
        if not r then
            local okP, par = pcall(function() return inst.Parent end)
            if okP and par and par ~= game then r = SC.inst(par) end
        end
    end
    scMemo[inst] = r
    return r
end
function SC.str(p)
    if not SC.active() then return true end
    for seg in tostring(p):gmatch("[^%.]+") do
        for _, id in ipairs(S.classify(seg)) do
            if SC.sel[id] then return true end
        end
    end
    return false
end
function SC.keywords() -- kata kunci aktif (untuk skor tabel GC)
    local out = {}
    for id in next, SC.sel do
        local def = SYS_BY_ID[id]
        if def then
            for _, k in ipairs(def.kw) do out[#out + 1] = k end
        end
    end
    for _, k in ipairs(customToks) do out[#out + 1] = k end
    return out
end
function S.setCustom(str)
    for _, tok in ipairs(customToks) do
        local l = KW[tok]
        if l then
            for i = #l, 1, -1 do
                if l[i] == "custom" then table.remove(l, i) end
            end
            if #l == 0 then KW[tok] = nil end
        end
    end
    customToks = {}
    for tok in tostring(str or ""):lower():gmatch("[%w_]+") do
        customToks[#customToks + 1] = tok
        addKW(tok, "custom")
    end
    NAME_MEMO, memoN = {}, 0
    if #customToks > 0 then SC.sel.custom = true else SC.sel.custom = nil end
    SC.reset()
end

local function mergeIds(a, b)
    local out, seen = {}, {}
    for _, id in ipairs(a) do if not seen[id] then seen[id] = true out[#out + 1] = id end end
    for _, id in ipairs(b) do if not seen[id] then seen[id] = true out[#out + 1] = id end end
    return out
end

function S.run(progress)
    progress = progress or function() end
    SCAN.busy = true
    local t0 = os.clock()
    NAME_MEMO, memoN = {}, 0
    SC.reset()

    local list
    if CAP.getinstances then
        local ok, r = pcall(CAP.getinstances)
        if ok and type(r) == "table" then list = r end
    end
    if not list then
        list = game:GetDescendants()
        if CAP.getnilinstances then
            local ok, nils = pcall(CAP.getnilinstances)
            if ok and type(nils) == "table" then
                for _, i in ipairs(nils) do list[#list + 1] = i end
            end
        end
    end

    INDEX.all, INDEX.remotes, INDEX.scripts, INDEX.values, INDEX.attrs = list, {}, {}, {}, {}
    local HIT, fw, kindCount = {}, {}, {}
    for _, s in ipairs(SYSTEMS) do
        HIT[s.id] = { score = 0, remote = 0, script = 0, value = 0, folder = 0, obj = 0, gui = 0, attr = 0, samples = {} }
    end

    local function hit(ids, kind, inst)
        for _, id in ipairs(ids) do
            local h = HIT[id]
            if h then
                h.score += WEIGHT[kind] or 1
                h[kind] = (h[kind] or 0) + 1
                if #h.samples < 3 and kind ~= "attr" then h.samples[#h.samples + 1] = U.path(inst) end
            end
        end
    end

    local function handle(inst)
        local kind = KIND[inst.ClassName]
        if not kind or inst == game then return end
        if APP.gui and inst:IsDescendantOf(APP.gui) then return end
        if not CFG.DumpCore and U.isCore(inst) then return end

        local name = inst.Name
        kindCount[kind] = (kindCount[kind] or 0) + 1
        local ids = S.classify(name)
        if kind == "remote" or kind == "script" or kind == "value" then
            local par = inst.Parent
            if par then
                local pids = S.classify(par.Name)
                if #pids > 0 then ids = mergeIds(ids, pids) end
            end
            local bucket = (kind == "remote" and INDEX.remotes) or (kind == "script" and INDEX.scripts) or INDEX.values
            bucket[#bucket + 1] = inst
        end
        if kind == "script" or kind == "folder" then
            local f = FRAMEWORKS[name:lower()]
            if f then fw[f] = (fw[f] or 0) + 1 end
        end
        if #ids > 0 then hit(ids, kind, inst) end

        if ATTR_KINDS[kind] then
            local ok, a = pcall(inst.GetAttributes, inst)
            if ok and type(a) == "table" and next(a) ~= nil then
                INDEX.attrs[#INDEX.attrs + 1] = inst
                for k in next, a do
                    local aids = S.classify(tostring(k))
                    if #aids > 0 then hit(aids, "attr", inst) end
                end
            end
        end
    end

    local total = #list
    for i = 1, total do
        U.pace()
        pcall(handle, list[i])
        if i % 3000 == 0 then progress(i / total, ("scan %d/%d"):format(i, total)) end
    end

    -- service / player yang sering punya attribute
    for _, inst in ipairs({ workspace, svc("ReplicatedStorage"), Players and Players.LocalPlayer }) do
        if inst then
            local ok, a = pcall(inst.GetAttributes, inst)
            if ok and type(a) == "table" and next(a) ~= nil then INDEX.attrs[#INDEX.attrs + 1] = inst end
        end
    end

    local systems = {}
    for _, s in ipairs(SYSTEMS) do
        local h = HIT[s.id]
        if h.score > 0 then
            systems[#systems + 1] = {
                id = s.id, name = s.name, score = h.score, remote = h.remote, script = h.script,
                value = h.value, other = h.folder + h.obj + h.gui, attr = h.attr, samples = h.samples,
            }
        end
    end
    table.sort(systems, function(a, b) return a.score > b.score end)

    local fwList = {}
    for n, c in next, fw do fwList[#fwList + 1] = ("%s x%d"):format(n, c) end
    table.sort(fwList)

    local treeCount = #game:GetDescendants()
    local lp = Players and Players.LocalPlayer
    local execName = "?"
    if CAP.identifyexecutor then
        local ok, n = pcall(CAP.identifyexecutor)
        if ok then execName = tostring(n) end
    end
    SCAN.info = {
        executor = execName, total = total, tree = treeCount, nil_ = math.max(0, total - treeCount),
        remotes = #INDEX.remotes, scripts = #INDEX.scripts, values = #INDEX.values, attrs = #INDEX.attrs,
        streaming = (function() local ok, v = pcall(function() return workspace.StreamingEnabled end) return ok and v end)(),
        players = Players and #Players:GetPlayers() or 0,
        character = lp and lp.Character ~= nil or false,
        leaderstats = lp and lp:FindFirstChild("leaderstats") ~= nil or false,
        seconds = math.floor((os.clock() - t0) * 100) / 100,
    }
    SCAN.systems, SCAN.frameworks, SCAN.done, SCAN.at, SCAN.busy = systems, fwList, true, os.clock(), false
    LOG.add("info", ("scan selesai: %d instance, %d sistem terdeteksi (%.2fs)"):format(total, #systems, SCAN.info.seconds))
    progress(1, "scan selesai")
end

---------------------------------------------------------------------
-- 4. DUMP ENGINE (fase-fase v2, sekarang mengikuti scope & hasil scan)
---------------------------------------------------------------------
local D = { running = false }
function D.status(text, frac, quiet)
    if not quiet then LOG.add("info", text) end
    if D.onStatus then pcall(D.onStatus, text, frac) end
end

function D.run()
    if D.running then return end
    if not CAN_WRITE then
        LOG.add("error", "executor tidak punya writefile/appendfile/makefolder: dump dibatalkan")
        return
    end
    D.running, APP.cancel = true, false
    W.newRoot()
    local ROOT = W.ensureRoot()
    pcall(CAP.makefolder, ROOT .. "/scripts")
    if CFG.DumpBytecode then pcall(CAP.makefolder, ROOT .. "/bytecode") end

    local M = CFG.Modules
    local errors, timings = {}, {}
    local counts = {
        tree = 0, nil_ = 0, values = 0, attrs = 0, tags = 0, scripts = 0, dups = 0,
        modules = 0, senv = 0, remotes = 0, gcFuncs = 0, gcTables = 0,
    }
    local selNames = {}
    for id in next, SC.sel do selNames[#selNames + 1] = id end
    table.sort(selNames)
    local scoped = SC.active()
    LOG.add("info", scoped and ("scope: " .. table.concat(selNames, ", ")) or "scope: seluruh game")

    local phasesOn = {
        M.instances, M.tags, M.scripts, M.modules_return and CAP.getloadedmodules, M.senv and CAP.getsenv,
        M.gc and CAP.getgc, M.remotes, M.saveinstance and CAP.saveinstance,
    }
    local total, phaseNo, curBase = 0, 0, 0
    for i = 1, 8 do if phasesOn[i] then total += 1 end end
    total = math.max(total, 1)

    local function sub(frac, text) D.status(text, curBase + frac / total, true) end
    local function phase(name, enabled, fn)
        if not enabled or APP.cancel then return end
        phaseNo += 1
        curBase = (phaseNo - 1) / total
        D.status(name .. " ...", curBase)
        local t0 = os.clock()
        local ok, err = pcall(fn)
        W.flushAll()
        timings[name] = math.floor((os.clock() - t0) * 100) / 100
        if not ok then
            errors[#errors + 1] = name .. ": " .. tostring(err)
            LOG.add("error", name .. " gagal: " .. tostring(err))
        end
    end

    local ok, err = pcall(function()
        if not SCAN.done or os.clock() - SCAN.at > 60 then
            D.status("refresh scan ...", 0)
            S.run(function(f, t) D.status(t, f * 0.02, true) end)
        end

        local scriptList, scriptSet, loadedMods, loadedList = {}, {}, {}, {}
        local function addScript(s)
            if not scriptSet[s] then
                scriptSet[s] = true
                scriptList[#scriptList + 1] = s
            end
        end

        -- 1. instance tree + values + attributes
        phase("instances", M.instances, function()
            local list = INDEX.all
            local total2 = #list
            local wTree, wNil = W.new("instances"), W.new("nil_instances")
            local wVals, wAttr = W.new("values"), W.new("attributes")
            local classCount = {}
            for i = 1, total2 do
                U.pace()
                local inst = list[i]
                pcall(function()
                    if inst == game or (APP.gui and inst:IsDescendantOf(APP.gui)) then return end
                    if not SC.inst(inst) then return end
                    local cls = inst.ClassName
                    local intree = U.inGame(inst)
                    local p = U.path(inst, intree)
                    local w = intree and wTree or wNil
                    w.add(("%-26s %s"):format(cls, p))
                    if intree then counts.tree += 1 else counts.nil_ += 1 end
                    classCount[cls] = (classCount[cls] or 0) + 1
                    if inst:IsA("ValueBase") then
                        local okv, val = pcall(function() return inst.Value end)
                        wVals.add(("%-14s %s = %s"):format(cls, p, okv and U.ser(val, 2, {}, "") or "<?>"))
                        counts.values += 1
                    end
                    local oka, attrs = pcall(inst.GetAttributes, inst)
                    if oka and type(attrs) == "table" and next(attrs) ~= nil then
                        wAttr.add(p)
                        for k, val in next, attrs do
                            wAttr.add(("    %s = %s"):format(tostring(k), U.ser(val, 2, {}, "    ")))
                        end
                        counts.attrs += 1
                    end
                end)
                if i % 2000 == 0 then sub(i / total2, ("instances %d/%d"):format(i, total2)) end
            end
            local rows = {}
            for cls, n in next, classCount do rows[#rows + 1] = { cls, n } end
            table.sort(rows, function(a, b) return a[2] > b[2] end)
            local wc = W.new("class_stats")
            for _, r in ipairs(rows) do wc.add(("%8d  %s"):format(r[2], r[1])) end
        end)

        -- 2. tags
        phase("tags", M.tags, function()
            local CS = svc("CollectionService")
            local w = W.new("tags")
            for _, tag in ipairs(CS:GetAllTags()) do
                U.pace()
                local items = CS:GetTagged(tag)
                local keep = SC.str(tag)
                if not keep then
                    for i = 1, math.min(#items, 20) do
                        if SC.inst(items[i]) then keep = true break end
                    end
                end
                if keep then
                    w.add(("## %s (%d)"):format(tag, #items))
                    for i, inst in ipairs(items) do
                        if i > 50 then w.add("  ...") break end
                        w.add("  " .. U.path(inst))
                    end
                    counts.tags += 1
                end
            end
        end)

        -- 3. script + module (decompile paralel, dedup by hash)
        phase("scripts", M.scripts, function()
            for _, s in ipairs(INDEX.scripts) do addScript(s) end
            if CAP.getscripts then
                local okS, l = pcall(CAP.getscripts)
                if okS then for _, s in ipairs(l) do addScript(s) end end
            end
            if CAP.getloadedmodules then
                local okM, l = pcall(CAP.getloadedmodules)
                if okM then
                    for _, m in ipairs(l) do
                        loadedMods[m] = true
                        loadedList[#loadedList + 1] = m
                        addScript(m)
                    end
                end
            end

            local meta, jobs, primaryOf = {}, {}, {}
            for _, s in ipairs(scriptList) do
                U.pace()
                if (CFG.DumpCore or not U.isCore(s)) and SC.inst(s) then
                    local i = #meta + 1
                    local p = U.path(s)
                    local hash
                    if CAP.getscripthash then
                        local okh, h = pcall(CAP.getscripthash, s)
                        if okh and h then hash = tostring(h) end
                    end
                    local fname = ("%04d_%s.lua"):format(i, (p:gsub("[^%w_%.%-]", "_")):sub(-90))
                    local m = { s = s, p = p, hash = hash, fname = fname, cls = s.ClassName }
                    meta[i] = m
                    local primary = hash and primaryOf[hash]
                    if primary then
                        m.dupOf = primary
                        primary.copies = (primary.copies or 1) + 1
                        counts.dups += 1
                    else
                        if hash then primaryOf[hash] = m end
                        jobs[#jobs + 1] = m
                    end
                end
            end

            local function process(m)
                local s = m.s
                local body
                if CFG.DecompileScripts and CAP.decompile then
                    local okd, r = U.withTimeout(CAP.decompile, CFG.ScriptTimeout, s)
                    if okd and type(r) == "string" and #r > 0 then
                        body = r
                    else
                        body = "-- decompile gagal: " .. tostring(okd and "hasil kosong" or r) .. "\n" .. U.fallbackBody(s)
                    end
                else
                    body = U.fallbackBody(s)
                end
                local extra = ""
                pcall(function()
                    if s:IsA("BaseScript") then
                        extra = ("-- Enabled   : %s\n-- RunContext: %s\n"):format(tostring(s.Enabled), tostring(s.RunContext))
                    end
                end)
                local header = ("-- Path      : %s\n-- Class     : %s\n-- Hash      : %s\n-- Loaded    : %s\n-- Copies    : %d\n%s\n"):format(
                    m.p, m.cls, m.hash or "?", tostring(loadedMods[s] == true), m.copies or 1, extra)
                CAP.writefile(ROOT .. "/scripts/" .. m.fname, header .. body)
                if CFG.DumpBytecode and CAP.getscriptbytecode then
                    local okb, bc = pcall(CAP.getscriptbytecode, s)
                    if okb and type(bc) == "string" then
                        pcall(CAP.writefile, ROOT .. "/bytecode/" .. (m.fname:gsub("%.lua$", ".bin")), bc)
                    end
                end
            end

            local N = math.max(1, CFG.DecompileWorkers)
            local nextJob, finished, workersDone, totalJobs = 1, 0, 0, #jobs
            local function worker()
                while true do
                    U.pace()
                    local i = nextJob
                    if i > totalJobs then return end
                    nextJob = i + 1
                    local job = jobs[i]
                    local okp, e = pcall(process, job)
                    if okp then
                        counts.scripts += 1
                    else
                        errors[#errors + 1] = ("script %s: %s"):format(job.p, tostring(e))
                    end
                    finished += 1
                    if finished % 5 == 0 then
                        sub(finished / totalJobs, ("scripts %d/%d (dup dilewati: %d)"):format(finished, totalJobs, counts.dups))
                    end
                end
            end
            for _ = 1, N do
                task.spawn(function()
                    pcall(worker)
                    workersDone += 1
                end)
            end
            while workersDone < N do task.wait(0.1) end

            local idx = W.new("scripts/_index")
            for _, m in ipairs(meta) do
                local where = m.dupOf and ("dup -> " .. m.dupOf.fname) or m.fname
                idx.add(("%s | %s | %s | %s"):format(where, m.cls, m.p, m.hash or "?"))
            end
        end)

        -- 4. return ModuleScript yang sudah ke-load
        phase("modules_return", M.modules_return and CAP.getloadedmodules, function()
            local w = W.new("modules_return")
            U.each(loadedList, function(m)
                if (CFG.DumpCore or not U.isCore(m)) and SC.inst(m) then
                    local okr, ret = U.withTimeout(require, CFG.RequireTimeout, m)
                    w.add("=== " .. U.path(m))
                    w.add(okr and U.ser(ret, CFG.MaxDepth, {}, "") or ("<require gagal: " .. tostring(ret) .. ">"))
                    w.add("")
                    counts.modules += 1
                end
            end)
        end)

        -- 5. environment script yang sedang jalan
        phase("senv", M.senv and CAP.getsenv, function()
            local w = W.new("senv")
            U.each(scriptList, function(s)
                if (s:IsA("LocalScript") or loadedMods[s]) and (CFG.DumpCore or not U.isCore(s)) and SC.inst(s) then
                    local oke, env = pcall(CAP.getsenv, s)
                    if oke and type(env) == "table" and next(env) ~= nil then
                        w.add("=== " .. U.path(s))
                        w.add(U.ser(env, 2, {}, ""))
                        w.add("")
                        counts.senv += 1
                    end
                end
            end)
        end)

        -- 6. garbage collector
        phase("gc", M.gc and CAP.getgc, function()
            local gc = CAP.getgc(true)
            local isL = CAP.islclosure or function() return true end
            local isExec = CAP.isexecutorclosure or function() return false end
            local keywords = scoped and SC.keywords() or CFG.GCKeywords
            if #keywords == 0 then keywords = CFG.GCKeywords end

            local ignore = {}
            for _, t in ipairs({ CFG, CFG.GCKeywords, keywords, INDEX, INDEX.all, INDEX.remotes, INDEX.scripts, INDEX.values,
                INDEX.attrs, SCAN, W, W.files, W.all, LOG, LOG.lines, KW, NAME_MEMO, scriptList, scriptSet, loadedMods,
                loadedList, counts, errors, timings, ENV, _G, shared, RENV, gc, APP, CAP }) do
                if type(t) == "table" then ignore[t] = true end
            end

            local function scoreTable(tbl)
                local nk, nf, kw = 0, 0, 0
                local okk = pcall(function()
                    for k, val in next, tbl do
                        nk += 1
                        if type(val) == "function" then nf += 1 end
                        if type(k) == "string" then
                            local lk = k:lower()
                            for _, word in ipairs(keywords) do
                                if lk:find(word, 1, true) then
                                    kw += 1
                                    break
                                end
                            end
                        end
                        if nk > 400 then break end
                    end
                end)
                if not okk then return 0, 0 end
                return nk, nf * 2 + kw * 5
            end

            local byOwner, ownerKeys, cands = {}, {}, {}
            local totalGC = #gc
            for i, v in ipairs(gc) do
                U.pace()
                local t = type(v)
                if t == "function" then
                    if isL(v) and not isExec(v) then
                        local owner = U.ownerOf(v) or "<unknown>"
                        local core = owner:find("^CoreGui") or owner:find("^CorePackages")
                            or owner:find("^%[NIL%] CoreGui") or owner:find("^%[NIL%] CorePackages")
                        if (CFG.DumpCore or not core) and (not scoped or (owner ~= "<unknown>" and SC.str(owner))) then
                            local bucket = byOwner[owner]
                            if not bucket then
                                bucket = {}
                                byOwner[owner] = bucket
                                ownerKeys[#ownerKeys + 1] = owner
                            end
                            bucket[#bucket + 1] = v
                        end
                    end
                elseif t == "table" and not ignore[v] then
                    local nk, score = scoreTable(v)
                    if nk >= 3 and score > 0 then
                        cands[#cands + 1] = { tbl = v, score = score, nk = nk }
                        if #cands > CFG.MaxGCTables * 4 then
                            table.sort(cands, function(a, b) return a.score > b.score end)
                            for j = #cands, CFG.MaxGCTables + 1, -1 do cands[j] = nil end
                        end
                    end
                end
                if i % 5000 == 0 then sub(i / totalGC * 0.7, ("gc scan %d/%d"):format(i, totalGC)) end
            end

            table.sort(ownerKeys)
            local fw = W.new("gc_functions")
            for oi, owner in ipairs(ownerKeys) do
                U.pace()
                local b = byOwner[owner]
                fw.add(("## %s (%d fungsi)"):format(owner, #b))
                for j, f in ipairs(b) do
                    if j > CFG.MaxFuncsPerOwner then
                        fw.add(("  ... (+%d lagi)"):format(#b - j + 1))
                        break
                    end
                    fw.add("  " .. U.fnDesc(f, true) .. U.constSummary(f) .. U.upvalSummary(f))
                end
                counts.gcFuncs += #b
                byOwner[owner] = nil
                if oi % 20 == 0 then sub(0.7 + 0.2 * oi / #ownerKeys, "gc tulis fungsi") end
            end
            fw.close()

            table.sort(cands, function(a, b) return a.score > b.score end)
            local tw = W.new("gc_tables")
            for i = 1, math.min(#cands, CFG.MaxGCTables) do
                U.pace()
                local c = cands[i]
                tw.add(("=== tabel #%d  (keys=%d score=%d)"):format(i, c.nk, c.score))
                tw.add(U.ser(c.tbl, 3, {}, ""))
                tw.add("")
                counts.gcTables += 1
            end
        end)

        -- 7. remote + handler client-nya
        phase("remotes", M.remotes, function()
            local w = W.new("remotes")
            U.each(INDEX.remotes, function(r)
                if not SC.inst(r) then return end
                local cls = r.ClassName
                w.add(("[%s] %s"):format(cls, U.path(r)))
                counts.remotes += 1
                if CAP.getconnections then
                    local sig
                    if cls == "RemoteEvent" or cls == "UnreliableRemoteEvent" then
                        sig = r.OnClientEvent
                    elseif cls == "BindableEvent" then
                        sig = r.Event
                    end
                    if sig then
                        local okc, conns = pcall(CAP.getconnections, sig)
                        if okc and type(conns) == "table" then
                            for _, c in ipairs(conns) do
                                local okf, fn = pcall(function() return c.Function end)
                                if okf and type(fn) == "function" then
                                    w.add("    handler: " .. U.fnDesc(fn) .. U.constSummary(fn) .. U.upvalSummary(fn))
                                else
                                    w.add("    handler: <foreign/C>")
                                end
                            end
                        end
                    end
                end
                if cls == "RemoteFunction" and CAP.getcallbackvalue then
                    local okb, cb = pcall(CAP.getcallbackvalue, r, "OnClientInvoke")
                    if okb and type(cb) == "function" then
                        w.add("    OnClientInvoke: " .. U.fnDesc(cb) .. U.constSummary(cb) .. U.upvalSummary(cb))
                    end
                end
            end)
        end)

        -- 8. saveinstance bawaan executor
        phase("saveinstance", M.saveinstance and CAP.saveinstance, function()
            CAP.saveinstance({ FileName = "DumpPP_" .. W.gname, NilInstances = true, DecompileScripts = true })
        end)
    end)
    if not ok then
        errors[#errors + 1] = "dump: " .. tostring(err)
        LOG.add(err == "dihentikan" and "warn" or "error", "dump berhenti: " .. tostring(err))
    end

    -- info + manifest + error log
    pcall(function()
        local capMap, caps = {}, {}
        for _, n in ipairs(CAPLIST) do
            capMap[n] = CAP[n] ~= nil
            caps[#caps + 1] = ("  %-18s %s"):format(n, CAP[n] and "ada" or "TIDAK ADA")
        end
        local I = SCAN.info
        local info = {
            "Dumper++ : v" .. VERSION, "PlaceId  : " .. tostring(game.PlaceId), "GameId   : " .. tostring(game.GameId),
            "JobId    : " .. tostring(game.JobId), "Versi    : " .. tostring(game.PlaceVersion),
            "Game     : " .. W.gname, "Waktu    : " .. os.date("%Y-%m-%d %H:%M:%S"), "Executor : " .. tostring(I.executor),
            "Scope    : " .. (scoped and table.concat(selNames, ", ") or "seluruh game"),
            "Sistem   : " .. (function()
                local n = {}
                for _, s in ipairs(SCAN.systems) do n[#n + 1] = ("%s(%d)"):format(s.id, s.score) end
                return table.concat(n, ", ")
            end)(),
            "Framework: " .. table.concat(SCAN.frameworks, ", "), "",
        }
        for k, v in next, counts do info[#info + 1] = ("%-12s : %d"):format(k, v) end
        info[#info + 1] = ""
        info[#info + 1] = "Durasi fase (detik):"
        for n, t in next, timings do info[#info + 1] = ("  %-16s %s"):format(n, tostring(t)) end
        info[#info + 1] = ""
        info[#info + 1] = "Kemampuan executor:"
        info[#info + 1] = table.concat(caps, "\n")
        CAP.writefile(ROOT .. "/_info.txt", table.concat(info, "\n"))

        if HttpService then
            CAP.writefile(ROOT .. "/manifest.json", HttpService:JSONEncode({
                version = VERSION, placeId = game.PlaceId, gameId = game.GameId, placeVersion = game.PlaceVersion,
                game = W.gname, executor = I.executor, scope = scoped and selNames or "all",
                systems = SCAN.systems, frameworks = SCAN.frameworks, scanInfo = I, counts = counts,
                timings = timings, capabilities = capMap, errors = errors,
            }))
        end
        if #errors > 0 then CAP.writefile(ROOT .. "/_errors.txt", table.concat(errors, "\n")) end
    end)
    W.flushAll()

    D.status(APP.cancel and "dihentikan -> workspace/" .. ROOT or "selesai -> workspace/" .. ROOT, 1)
    if CAP.setclipboard then pcall(CAP.setclipboard, "workspace/" .. ROOT) end
    D.running, APP.cancel = false, false
end

---------------------------------------------------------------------
-- 5. LIVE MONITOR (remote IN/OUT, value, attribute, instance) + log file realtime
---------------------------------------------------------------------
local L = {
    on = false, q = {}, qh = 0, qt = 0, dropped = 0, conns = {}, feed = {}, stats = {},
    muted = {}, win = {}, winT = 0, watched = setmetatable({}, { __mode = "k" }),
    hooked = setmetatable({}, { __mode = "k" }), last = setmetatable({}, { __mode = "k" }),
    pathMemo = setmetatable({}, { __mode = "k" }), watchN = 0, epoch = os.time() - os.clock(),
}

local SEND = { FireServer = true, InvokeServer = true, fireServer = true, invokeServer = true }
local LIVE_CLASS = {
    Model = true, Tool = true, Folder = true, Configuration = true, ScreenGui = true, ModuleScript = true,
    LocalScript = true, Script = true, Humanoid = true, ProximityPrompt = true, ClickDetector = true,
}
for c, k in next, KIND do if k == "remote" or k == "value" then LIVE_CLASS[c] = true end end

local function ensureHook()
    if ENV.DumperPP_HookInstalled then return true end
    if not (CAP.hookmetamethod and CAP.getnamecallmethod) then return false end
    local wrap = CAP.newcclosure or function(f) return f end
    local old
    local ok = pcall(function()
        old = CAP.hookmetamethod(game, "__namecall", wrap(function(self, ...)
            local sink = ENV.DumperPP_Sink
            if sink then
                local m = CAP.getnamecallmethod()
                if SEND[m] then sink(self, m, ...) end
                if CAP.setnamecallmethod then CAP.setnamecallmethod(m) end
            end
            return old(self, ...)
        end))
    end)
    if ok and old then
        ENV.DumperPP_HookInstalled = true
        return true
    end
    return false
end

local function qpush(item)
    if L.qt - L.qh >= CFG.LiveQueueMax then
        L.dropped += 1
        return
    end
    L.qt += 1
    L.q[L.qt] = item
end

-- dipanggil dari dalam hook: kerja minimal, serialisasi dilakukan di loop
function L.sink(self, m, ...)
    if typeof(self) ~= "Instance" then return end
    if not CFG.LiveIncludeExecutor and CAP.checkcaller and CAP.checkcaller() then return end
    qpush({ "OUT", m, self, table.pack(...), os.clock() })
end

function L.hookIn(r)
    if L.hooked[r] then return end
    local cls = r.ClassName
    if cls ~= "RemoteEvent" and cls ~= "UnreliableRemoteEvent" then return end
    L.hooked[r] = true
    local okc, c = pcall(function()
        return r.OnClientEvent:Connect(function(...)
            qpush({ "IN ", "OnClientEvent", r, table.pack(...), os.clock() })
        end)
    end)
    if okc and c then L.conns[#L.conns + 1] = c end
end

function L.watchValue(v)
    if L.watched[v] or L.watchN >= CFG.LiveMaxWatch or not SC.inst(v) then return end
    local ok, cur = pcall(function() return v.Value end)
    if not ok then return end
    L.watched[v], L.last[v] = true, cur
    L.watchN += 1
    local c = v.Changed:Connect(function(new)
        local old = L.last[v]
        L.last[v] = new
        qpush({ "VAL", "Value", v, { old, new, n = 2 }, os.clock() })
    end)
    L.conns[#L.conns + 1] = c
end

function L.watchAttr(inst)
    if L.watched[inst] or L.watchN >= CFG.LiveMaxWatch or not SC.inst(inst) then return end
    local ok, snap = pcall(inst.GetAttributes, inst)
    if not ok or type(snap) ~= "table" then return end
    L.watched[inst], L.last[inst] = true, snap
    L.watchN += 1
    local c = inst.AttributeChanged:Connect(function(name)
        local new = inst:GetAttribute(name)
        local s = L.last[inst]
        local old = s[name]
        s[name] = new
        qpush({ "ATR", name, inst, { old, new, n = 2 }, os.clock() })
    end)
    L.conns[#L.conns + 1] = c
end

function L.onAdded(d)
    local cls = d.ClassName
    if not LIVE_CLASS[cls] then return end
    local o = CFG.Live
    local kind = KIND[cls]
    if o.remotes and kind == "remote" then L.hookIn(d) end
    if o.values and kind == "value" then L.watchValue(d) end
    if o.instances then qpush({ "ADD", cls, d, { cls, n = 1 }, os.clock() }) end
end
function L.onRemoving(d)
    local cls = d.ClassName
    if LIVE_CLASS[cls] then qpush({ "DEL", cls, d, { cls, n = 1 }, os.clock() }) end
end

local function oneLine(s, n)
    s = s:gsub("%s*\n%s*", " ")
    return #s > n and (s:sub(1, n) .. "...") or s
end

function L.emit(kind, line, detail, j, t)
    local wall = L.epoch + t
    local stamp = ("%s.%03d"):format(os.date("%H:%M:%S", math.floor(wall)), math.floor((wall % 1) * 1000))
    local text = ("%s [%s] %s"):format(stamp, kind, line)
    if L.wLog then
        L.wLog.add(text)
        if detail and detail ~= "" then L.wLog.add("    " .. detail:gsub("\n", "\n    ")) end
    end
    if L.wJson and HttpService and j then
        j.t, j.kind = math.floor(wall * 1000) / 1000, kind
        local ok, enc = pcall(HttpService.JSONEncode, HttpService, j)
        if ok then L.wJson.add(enc) end
    end
    L.stats[kind] = (L.stats[kind] or 0) + 1
    if #L.feed < 600 then L.feed[#L.feed + 1] = { kind = kind, line = text, detail = detail or text } end
end

function L.process(it)
    local kind, name, inst, args, t = it[1], it[2], it[3], it[4], it[5]
    if not SC.inst(inst) then return end
    local p = L.pathMemo[inst]
    if not p then
        p = U.path(inst)
        L.pathMemo[inst] = p
    end
    local key = kind .. p .. (kind == "ATR" and name or "")
    if L.muted[key] then return end
    local c = (L.win[key] or 0) + 1
    L.win[key] = c
    if c > CFG.LiveSpamPerSec then
        L.muted[key] = true
        L.emit("NOTE", ("auto-mute (>%d/detik): %s"):format(CFG.LiveSpamPerSec, p), nil, nil, t)
        return
    end

    local parts = {}
    local depth = (kind == "OUT" or kind == "IN ") and CFG.LiveArgDepth or 2
    for i = 1, args.n do parts[i] = U.ser(args[i], depth, {}, "") end

    if kind == "OUT" or kind == "IN " then
        L.emit(kind, ("%-12s %s  %s"):format(name, p, oneLine(table.concat(parts, ", "), 140)),
            p .. "\n" .. table.concat(parts, "\n"), { dir = kind, method = name, path = p, args = parts }, t)
    elseif kind == "VAL" then
        L.emit(kind, ("%s: %s -> %s"):format(p, oneLine(parts[1], 60), oneLine(parts[2], 60)), nil,
            { path = p, old = parts[1], new = parts[2] }, t)
    elseif kind == "ATR" then
        L.emit(kind, ("%s @%s: %s -> %s"):format(p, name, oneLine(parts[1], 60), oneLine(parts[2], 60)), nil,
            { path = p, attr = name, old = parts[1], new = parts[2] }, t)
    else
        L.emit(kind, ("%s (%s)"):format(p, name), nil, { path = p, class = name }, t)
    end
end

function L.loop()
    local lastFlush = os.clock()
    while L.on and not APP.dead do
        task.wait(0.12)
        if os.clock() - L.winT >= 1 then L.win, L.winT = {}, os.clock() end
        local t0 = os.clock()
        while L.qh < L.qt and os.clock() - t0 < 0.01 do
            L.qh += 1
            local it = L.q[L.qh]
            L.q[L.qh] = nil
            pcall(L.process, it)
        end
        if L.qh >= L.qt then L.qh, L.qt = 0, 0 end
        if os.clock() - lastFlush >= CFG.LiveFlushSec then
            lastFlush = os.clock()
            if L.wLog then L.wLog.close() end
            if L.wJson then L.wJson.close() end
        end
    end
    if L.wLog then L.wLog.close() end
    if L.wJson then L.wJson.close() end
end

function L.start()
    if L.on then return end
    if not SCAN.done then LOG.add("warn", "scan belum selesai") return end
    L.on, L.epoch = true, os.time() - os.clock()
    L.q, L.qh, L.qt, L.dropped, L.stats, L.feed = {}, 0, 0, 0, {}, {}
    L.muted, L.win, L.winT, L.watchN = {}, {}, os.clock(), 0
    L.wLog, L.wJson = nil, nil
    if CAN_WRITE then
        L.wLog = W.new("events", "log", "live")
        L.wJson = (CFG.LiveJSONL and HttpService) and W.new("events", "jsonl", "live") or nil
    else
        LOG.add("warn", "tanpa writefile: live tidak disimpan ke file (hanya tampil di UI)")
    end
    local o = CFG.Live
    if o.remotes then
        ENV.DumperPP_Sink = L.sink
        if not ensureHook() then LOG.add("warn", "hookmetamethod tidak tersedia: live hanya menangkap remote IN") end
        for _, r in ipairs(INDEX.remotes) do L.hookIn(r) end
    end
    if o.values then
        for _, v in ipairs(INDEX.values) do L.watchValue(v) end
        for _, a in ipairs(INDEX.attrs) do L.watchAttr(a) end
    end
    L.conns[#L.conns + 1] = game.DescendantAdded:Connect(L.onAdded)
    if o.instances then L.conns[#L.conns + 1] = game.DescendantRemoving:Connect(L.onRemoving) end
    task.spawn(L.loop)
    LOG.add("info", ("live aktif | scope: %s | diawasi: %d | log: %s/live"):format(
        SC.active() and "sistem terpilih" or "seluruh game", L.watchN, W.root or "-"))
end

function L.stop()
    if not L.on then return end
    L.on = false
    ENV.DumperPP_Sink = nil
    for _, c in ipairs(L.conns) do pcall(function() c:Disconnect() end) end
    L.conns, L.hooked, L.watched = {}, setmetatable({}, { __mode = "k" }), setmetatable({}, { __mode = "k" })
    task.delay(0.3, function() W.flushAll() end)
    LOG.add("info", "live dihentikan, log tersimpan")
end
onCleanup(function() L.on = false end)
onCleanup(function() for _, c in ipairs(L.conns) do pcall(function() c:Disconnect() end) end end)

