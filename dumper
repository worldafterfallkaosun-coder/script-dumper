                AnchorPoint = Vector2.new(0, 1), Position = UDim2.new((i - 1) / SPARK_N, 0, 1, -2), Size = UDim2.new(1 / SPARK_N, -1, 0, 2),
                BackgroundColor3 = T.good, BorderSizePixel = 0, Visible = false,
            }, area)
        end
        return { bars = bars, cur = cur }
    end
    local function drawSpark(sp, arr, head, count, vmax, colorFn)
        for k = 1, SPARK_N do
            local bar = sp.bars[k]
            local age = SPARK_N - k
            if age < count then
                local v = arr[(head - age - 1) % SPARK_N + 1] or 0
                bar.Size = UDim2.new(1 / SPARK_N, -1, 0, math.floor(2 + math.clamp(v / vmax, 0, 1) * 38))
                bar.BackgroundColor3 = colorFn(v)
                bar.Visible = true
            else
                bar.Visible = false
            end
        end
    end

