phase("senv", CFG.DumpSenv and getsenv, function()
    local w = newWriter("senv")
    each(scriptList, function(s)
        if (s:IsA("LocalScript") or loadedMods[s]) and (CFG.DumpCore or not isCore(s)) then
            local ok, env = pcall(getsenv, s)
            if ok and type(env) == "table" and next(env) ~= nil then
                w.add("=== " .. path(s))
                w.add(ser(env, 2, {}, ""))
                w.add("")
                counts.senv += 1
            end
        end
    end)
end)

---------------------------------------------------------------------
-- 6. garbage collector: fungsi game + tabel "sistem"
---------------------------------------------------------------------
phase("gc", CFG.DumpGC and getgc, function()
    local gc = getgc(true)
    local isL = islclosure or function() return true end
    local isExec = isexecutorclosure or function() return false end

    -- tabel milik dumper sendiri jangan ikut kebaca
    local ignore = {}
    local function ig(t) if type(t) == "table" then ignore[t] = true end end
    for _, t in ipairs({ CFG, CFG.GCKeywords, scriptList, scriptSet, remotes, loadedMods, loadedList,
        counts, errors, timings, REMOTE_CLASSES, ownerCache, writers, ENV, _G, shared, RENV, gc }) do
        ig(t)
    end

    local function scoreTable(tbl)
        local nk, nf, kw = 0, 0, 0
        local ok = pcall(function()
            for k, val in next, tbl do
                nk += 1
                if type(val) == "function" then nf += 1 end
                if type(k) == "string" then
                    local lk = k:lower()
                    for _, word in ipairs(CFG.GCKeywords) do
                        if lk:find(word, 1, true) then
                            kw += 1
                            break
                        end
                    end
                end
                if nk > 400 then break end
            end
        end)
        if not ok then return 0, 0 end
        return nk, nf * 2 + kw * 5
    end

    local byOwner, ownerKeys, cands = {}, {}, {}
    local total = #gc

    for i, v in ipairs(gc) do
        pace()
        local t = type(v)
        if t == "function" then
            if isL(v) and not isExec(v) then
                local owner = ownerOf(v) or "<unknown>"
                local core = owner:find("^CoreGui") or owner:find("^CorePackages")
                    or owner:find("^%[NIL%] CoreGui") or owner:find("^%[NIL%] CorePackages")
                if CFG.DumpCore or not core then
                    local bucket = byOwner[owner]
                    if not bucket then
                        bucket = {}
                        byOwner[owner] = bucket
                        ownerKeys[#ownerKeys + 1] = owner
                    end
                    bucket[#bucket + 1] = v -- simpan referensi, string dibuat belakangan
                end
            end
        elseif t == "table" and not ignore[v] then
            local nk, score = scoreTable(v)
            if nk >= 3 and score > 0 then
                cands[#cands + 1] = { tbl = v, score = score, nk = nk }
                if #cands > CFG.MaxGCTables * 4 then
                    table.sort(cands, function(a, b) return a.score > b.score end)
                    for j = #cands, CFG.MaxGCTables + 1, -1 do cands[j] = nil end
                end
            end
        end
        if i % 5000 == 0 then sub(i / total * 0.7, ("gc scan %d/%d"):format(i, total)) end
    end

    table.sort(ownerKeys)
    local fw = newWriter("gc_functions")
    for oi, owner in ipairs(ownerKeys) do
        pace()
        local b = byOwner[owner]
        fw.add(("## %s (%d fungsi)"):format(owner, #b))
        for j, f in ipairs(b) do
            if j > CFG.MaxFuncsPerOwner then
                fw.add(("  ... (+%d lagi)"):format(#b - j + 1))
                break
            end
            fw.add("  " .. fnDesc(f, true) .. constSummary(f) .. upvalSummary(f))
        end
        counts.gcFuncs += #b
        byOwner[owner] = nil
        if oi % 20 == 0 then sub(0.7 + 0.2 * oi / #ownerKeys, "gc tulis fungsi") end
    end
    fw.close()

    table.sort(cands, function(a, b) return a.score > b.score end)
    local tw = newWriter("gc_tables")
    for i = 1, math.min(#cands, CFG.MaxGCTables) do
        pace()
        local c = cands[i]
        tw.add(("=== tabel #%d  (keys=%d score=%d)"):format(i, c.nk, c.score))
        tw.add(ser(c.tbl, 3, {}, ""))
        tw.add("")
        counts.gcTables += 1
    end
end)

