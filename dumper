    end, { Size = UDim2.new(0.25, -3, 1, 0), TextSize = 12 })
    local statLbl = ordered(ctl, label(ctl, "live belum aktif | log: live/events.log + events.jsonl", { Size = UDim2.new(1, 0, 0, 16), TextSize = 11, TextColor3 = T.dim, Font = Enum.Font.Code, TextWrapped = false }))

    feedFrame = new("ScrollingFrame", {
        Size = UDim2.new(1, -16, 1, -190), Position = UDim2.new(0, 8, 0, 182), BackgroundColor3 = T.panel, BorderSizePixel = 0,
        ScrollBarThickness = 3, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
    }, lv)
