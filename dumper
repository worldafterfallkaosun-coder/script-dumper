local LOG = { lines = {}, errors = {}, pending = {} }
local W = { root = nil, gname = "Game", files = {}, all = {} }

function LOG.add(level, msg)
    msg = tostring(msg)
    if level == "warn" or level == "error" then warn("[Dumper++] " .. msg) else print("[Dumper++] " .. msg) end
    if level == "error" then LOG.errors[#LOG.errors + 1] = msg end
    local e = { level = level, text = ("%s [%s] %s"):format(os.date("%H:%M:%S"), level:upper():sub(1, 4), msg) }
    LOG.lines[#LOG.lines + 1] = e
    if #LOG.lines > 400 then table.remove(LOG.lines, 1) end
    if LOG.w then LOG.w.add(e.text) else LOG.pending[#LOG.pending + 1] = e.text end
    if LOG.onAdd then pcall(LOG.onAdd, e) end
end

function W.ensureRoot()
    if W.root then return W.root end
    local base = ("DumpPP/%d_%s"):format(game.PlaceId, W.gname)
    W.root = ("%s/%s"):format(base, os.date("%Y%m%d_%H%M%S"))
    if CAN_WRITE then
        pcall(CAP.makefolder, "DumpPP")
        pcall(CAP.makefolder, base)
        pcall(CAP.makefolder, W.root)
    end
    LOG.w = W.new("_session", "log")
    for _, l in ipairs(LOG.pending) do LOG.w.add(l) end
    LOG.pending = {}
    return W.root
end

function W.newRoot()
    W.root, LOG.w, W.files = nil, nil, {}
end

function W.new(name, ext, sub)
    ext = ext or "txt"
    local root = W.ensureRoot()
    local dir = root
    if sub then
        dir = root .. "/" .. sub
        if CAN_WRITE then pcall(CAP.makefolder, dir) end
    end
    local part, bytes, buf, n = 1, 0, {}, 0
    local function fname()
        if part == 1 then return ("%s/%s.%s"):format(dir, name, ext) end
        return ("%s/%s.part%d.%s"):format(dir, name, part, ext)
    end
    local current = fname()
    if CAN_WRITE then pcall(CAP.writefile, current, "") end
    W.files[#W.files + 1] = current

    local w = { bytes = 0 }
    local function flush()
        if n > 0 then
            if CAN_WRITE then pcall(CAP.appendfile, current, table.concat(buf, "\n", 1, n) .. "\n") end
            buf, n = {}, 0
        end
    end
    function w.add(line)
        n += 1
        buf[n] = line
        bytes += #line + 1
        w.bytes += #line + 1
        if n >= 300 then flush() end
        if bytes >= CFG.MaxFileBytes then
            flush()
            part += 1
            bytes = 0
            current = fname()
            if CAN_WRITE then pcall(CAP.writefile, current, "") end
            W.files[#W.files + 1] = current
        end
    end
    w.close = flush
    W.all[#W.all + 1] = w
    return w
end

function W.flushAll()
    for _, w in ipairs(W.all) do pcall(w.close) end
end

