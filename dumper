    toggle(dp, "Sertakan CoreGui / CorePackages", function() return CFG.DumpCore end, function(v) CFG.DumpCore = v end)

    local dumpBtn
    dumpBtn = ordered(dp, button(dp, CAN_WRITE and "MULAI DUMP" or "DUMP BUTUH writefile", function()
        if D.running then
            APP.cancel = true
            setStatus("menghentikan...", nil, T.warn)
            return
