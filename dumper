local SRC = {
    mem = setmetatable({}, { __mode = "k" }), byHash = {}, failed = setmetatable({}, { __mode = "k" }),
    hits = 0, miss = 0, disk = 0, dirOk = false,
}
local CACHE_DIR = "DumpPP/cache"

function SRC.hashOf(s)
    if not CAP.getscripthash then return nil end
    local ok, h = pcall(CAP.getscripthash, s)
    if ok and h then return (tostring(h):gsub("[^%w]", "")) end
    return nil
end

local function cacheFile(hash) return CACHE_DIR .. "/" .. hash .. ".lua" end

-- hasil decompile yang isinya cuma pesan gagal tidak boleh masuk cache disk
local function looksFailed(r)
    if #r > 600 then return false end
    local l = r:lower()
    return (l:find("failed", 1, true) or l:find("timed out", 1, true) or l:find("timeout", 1, true)
        or (l:find("decompil", 1, true) and l:find("error", 1, true))) and true or false
end

-- return: body, real, alasanGagal
function SRC.get(s)
    local m = SRC.mem[s]
    if m then
        SRC.hits += 1
        return m.body, true
    end
    if not (CFG.DecompileScripts and CAP.decompile) then return nil, false, "decompile mati" end
    local f = SRC.failed[s]
    if f and os.clock() - f.t < 60 then return nil, false, f.why end

    local hash = SRC.hashOf(s)
    if hash then
        local b = SRC.byHash[hash]
        if b then
            SRC.mem[s] = b
            SRC.hits += 1
            return b.body, true
        end
        if CFG.DecompileCache and CAP.isfile and CAP.readfile then
            local okc, body = pcall(function()
                local p = cacheFile(hash)
                if CAP.isfile(p) then return CAP.readfile(p) end
            end)
            if okc and type(body) == "string" and #body > 0 then
                local b2 = { body = body }
                SRC.mem[s], SRC.byHash[hash] = b2, b2
                SRC.disk += 1
                return body, true
            end
        end
    end

    SRC.miss += 1
    local ok, r = U.withTimeout(CAP.decompile, CFG.ScriptTimeout, s)
    if ok and type(r) == "string" and #r > 0 then
        local b = { body = r }
        SRC.mem[s] = b
        if hash then
            SRC.byHash[hash] = b
            if CFG.DecompileCache and CAN_WRITE and not looksFailed(r) then
                pcall(function()
                    if not SRC.dirOk then
                        pcall(CAP.makefolder, "DumpPP")
                        pcall(CAP.makefolder, CACHE_DIR)
                        SRC.dirOk = true
                    end
                    CAP.writefile(cacheFile(hash), r)
                end)
            end
        end
        return r, true
    end
    local why = tostring(ok and "hasil kosong" or r)
    SRC.failed[s] = { t = os.clock(), why = why }
    return nil, false, why
end

-- iterasi baris (nomor baris akurat, baris kosong ikut dihitung). fn(line, no) -> true = berhenti
function SRC.eachLine(body, fn)
    local pos, ln = 1, 0
    while true do
        local e = body:find("\n", pos, true)
        ln += 1
        if fn(body:sub(pos, (e or 0) - 1), ln) then return end
        if not e then return end
        pos = e + 1
        if ln % 3000 == 0 then U.pace() end
    end
end

