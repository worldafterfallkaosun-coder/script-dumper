		if not skipKeys[k] and (t == "number" or t == "boolean" or t == "string" or t == "EnumItem") then
			SAVE_KEYS[#SAVE_KEYS + 1] = k
		end
	end
	SAVE_KEYS[#SAVE_KEYS + 1] = "PingOverride" -- nil di CFG bawaan, tapi boleh diisi dari UI
	table.sort(SAVE_KEYS)
