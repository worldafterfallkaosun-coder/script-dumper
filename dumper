-- 4. return ModuleScript yang sudah ke-load (dengan timeout)
---------------------------------------------------------------------
phase("modules_return", CFG.DumpModuleReturn and getloadedmodules, function()
    local w = newWriter("modules_return")
    each(loadedList, function(m)
        if CFG.DumpCore or not isCore(m) then
            local ok, ret = withTimeout(require, CFG.RequireTimeout, m)
            w.add("=== " .. path(m))
            w.add(ok and ser(ret, CFG.MaxDepth, {}, "") or ("<require gagal: " .. tostring(ret) .. ">"))
            w.add("")
            counts.modules += 1
        end
    end)
end)

