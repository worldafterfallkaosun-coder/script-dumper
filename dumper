    end, { Size = UDim2.new(0.25, -3, 1, 0), TextSize = 12 })
    local feedFrame
    button(brow, "Bersihkan", function()
        for _, c in ipairs(feedFrame:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
    end, { Size = UDim2.new(0.25, -3, 1, 0), TextSize = 12 })
