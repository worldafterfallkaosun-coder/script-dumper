--[[
    DUMPER++ v2 "Overdrive"  |  Roblox deep dumper (Luau / executor)

    Butuh   : executor dengan writefile / appendfile / makefolder.
              Fungsi lain (getinstances, getgc, decompile, dst) opsional —
              kalau tidak ada, fasenya dilewati otomatis.
    Output  : workspace/DumpPP/<PlaceId>_<NamaGame>/<tanggal_jam>/
    Isi     : manifest.json, _info.txt, _errors.txt, class_stats.txt,
              instances.txt, nil_instances.txt, values.txt, attributes.txt,
              tags.txt, scripts/, modules_return.txt, senv.txt,
              gc_functions.txt, gc_tables.txt, remotes.txt,
              remote_calls.txt (opsional, CaptureSeconds > 0)

    Config tanpa edit file : getgenv().DumperPP_Config = { DecompileWorkers = 8, CaptureSeconds = 30 }
    Stop darurat           : getgenv().DumperPP_Stop = true
    Kalau nyangkut "masih jalan" : getgenv().DumperPP_Running = nil

    Catatan : kode SERVER (ServerScriptService, ServerStorage, Script server) tidak
              pernah dikirim ke client, jadi tidak bisa di-dump dari sisi client.
]]

local CFG = {
    -- fitur
    DecompileScripts = true,   -- decompile semua script (fallback: constants/protos)
    DumpBytecode     = false,  -- simpan bytecode mentah tiap script (getscriptbytecode)
    DumpModuleReturn = true,   -- isi return ModuleScript yang SUDAH ke-load
    DumpSenv         = true,   -- environment (global/fungsi) script yang sedang jalan
    DumpGC           = true,   -- scan garbage collector (fungsi + tabel sistem)
    DumpRemotes      = true,   -- remote + handler client-nya
    DumpTags         = true,   -- CollectionService tags
    DumpValues       = true,   -- ValueBase (IntValue, StringValue, ...) + Attributes
    DumpCore         = false,  -- ikutkan CoreGui/CorePackages (berisik)
    CaptureSeconds   = 0,      -- >0 = log pasif panggilan remote (IN & OUT) selama N detik
    SaveInstance     = false,  -- panggil saveinstance() bawaan executor di akhir

    -- performa
    DecompileWorkers = 4,      -- decompile paralel
    ScriptTimeout    = 10,     -- detik per script saat decompile
    RequireTimeout   = 3,      -- detik per module saat require
    FrameBudget      = 0.012,  -- detik kerja per frame sebelum yield
    MaxFileBytes     = 4 * 1024 * 1024, -- file dipecah jadi .partN kalau lewat ini

    -- serializer
    MaxDepth         = 5,
    MaxTableKeys     = 200,
    MaxStringLen     = 300,
    MaxGCTables      = 500,
    MaxFuncsPerOwner = 600,
    MaxCaptured      = 20000,
    GCKeywords       = {
        "inventory", "damage", "cooldown", "stats", "config", "remote",
        "network", "data", "state", "service", "controller", "manager",
        "weapon", "item", "shop", "currency", "quest", "skill", "ability",
    },
}

