local ORD = setmetatable({}, { __mode = "k" })
local function ordered(parent, o)
    ORD[parent] = (ORD[parent] or 0) + 1
    o.LayoutOrder = ORD[parent]
    return o
end
local function new(class, props, parent)
    local o = Instance.new(class)
    for k, v in next, props or {} do o[k] = v end
    o.Parent = parent
    return o
end
local function corner(o, r) return new("UICorner", { CornerRadius = UDim.new(0, r or 6) }, o) end
local function label(parent, txt, props)
    local p = {
        BackgroundTransparency = 1, Text = txt, Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = T.text,
        TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true,
    }
    for k, v in next, props or {} do p[k] = v end
    return new("TextLabel", p, parent)
end
local function button(parent, txt, cb, props)
    local p = {
        Text = txt, Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = T.text,
        BackgroundColor3 = T.panel2, BorderSizePixel = 0, AutoButtonColor = true,
    }
    for k, v in next, props or {} do p[k] = v end
    local b = new("TextButton", p, parent)
    corner(b, 6)
    b.Activated:Connect(function()
        local ok, err = pcall(cb, b)
        if not ok then LOG.add("error", "ui: " .. tostring(err)) end
