phase("tags", CFG.DumpTags, function()
    local CS = svc("CollectionService")
    local w = newWriter("tags")
    for _, tag in ipairs(CS:GetAllTags()) do
        pace()
        local items = CS:GetTagged(tag)
        w.add(("## %s (%d)"):format(tag, #items))
        for i, inst in ipairs(items) do
            if i > 50 then
                w.add("  ...")
                break
            end
            w.add("  " .. path(inst))
        end
        counts.tags += 1
    end
end)

---------------------------------------------------------------------
-- 3. script + module: decompile paralel, dedup by hash
---------------------------------------------------------------------
phase("scripts", true, function()
    if getscripts then
        for _, s in ipairs(getscripts()) do addScript(s) end
    end
    if getloadedmodules then
        for _, m in ipairs(getloadedmodules()) do
            loadedMods[m] = true
            loadedList[#loadedList + 1] = m
            addScript(m)
        end
    end

    -- pass 1: metadata + deteksi duplikat (script identik cuma di-decompile sekali)
    local meta, jobs, primaryOf = {}, {}, {}
    for _, s in ipairs(scriptList) do
        pace()
        if CFG.DumpCore or not isCore(s) then
            local i = #meta + 1
            local p = path(s)
            local hash
            if getscripthash then
                local ok, h = pcall(getscripthash, s)
                if ok and h then hash = tostring(h) end
            end
            local fname = ("%04d_%s.lua"):format(i, (p:gsub("[^%w_%.%-]", "_")):sub(-90))
            local m = { s = s, p = p, hash = hash, fname = fname, cls = s.ClassName }
            meta[i] = m
            local primary = hash and primaryOf[hash]
            if primary then
                m.dupOf = primary
                primary.copies = (primary.copies or 1) + 1
                counts.dups += 1
            else
                if hash then primaryOf[hash] = m end
                jobs[#jobs + 1] = m
            end
        end
    end

    local function process(m)
        local s = m.s
        local body
        if CFG.DecompileScripts and decompile then
            local ok, r = withTimeout(decompile, CFG.ScriptTimeout, s)
            if ok and type(r) == "string" and #r > 0 then
                body = r
            else
                body = "-- decompile gagal: " .. tostring(ok and "hasil kosong" or r)
                    .. "\n" .. fallbackBody(s)
            end
        else
            body = fallbackBody(s)
        end

        local extra = ""
        pcall(function()
            if s:IsA("BaseScript") then
                extra = ("-- Enabled   : %s\n-- RunContext: %s\n"):format(
                    tostring(s.Enabled), tostring(s.RunContext))
            end
        end)

        local header = ("-- Path      : %s\n-- Class     : %s\n-- Hash      : %s\n-- Loaded    : %s\n-- Copies    : %d\n%s\n"):format(
            m.p, m.cls, m.hash or "?", tostring(loadedMods[s] == true), m.copies or 1, extra)
        writefile(ROOT .. "/scripts/" .. m.fname, header .. body)

        if CFG.DumpBytecode and getscriptbytecode then
            local okb, bc = pcall(getscriptbytecode, s)
            if okb and type(bc) == "string" then
                local bname = (m.fname:gsub("%.lua$", ".bin"))
                pcall(writefile, ROOT .. "/bytecode/" .. bname, bc)
            end
        end
    end

    -- pass 2: worker pool
    local N = math.max(1, CFG.DecompileWorkers)
    local nextJob, finished, workersDone = 1, 0, 0
    local totalJobs = #jobs

    local function worker()
        while true do
            pace()
            local i = nextJob
            if i > totalJobs then return end
            nextJob = i + 1
            local job = jobs[i]
            local ok, err = pcall(process, job)
            if ok then
                counts.scripts += 1
            else
                errors[#errors + 1] = ("script %s: %s"):format(job.p, tostring(err))
            end
            finished += 1
            if finished % 5 == 0 then
                sub(finished / totalJobs, ("scripts %d/%d (dup dilewati: %d)"):format(
                    finished, totalJobs, counts.dups))
            end
        end
    end

    for _ = 1, N do
        task.spawn(function()
            pcall(worker)
            workersDone += 1
        end)
    end
    while workersDone < N do task.wait(0.1) end

    local idx = newWriter("scripts/_index")
    for _, m in ipairs(meta) do
        local where = m.dupOf and ("dup -> " .. m.dupOf.fname) or m.fname
        idx.add(("%s | %s | %s | %s"):format(where, m.cls, m.p, m.hash or "?"))
    end
end)

